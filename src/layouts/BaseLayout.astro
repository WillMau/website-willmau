---
interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  ogType?: string;
  publishedTime?: string;
  canonicalURL?: string;
  pageLabel?: string;
}

const {
  title,
  description,
  image = '/ogmauops.jpg',
  imageAlt,
  imageWidth,
  imageHeight,
  ogType = 'website',
  publishedTime,
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  pageLabel
} = Astro.props;

const siteTitle = 'Website Design for Small Businesses | Schenectady & Albany NY';
const fullTitle = title === 'Home' ? siteTitle : `${title} | Mau Consulting`;
const ogImage = new URL(image, Astro.site).href;

const breadcrumbSchema = pageLabel ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mauops.com/" },
    { "@type": "ListItem", "position": 2, "name": pageLabel, "item": canonicalURL }
  ]
}) : null;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/mau-consulting-favicon-navy-coral-transparent-filled-512.png" />
    <link rel="apple-touch-icon" href="/mau-consulting-favicon-navy-coral-transparent-filled-512.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0f172a" />

    <!-- Google Analytics -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-VS8SPLJCKZ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-VS8SPLJCKZ');
    </script>

    <!-- Google Fonts: DM Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://formspree.io" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&display=swap" rel="stylesheet" />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />
    {imageAlt && <meta property="twitter:image:alt" content={imageAlt} />}

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "Mau Consulting",
        "url": "https://mauops.com",
        "telephone": "+1-518-348-6864",
        "logo": "https://mauops.com/mau-consulting-favicon-navy-coral-transparent-filled-512.png",
        "image": "https://mauops.com/william-mau-headshot.jpg",
        "description": "Website design for small businesses in the Capital Region, plus the operations support behind it: Salesforce, AI, automation, dashboards, and process redesign. Based in Schenectady, NY, serving Albany, Saratoga, Troy, and the surrounding area.",
        "founder": {
          "@type": "Person",
          "name": "William Mau",
          "jobTitle": "Founder & Principal Consultant",
          "sameAs": "https://www.linkedin.com/in/will-mau/"
        },
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Schenectady",
          "addressRegion": "NY",
          "postalCode": "12306",
          "addressCountry": "US"
        },
        "priceRange": "$$",
        "areaServed": [
          {
            "@type": "City",
            "name": "Schenectady",
            "containedInPlace": {
              "@type": "State",
              "name": "New York"
            }
          },
          {
            "@type": "City",
            "name": "Albany",
            "containedInPlace": {
              "@type": "State",
              "name": "New York"
            }
          },
          {
            "@type": "Country",
            "name": "United States"
          }
        ],
        "sameAs": [
          "https://www.linkedin.com/in/will-mau/",
          "https://github.com/WillMau"
        ],
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Consulting Services",
          "itemListElement": [
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Operations & Process",
                "description": "Diagnose bottlenecks, document the work, replace spreadsheets with systems. Process redesign, runbooks, and fractional operations leadership for small businesses.",
                "url": "https://mauops.com/operations"
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Salesforce & Revenue Systems",
                "description": "CRM setup, cleanup, lead routing, pipeline dashboards, and AI-powered Salesforce automation for small businesses.",
                "url": "https://mauops.com/salesforce-consulting"
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "AI & Automation",
                "description": "Production AI agents and cross-tool workflow automation: customer service automation, lead qualification, document processing, and custom integrations.",
                "url": "https://mauops.com/ai-solutions"
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Websites & Digital Presence",
                "description": "Fast, modern websites that capture leads, hooked into the tools small businesses actually use.",
                "url": "https://mauops.com/website-design"
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Advisory Sessions",
                "description": "On-demand consulting for technology strategy and operations decisions.",
                "url": "https://mauops.com/consulting"
              }
            }
          ]
        },
        "serviceType": [
          "Website Design",
          "Small Business Website Design",
          "Web Development",
          "Fractional Operations Leadership",
          "Operations Consulting",
          "Process Redesign",
          "Salesforce Consulting",
          "Revenue Operations",
          "AI Agent Development",
          "Workflow Automation"
        ]
      }
    </script>

    {breadcrumbSchema && <script type="application/ld+json" set:html={breadcrumbSchema} />}

    <!-- Dark Mode Script (runs before page load to prevent flash) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>
  </head>
  <body class="bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors">
    <slot />
  </body>
</html>
