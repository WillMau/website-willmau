---
interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title,
  description,
  image = '/william-mau-headshot.jpg',
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href
} = Astro.props;

const siteTitle = 'Salesforce Consulting & Website Design for Small Businesses | Schenectady, NY';
const fullTitle = title === 'Home' ? siteTitle : `${title} | Mau Consulting`;
const ogImage = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/mau-consulting-favicon-navy-coral-transparent-filled-512.png" />
    <link rel="apple-touch-icon" href="/mau-consulting-favicon-navy-coral-transparent-filled-512.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0f172a" />

    <!-- Google Fonts: DM Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://formspree.io" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&display=swap" rel="stylesheet" />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "Mau Consulting",
        "url": "https://mauops.com",
        "logo": "https://mauops.com/mau-consulting-favicon-navy-coral-transparent-filled-512.png",
        "image": "https://mauops.com/william-mau-headshot.jpg",
        "description": "Technology consulting for small businesses. Salesforce, workflow optimization, and website design services.",
        "founder": {
          "@type": "Person",
          "name": "William Mau",
          "jobTitle": "Founder & Principal Consultant",
          "sameAs": "https://www.linkedin.com/in/will-mau/"
        },
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Schenectady",
          "addressRegion": "NY",
          "postalCode": "12306",
          "addressCountry": "US"
        },
        "priceRange": "$$",
        "areaServed": [
          {
            "@type": "City",
            "name": "Schenectady",
            "containedInPlace": {
              "@type": "State",
              "name": "New York"
            }
          },
          {
            "@type": "City",
            "name": "Albany",
            "containedInPlace": {
              "@type": "State",
              "name": "New York"
            }
          },
          {
            "@type": "Country",
            "name": "United States"
          }
        ],
        "sameAs": [
          "https://www.linkedin.com/in/will-mau/",
          "https://github.com/WillMau"
        ],
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Consulting Services",
          "itemListElement": [
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Salesforce Consulting",
                "description": "CRM setup, admin, automation, and optimization for small businesses.",
                "url": "https://mauops.com/salesforce-consulting"
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Workflows & Integrations",
                "description": "Process mapping, workflow optimization, and system integration.",
                "url": "https://mauops.com/automation-consulting"
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Websites & Digital Presence",
                "description": "Fast, modern websites built for small businesses.",
                "url": "https://mauops.com/website-design"
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Advisory & Office Hours",
                "description": "On-demand consulting for technology strategy and operations.",
                "url": "https://mauops.com/consulting"
              }
            }
          ]
        },
        "serviceType": [
          "Salesforce Consulting",
          "Website Design",
          "Process Automation",
          "Technology Consulting"
        ]
      }
    </script>

    <!-- Dark Mode Script (runs before page load to prevent flash) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>
  </head>
  <body class="bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors">
    <slot />
  </body>
</html>
