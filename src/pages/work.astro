---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Badge from '../components/Badge.astro';
---

<BaseLayout
  title="Work & Case Studies"
  description="Portfolio of operations work, revenue systems projects, and production websites. Case studies demonstrating measurable outcomes in Salesforce optimization, workflow automation, and executive reporting."
>
  <Header />

  <main>
    <Hero
      title="Selected Work & Case Studies"
      subtitle="Examples of production sites, revenue operations projects, and operational transformations that delivered measurable results."
    />

    <!-- Public Websites -->
    <Section
      title="Public Websites"
      subtitle="Production sites I've designed, built, and shipped"
      class="bg-white dark:bg-gray-900"
    >
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl">
        <Card>
          <div class="mb-4">
            <div class="aspect-video bg-gray-200 dark:bg-gray-700 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-16 h-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
            </div>
            <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-2">
              Shoreline Senior Care
            </h3>
            <p class="text-gray-700 dark:text-gray-300 mb-4">
              Full website for senior care services in Schenectady, NY. Demonstrates ability to write for users, design clean interfaces, and ship production-ready sites with clear CTAs and service offerings.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <Badge variant="accent">Web Design</Badge>
              <Badge variant="accent">Content Writing</Badge>
              <Badge variant="accent">Production Site</Badge>
              <Badge variant="accent">User-Focused</Badge>
            </div>
            <a
              href="https://www.shorelinecares.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent-600 dark:text-accent-400 hover:text-accent-700 dark:hover:text-accent-300 font-medium inline-flex items-center gap-2"
            >
              Visit shorelinecares.com
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </Card>

        <Card>
          <div class="mb-4">
            <div class="aspect-video bg-gray-200 dark:bg-gray-700 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-16 h-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
            </div>
            <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-2">
              Rockford Milling & Woodworking
            </h3>
            <p class="text-gray-700 dark:text-gray-300 mb-4">
              Custom woodworking portfolio site showcasing craftsmanship with clean layout, clear service offerings, and strong visual presentation. Demonstrates ability to build and ship client-facing production sites.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <Badge variant="accent">Portfolio Site</Badge>
              <Badge variant="accent">Design</Badge>
              <Badge variant="accent">Production</Badge>
              <Badge variant="accent">Shipping</Badge>
            </div>
            <a
              href="https://www.rockfordmilling.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent-600 dark:text-accent-400 hover:text-accent-700 dark:hover:text-accent-300 font-medium inline-flex items-center gap-2"
            >
              Visit rockfordmilling.com
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </Card>
      </div>
    </Section>

    <!-- Case Studies -->
    <Section
      title="Case Studies"
      subtitle="Anonymized examples of revenue operations and systems work with measurable outcomes"
      class="bg-gray-50 dark:bg-gray-800"
    >
      <div class="space-y-12 max-w-5xl mx-auto">
        <!-- Case Study 1: CRM Workflow Reengineering -->
        <div class="bg-white dark:bg-gray-900 rounded-lg p-8 border border-gray-200 dark:border-gray-700">
          <div class="flex flex-wrap gap-2 mb-4">
            <Badge variant="accent">Salesforce</Badge>
            <Badge variant="accent">Pardot</Badge>
            <Badge variant="accent">Revenue Operations</Badge>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
            CRM & Marketing Automation Workflow Reengineering
          </h3>

          <div class="space-y-6">
            <div>
              <h4 class="font-semibold text-accent-600 dark:text-accent-400 mb-2">Problem</h4>
              <p class="text-gray-700 dark:text-gray-300">
                B2B company with complex sales cycle experiencing major funnel friction. Leads getting stuck between Marketing and Sales, unclear lifecycle definitions, unreliable forecasting, and executives lacking confidence in pipeline data. Sales velocity declining despite increasing lead volume.
              </p>
            </div>

            <div>
              <h4 class="font-semibold text-accent-600 dark:text-accent-400 mb-2">Constraints</h4>
              <ul class="space-y-1 text-gray-700 dark:text-gray-300">
                <li class="flex items-start gap-2">
                  <span>•</span>
                  <span>Had to maintain business continuity during changes—couldn't "stop the world"</span>
                </li>
                <li class="flex items-start gap-2">
                  <span>•</span>
                  <span>Limited Salesforce admin resources; needed sustainable solution</span>
                </li>
                <li class="flex items-start gap-2">
                  <span>•</span>
                  <span>Existing data quality issues complicating any workflow changes</span>
                </li>
              </ul>
            </div>

            <div>
              <h4 class="font-semibold text-accent-600 dark:text-accent-400 mb-2">Approach</h4>
              <ol class="space-y-2 text-gray-700 dark:text-gray-300">
                <li class="flex items-start gap-2">
                  <span class="font-semibold">1.</span>
                  <span><strong>Diagnostic:</strong> Mapped current-state workflows, identified 14 major bottlenecks across lead routing, stage definitions, and handoff protocols</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="font-semibold">2.</span>
                  <span><strong>Lifecycle redefinition:</strong> Collaborated cross-functionally to establish clear MQL/SQL criteria and stage entry/exit requirements</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="font-semibold">3.</span>
                  <span><strong>Automation rebuild:</strong> Cleaned up redundant workflows, fixed lead routing rules, automated data validation</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="font-semibold">4.</span>
                  <span><strong>Data hygiene sprint:</strong> Deduped records, enforced validation rules, backfilled missing fields</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="font-semibold">5.</span>
                  <span><strong>Dashboard deployment:</strong> Built executive dashboards for pipeline health and stage conversion tracking</span>
                </li>
              </ol>
            </div>

            <div>
              <h4 class="font-semibold text-accent-600 dark:text-accent-400 mb-2">Outcome</h4>
              <ul class="space-y-2 text-gray-700 dark:text-gray-300">
                <li class="flex items-start gap-2">
                  <span class="text-green-600 dark:text-green-400">✓</span>
                  <span><strong>Eliminated 87% of identified funnel bottlenecks</strong>, improving lead-to-close flow</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-green-600 dark:text-green-400">✓</span>
                  <span>Sales velocity increased measurably; time-to-close improved</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-green-600 dark:text-green-400">✓</span>
                  <span>Forecasting accuracy improved, giving executives confidence in pipeline data</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-green-600 dark:text-green-400">✓</span>
                  <span>Clear documentation and governance model for ongoing maintenance</span>
                </li>
              </ul>
            </div>

            <div>
              <h4 class="font-semibold text-accent-600 dark:text-accent-400 mb-2">Tools</h4>
              <div class="flex flex-wrap gap-2">
                <Badge>Salesforce Sales Cloud</Badge>
                <Badge>Pardot</Badge>
                <Badge>Process Builder</Badge>
                <Badge>Validation Rules</Badge>
                <Badge>Dashboards</Badge>
              </div>
            </div>
          </div>
        </div>

        <!-- Case Study 2: Executive Dashboards -->
        <div class="bg-white dark:bg-gray-900 rounded-lg p-8 border border-gray-200 dark:border-gray-700">
          <div class="flex flex-wrap gap-2 mb-4">
            <Badge variant="accent">Salesforce</Badge>
            <Badge variant="accent">Business Intelligence</Badge>
            <Badge variant="accent">Executive Reporting</Badge>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
            Executive Dashboard & Reporting System
          </h3>

          <div class="space-y-6">
            <div>
              <h4 class="font-semibold text-accent-600 dark:text-accent-400 mb-2">Problem</h4>
              <p class="text-gray-700 dark:text-gray-300">
                Sales leadership lacked visibility into pipeline health, win rates, and rep performance. Weekly reporting was manual, time-consuming, and inconsistent. Executives couldn't confidently make territory planning or quota decisions due to unreliable data.
              </p>
            </div>

            <div>
              <h4 class="font-semibold text-accent-600 dark:text-accent-400 mb-2">Constraints</h4>
              <ul class="space-y-1 text-gray-700 dark:text-gray-300">
                <li class="flex items-start gap-2">
                  <span>•</span>
                  <span>Had to use native Salesforce reporting (no Einstein Analytics budget)</span>
                </li>
                <li class="flex items-start gap-2">
                  <span>•</span>
                  <span>Data quality varied; some fields incomplete or inaccurate</span>
                </li>
                <li class="flex items-start gap-2">
                  <span>•</span>
                  <span>Needed real-time or near-real-time updates (not static monthly reports)</span>
                </li>
              </ul>
            </div>

            <div>
              <h4 class="font-semibold text-accent-600 dark:text-accent-400 mb-2">Approach</h4>
              <ol class="space-y-2 text-gray-700 dark:text-gray-300">
                <li class="flex items-start gap-2">
                  <span class="font-semibold">1.</span>
                  <span><strong>Stakeholder interviews:</strong> Identified key metrics executives needed for decision-making</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="font-semibold">2.</span>
                  <span><strong>Data validation:</strong> Fixed underlying data quality issues before building dashboards</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="font-semibold">3.</span>
                  <span><strong>Dashboard design:</strong> Built 5 executive dashboards covering pipeline health, conversion rates, rep performance, win/loss analysis, and forecast accuracy</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="font-semibold">4.</span>
                  <span><strong>Automation:</strong> Added scheduled email delivery and mobile access</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="font-semibold">5.</span>
                  <span><strong>Training:</strong> Conducted executive walkthrough sessions and created usage documentation</span>
                </li>
              </ol>
            </div>

            <div>
              <h4 class="font-semibold text-accent-600 dark:text-accent-400 mb-2">Outcome</h4>
              <ul class="space-y-2 text-gray-700 dark:text-gray-300">
                <li class="flex items-start gap-2">
                  <span class="text-green-600 dark:text-green-400">✓</span>
                  <span>Executive leadership gained real-time visibility into pipeline health and performance</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-green-600 dark:text-green-400">✓</span>
                  <span>Weekly reporting workload eliminated (automated dashboards replaced manual reports)</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-green-600 dark:text-green-400">✓</span>
                  <span>Leadership used insights to guide territory planning, quota setting, and strategic investments</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-green-600 dark:text-green-400">✓</span>
                  <span>Dashboard adoption: used in every weekly executive meeting</span>
                </li>
              </ul>
            </div>

            <div>
              <h4 class="font-semibold text-accent-600 dark:text-accent-400 mb-2">Tools</h4>
              <div class="flex flex-wrap gap-2">
                <Badge>Salesforce Dashboards</Badge>
                <Badge>Custom Reports</Badge>
                <Badge>Formula Fields</Badge>
                <Badge>Report Scheduling</Badge>
              </div>
            </div>
          </div>
        </div>

        <!-- Case Study 3: Operations Support Model -->
        <div class="bg-white dark:bg-gray-900 rounded-lg p-8 border border-gray-200 dark:border-gray-700">
          <div class="flex flex-wrap gap-2 mb-4">
            <Badge variant="accent">Process Design</Badge>
            <Badge variant="accent">Operations</Badge>
            <Badge variant="accent">Scalability</Badge>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
            Tiered Support Model & Process Redesign
          </h3>

          <div class="space-y-6">
            <div>
              <h4 class="font-semibold text-accent-600 dark:text-accent-400 mb-2">Problem</h4>
              <p class="text-gray-700 dark:text-gray-300">
                Client Success team overwhelmed with escalations and routine requests mixed together. No clear triage process, resulting in high-priority issues getting delayed and team burnout. Leadership had no visibility into support volume or resolution times.
              </p>
            </div>

            <div>
              <h4 class="font-semibold text-accent-600 dark:text-accent-400 mb-2">Constraints</h4>
              <ul class="space-y-1 text-gray-700 dark:text-gray-300">
                <li class="flex items-start gap-2">
                  <span>•</span>
                  <span>Could not add headcount; had to improve with existing resources</span>
                </li>
                <li class="flex items-start gap-2">
                  <span>•</span>
                  <span>Team resistant to process changes (previous attempts failed)</span>
                </li>
                <li class="flex items-start gap-2">
                  <span>•</span>
                  <span>No formal support ticketing system in place</span>
                </li>
              </ul>
            </div>

            <div>
              <h4 class="font-semibold text-accent-600 dark:text-accent-400 mb-2">Approach</h4>
              <ol class="space-y-2 text-gray-700 dark:text-gray-300">
                <li class="flex items-start gap-2">
                  <span class="font-semibold">1.</span>
                  <span><strong>Current-state analysis:</strong> Mapped support workflows and categorized requests by complexity and urgency</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="font-semibold">2.</span>
                  <span><strong>Tiered model design:</strong> Created Tier 1 (routine), Tier 2 (technical), Tier 3 (escalation) with clear escalation criteria</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="font-semibold">3.</span>
                  <span><strong>Knowledge base:</strong> Built internal documentation for common resolutions (reducing repeat questions)</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="font-semibold">4.</span>
                  <span><strong>Lightweight ticketing:</strong> Used Salesforce Cases to track volume, categorize requests, and measure resolution time</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="font-semibold">5.</span>
                  <span><strong>Team training:</strong> Conducted workshops and created SOPs for each tier</span>
                </li>
              </ol>
            </div>

            <div>
              <h4 class="font-semibold text-accent-600 dark:text-accent-400 mb-2">Outcome</h4>
              <ul class="space-y-2 text-gray-700 dark:text-gray-300">
                <li class="flex items-start gap-2">
                  <span class="text-green-600 dark:text-green-400">✓</span>
                  <span>Support volume triaged effectively; high-priority issues resolved faster</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-green-600 dark:text-green-400">✓</span>
                  <span>Team workload balanced; burnout reduced</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-green-600 dark:text-green-400">✓</span>
                  <span>Leadership gained visibility into support metrics (volume, SLA adherence, resolution times)</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-green-600 dark:text-green-400">✓</span>
                  <span>Knowledge base reduced repeat escalations by ~30%</span>
                </li>
              </ul>
            </div>

            <div>
              <h4 class="font-semibold text-accent-600 dark:text-accent-400 mb-2">Tools</h4>
              <div class="flex flex-wrap gap-2">
                <Badge>Salesforce Cases</Badge>
                <Badge>SharePoint Knowledge Base</Badge>
                <Badge>Process Documentation</Badge>
                <Badge>SOP Templates</Badge>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Section>
  </main>

  <Footer />
</BaseLayout>
