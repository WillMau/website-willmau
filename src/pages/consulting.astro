---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';

const formats = [
  {
    title: 'One-Off Strategy Call',
    duration: '60 minutes',
    price: 'From $250',
    description: 'A focused session on one specific challenge. You bring the question, I bring the experience.',
    examples: [
      'Should we switch CRMs or optimize what we have?',
      'Our lead handoff process is broken. What would you do?',
      'We need to pick a project management tool. What fits?',
      'How should we structure our Salesforce instance?'
    ],
    icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z'
  },
  {
    title: 'Monthly Office Hours',
    duration: '2 hours per month',
    price: 'From $400/mo',
    description: 'Ongoing access for teams that want a trusted advisor on call. Use your hours however you need them.',
    examples: [
      'Monthly check-in on process improvements',
      'Quick reviews of workflow changes before rollout',
      'Troubleshooting when something breaks',
      'Gut-check on vendor pitches and tool recommendations'
    ],
    icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z'
  },
  {
    title: 'Half-Day Deep Dive',
    duration: '4 hours',
    price: 'From $800',
    description: 'A working session for bigger questions. We dig into the problem together and leave with a clear direction.',
    examples: [
      'Map out a broken process and sketch the fix',
      'Audit your current tech stack and recommend changes',
      'Plan a Salesforce rollout or migration strategy',
      'Design a reporting framework for leadership'
    ],
    icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z'
  }
];

const whoItsFor = [
  {
    title: 'You have a specific question',
    description: 'Not a full project. Just a decision you need help thinking through, or a process that needs a second pair of eyes.',
    icon: 'M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
  },
  {
    title: 'You want ongoing access',
    description: 'Your team runs into operational and systems questions regularly. Having an advisor on call saves time and prevents bad decisions.',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z'
  },
  {
    title: 'You are not ready for a full engagement',
    description: 'Maybe you need clarity before committing to a bigger project. A strategy call helps you understand the scope before you invest.',
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4'
  },
  {
    title: 'You got a vendor pitch and want a gut-check',
    description: 'Before you sign a contract or buy a new tool, get an honest, unbiased opinion from someone who is not selling you anything.',
    icon: 'M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3'
  }
];

const faqs = [
  {
    question: 'What happens on a strategy call?',
    answer: 'You tell me what is going on, I ask questions, and we work through it together. You will leave with a clear recommendation, not a sales pitch for a bigger engagement. If I think you need more help, I will say so honestly.'
  },
  {
    question: 'Can I use office hours for hands-on work?',
    answer: 'Office hours are best for advice, reviews, and planning. If you need someone to build or configure something, that is a better fit for one of my service pages (Salesforce, Workflows, or Websites). That said, small tasks and quick fixes are fair game during office hours.'
  },
  {
    question: 'What if my question turns into a bigger project?',
    answer: 'That happens sometimes. If your question reveals a bigger need, I will scope it out and give you a separate quote. Your advisory time stays your advisory time.'
  },
  {
    question: 'Do I need to prepare anything before a call?',
    answer: 'Just a clear idea of what you want to discuss. I will send a short intake form after you book so I can come prepared. The more context you give me upfront, the more ground we cover.'
  },
  {
    question: 'What topics can I ask about?',
    answer: 'Anything in my wheelhouse: Salesforce, CRM strategy, process design, workflow optimization, tech stack decisions, tool selection, team enablement, documentation strategy, and operational efficiency. If it is outside my expertise, I will tell you upfront.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
});
---

<BaseLayout
  title="Operations Advisory & Office Hours | Schenectady, NY"
  description="Book a strategy call or monthly office hours with a fractional operations executive in Schenectady, NY. Practical advice on operations, Salesforce, AI, automation, and tech stack decisions for small businesses in the Capital Region."
  pageLabel="Advisory & Office Hours"
>
  <Header />
  <script type="application/ld+json" set:html={faqSchema} />

  <main>
  <!-- Hero -->
  <section class="relative overflow-hidden py-16 sm:py-24 bg-white dark:bg-gray-950">
    <div class="absolute inset-0 bg-gradient-to-br from-accent-50/40 via-transparent to-navy-50/30 dark:from-accent-900/10 dark:via-transparent dark:to-navy-950/20" aria-hidden="true"></div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <Badge variant="accent" class="mb-4">
          <svg class="w-4 h-4 inline-block mr-1" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
          </svg>
          Advisory & Office Hours
        </Badge>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-navy-900 dark:text-white mb-6 animate-fade-in-up">
          Not Every Question<br />Needs a Full Project
        </h1>

        <p class="text-xl sm:text-2xl text-stone-600 dark:text-stone-300 mb-8 animate-delay-100">
          Sometimes you just need someone who has been in the trenches to look at your problem, give you a straight answer, and help you move forward. That is what this is for.
        </p>

        <div class="flex flex-wrap gap-4 justify-center animate-delay-200">
          <Button href="/contact/?service=advisory&source=consulting" variant="primary" size="lg">
            Book a Strategy Call
          </Button>
          <Button href="#formats" variant="outline" size="lg">
            See the Options
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Who It's For -->
  <Section title="Who This Is For" subtitle="Advisory sessions are designed for specific situations">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {whoItsFor.map(item => (
        <Card shimmer={true}>
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-accent-500 to-accent-600 rounded-xl flex items-center justify-center text-white shadow-lg">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-navy-900 dark:text-white mb-2">{item.title}</h3>
              <p class="text-sm text-stone-600 dark:text-stone-400">{item.description}</p>
            </div>
          </div>
        </Card>
      ))}
    </div>
  </Section>

  <!-- Photo Break -->
  <section class="relative h-48 sm:h-64 overflow-hidden">
    <img
      src="/photo-break-advisory.jpg"
      alt="Two people having a consulting conversation over coffee"
      class="w-full h-full object-cover grayscale"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-white/20 via-transparent to-white/20 dark:from-gray-950/30 dark:to-gray-950/30"></div>
  </section>

  <!-- Formats -->
  <Section id="formats" class="bg-stone-50 dark:bg-gray-900" title="How It Works" subtitle="Pick the format that fits your situation">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
      {formats.map(format => (
        <Card class="h-full flex flex-col">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex-shrink-0 w-10 h-10 bg-navy-100 dark:bg-navy-900/40 text-navy-700 dark:text-navy-300 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={format.icon} />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-navy-900 dark:text-white">{format.title}</h3>
              <p class="text-xs text-stone-500 dark:text-stone-400">{format.duration}</p>
            </div>
          </div>

          <div class="text-2xl font-bold text-accent-600 dark:text-accent-400 mb-3">{format.price}</div>
          <p class="text-sm text-stone-600 dark:text-stone-300 mb-5">{format.description}</p>

          <p class="text-xs font-semibold text-navy-900 dark:text-white uppercase tracking-wide mb-3">Example questions</p>
          <ul class="space-y-2 mb-6">
            {format.examples.map(ex => (
              <li class="flex items-start gap-2 text-sm">
                <svg class="w-4 h-4 text-accent-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <span class="text-stone-600 dark:text-stone-400">{ex}</span>
              </li>
            ))}
          </ul>

          <div class="mt-auto pt-6">
            <Button href={`/contact/?service=advisory&tier=${encodeURIComponent(format.title + ' (' + format.price + ')')}&source=consulting`} variant="primary" class="w-full">Book Now</Button>
          </div>
        </Card>
      ))}
    </div>
  </Section>

  <!-- What to Expect -->
  <Section title="What to Expect">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      {[
        { step: '01', title: 'Book', desc: 'Pick a format and submit a short intake form so I know what you are dealing with' },
        { step: '02', title: 'Prep', desc: 'I review your situation beforehand so we hit the ground running, not catching up' },
        { step: '03', title: 'Meet', desc: 'We work through your question together. I give you honest, practical guidance' },
        { step: '04', title: 'Follow Up', desc: 'You get a written summary with my recommendations and any next steps' }
      ].map(phase => (
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-navy-800 to-navy-900 text-white rounded-2xl font-bold text-2xl mb-4 shadow-lg">
            {phase.step}
          </div>
          <h3 class="text-lg font-semibold text-navy-900 dark:text-white mb-2">{phase.title}</h3>
          <p class="text-sm text-stone-600 dark:text-stone-400">{phase.desc}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Callout -->
  <Section class="bg-accent-50/50 dark:bg-accent-950/20">
    <div class="max-w-3xl mx-auto text-center">
      <div class="inline-flex items-center justify-center w-14 h-14 bg-accent-100 dark:bg-accent-900/30 text-accent-600 dark:text-accent-400 rounded-2xl mb-4">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h3 class="text-xl font-semibold text-navy-900 dark:text-white mb-3">Need more than advice?</h3>
      <p class="text-stone-600 dark:text-stone-300 mb-6">
        If your question turns into a project, I offer full-service engagements for Salesforce, workflow design, and website builds. Advisory clients get priority scheduling.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <Button href="/salesforce-consulting" variant="outline" size="sm">Salesforce & CRM</Button>
        <Button href="/automation-consulting" variant="outline" size="sm">Workflows & Integrations</Button>
        <Button href="/website-design" variant="outline" size="sm">Websites & Digital Presence</Button>
      </div>
    </div>
  </Section>

  <!-- FAQ -->
  <Section class="bg-stone-50 dark:bg-gray-900" title="Frequently Asked Questions">
    <div class="max-w-3xl mx-auto space-y-4">
      {faqs.map((faq, index) => (
        <div class="border border-stone-200 dark:border-stone-800 rounded-xl overflow-hidden">
          <button
            class="w-full flex items-center justify-between p-5 text-left bg-white dark:bg-stone-900/60 hover:bg-stone-50 dark:hover:bg-stone-800/60 transition-colors"
            data-faq-toggle
            aria-expanded="false"
          >
            <span class="text-lg font-semibold text-navy-900 dark:text-white pr-4">{faq.question}</span>
            <svg class="w-5 h-5 text-stone-400 flex-shrink-0 transition-transform" data-faq-icon fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="hidden px-5 pb-5 bg-white dark:bg-stone-900/60" data-faq-panel>
            <p class="text-stone-600 dark:text-stone-400">{faq.answer}</p>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- CTA -->
  <section class="relative overflow-hidden bg-navy-900 dark:bg-navy-950 py-16 sm:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">Got a Question? Let's Talk It Through.</h2>
        <p class="text-xl text-navy-200 mb-8">
          No commitment, no pitch. Just a conversation about what you are dealing with and whether I can help.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <Button href="/contact/?service=advisory&source=consulting" variant="primary" size="lg">Book a Strategy Call</Button>
          <Button href="/work/" variant="outline" size="lg" class="text-white border-white hover:bg-white/10">See My Work</Button>
        </div>
      </div>
    </div>
  </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  // FAQ accordion
  const faqToggles = document.querySelectorAll('[data-faq-toggle]');

  faqToggles.forEach(toggle => {
    toggle.addEventListener('click', () => {
      const panel = toggle.nextElementSibling as HTMLElement;
      const icon = toggle.querySelector('[data-faq-icon]') as HTMLElement;
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';

      // Close all others
      faqToggles.forEach(other => {
        if (other !== toggle) {
          other.setAttribute('aria-expanded', 'false');
          const otherPanel = other.nextElementSibling as HTMLElement;
          const otherIcon = other.querySelector('[data-faq-icon]') as HTMLElement;
          otherPanel?.classList.add('hidden');
          otherIcon?.classList.remove('rotate-180');
        }
      });

      // Toggle this one
      toggle.setAttribute('aria-expanded', String(!isOpen));
      panel?.classList.toggle('hidden');
      icon?.classList.toggle('rotate-180');
    });
  });
</script>
