---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import NetworkBackground from '../components/NetworkBackground.astro';
import Badge from '../components/Badge.astro';
---

<BaseLayout
  title="AI Integration | ChatGPT API & AI Automation for Business"
  description="AI integration consulting for small businesses. ChatGPT API, custom GPTs, AI workflow automation. Practical AI solutions that save time and money."
>
  <Header />

  <main>
  <section class="relative overflow-hidden py-16 sm:py-24 bg-gradient-to-br from-indigo-50 via-purple-50 to-violet-50 dark:from-gray-900 dark:via-indigo-950 dark:to-violet-950">
    <NetworkBackground density="normal" opacity={0.5} />

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <Badge variant="accent" class="mb-4">
          <svg class="w-4 h-4 inline-block mr-1" fill="currentColor" viewBox="0 0 20 20">
            <path d="M13 7H7v6h6V7z" />
            <path fill-rule="evenodd" d="M7 2a1 1 0 012 0v1h2V2a1 1 0 112 0v1h2a2 2 0 012 2v2h1a1 1 0 110 2h-1v2h1a1 1 0 110 2h-1v2a2 2 0 01-2 2h-2v1a1 1 0 11-2 0v-1H9v1a1 1 0 11-2 0v-1H5a2 2 0 01-2-2v-2H2a1 1 0 110-2h1V9H2a1 1 0 010-2h1V5a2 2 0 012-2h2V2zM5 5h10v10H5V5z" clip-rule="evenodd" />
          </svg>
          AI Integration Specialist
        </Badge>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-gray-900 dark:text-white mb-6 animate-fade-in-up">
          AI That Actually Helps<br />Your Business
        </h1>

        <p class="text-xl sm:text-2xl text-gray-600 dark:text-gray-300 mb-8 animate-delay-100">
          ChatGPT API integration, custom GPTs, and AI-powered workflows. Real automation, not just hype.
        </p>

        <div class="flex flex-wrap gap-4 justify-center animate-delay-200">
          <Button href="/contact?service=ai-integration" variant="primary" size="lg">
            Explore AI Solutions
          </Button>
          <Button href="#use-cases" variant="outline" size="lg">
            See Use Cases
          </Button>
        </div>
      </div>
    </div>
  </section>

  <Section id="use-cases" title="What AI Can Do for Your Business" subtitle="Practical applications I've built for clients">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {[
        { title: 'Customer Support Automation', desc: 'AI chatbot that answers FAQs, qualifies leads, and routes to humans when needed', icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z' },
        { title: 'Content Generation', desc: 'Auto-generate blog posts, social media captions, email campaigns from prompts', icon: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z' },
        { title: 'Email Intelligence', desc: 'AI reads incoming emails, extracts key info, updates CRM, drafts responses', icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
        { title: 'Document Analysis', desc: 'Extract data from PDFs, invoices, contracts - no manual data entry', icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
        { title: 'Custom AI Assistants', desc: 'Build your own GPT trained on your docs, policies, and knowledge base', icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z' },
        { title: 'Meeting Summaries', desc: 'AI listens to Zoom calls, generates notes, action items, and follow-ups', icon: 'M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z' }
      ].map(item => (
        <Card shimmer={true}>
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-indigo-500 to-purple-500 rounded-xl flex items-center justify-center text-white shadow-lg">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">{item.title}</h3>
              <p class="text-sm text-gray-600 dark:text-gray-400">{item.desc}</p>
            </div>
          </div>
        </Card>
      ))}
    </div>
  </Section>

  <Section class="bg-gray-50 dark:bg-gray-800" title="How It Works">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      {[
        { step: '01', title: 'Identify Opportunity', desc: 'Find repetitive tasks where AI can help (email, data entry, support)' },
        { step: '02', title: 'Proof of Concept', desc: 'Build a simple working prototype to validate the approach' },
        { step: '03', title: 'Integration', desc: 'Connect AI to your existing tools (CRM, email, Slack)' },
        { step: '04', title: 'Train & Monitor', desc: 'Teach your team how to use it, then optimize based on results' }
      ].map(phase => (
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-indigo-500 to-purple-500 text-white rounded-2xl font-bold text-2xl mb-4 shadow-lg">
            {phase.step}
          </div>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">{phase.title}</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400">{phase.desc}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section title="Pricing">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {[
        { name: 'AI Consultation', price: 'Free', duration: '30 minutes', features: ['Discuss your use case', 'Assess AI feasibility', 'Rough cost estimate', 'No obligation'] },
        { name: 'Proof of Concept', price: '$1,500', duration: '1 week', features: ['Simple working prototype', 'ChatGPT API integration', 'Basic workflow automation', 'Recommendations report'] },
        { name: 'Full Integration', price: '$5,000+', duration: '2-4 weeks', features: ['Production-ready AI system', 'Multiple integrations', 'Custom training', 'Ongoing optimization', 'Team training'] }
      ].map(pkg => (
        <Card class="h-full flex flex-col">
          <div class="flex-1">
            <h3 class="text-2xl font-bold mb-2">{pkg.name}</h3>
            <div class="text-3xl font-bold text-indigo-600 dark:text-indigo-400 mb-2">{pkg.price}</div>
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">{pkg.duration}</p>
            <ul class="space-y-2">
              {pkg.features.map(f => (
                <li class="flex items-start gap-2 text-sm">
                  <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  <span class="text-gray-600 dark:text-gray-400">{f}</span>
                </li>
              ))}
            </ul>
          </div>
          <Button href="/contact?service=ai-integration" variant="primary" class="w-full mt-6">Get Started</Button>
        </Card>
      ))}
    </div>
  </Section>

  <Section class="relative overflow-hidden bg-gradient-to-br from-indigo-50/50 via-purple-50/50 to-violet-50/50 dark:from-gray-900/50 dark:via-indigo-950/50 dark:to-violet-950/50">
    <NetworkBackground density="sparse" opacity={0.4} />
    <div class="relative z-10 text-center max-w-3xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold mb-6">Ready to Explore AI for Your Business?</h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 mb-8">
        Start with a free consultation - no technical knowledge required.
      </p>
      <Button href="/contact?service=ai-integration" variant="primary" size="lg">Book Free AI Consultation</Button>
    </div>
  </Section>
  </main>

  <Footer />
</BaseLayout>
