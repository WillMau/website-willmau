---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with William Mau. Discuss full-time roles, consulting engagements, or revenue operations projects."
>
  <Header />

  <main>
    <Section class="bg-gradient-to-b from-gray-50 to-white dark:from-gray-800 dark:to-gray-900 py-16 sm:py-24">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white mb-4">
            Let's Talk About What's Stuck—And Fix It
          </h1>
          <p class="text-xl text-gray-600 dark:text-gray-300">
            Whether you're hiring for a full-time role or need consulting help with revenue systems, I'm here to help.
          </p>

          <!-- Service Interest Badge (populated by JavaScript) -->
          <div id="service-badge" class="hidden mt-6">
            <div class="inline-flex items-center px-4 py-2 bg-accent-100 dark:bg-accent-900/30 text-accent-700 dark:text-accent-300 rounded-full text-sm font-medium">
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              Interested in: <span id="service-name" class="ml-1 font-semibold"></span>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <Card class="mb-8">
          <form id="contact-form" class="space-y-6">
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                Name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white"
                placeholder="Your name"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                Email <span class="text-red-500">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white"
                placeholder="you@company.com"
              />
            </div>

            <div>
              <label for="company" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                Company
              </label>
              <input
                type="text"
                id="company"
                name="company"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white"
                placeholder="Your company (optional)"
              />
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                What are you trying to improve? <span class="text-red-500">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="6"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white"
                placeholder="Describe what's stuck, what you're trying to fix, or the role you're hiring for..."
              ></textarea>
            </div>

            <div>
              <label for="timeline" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                Timeline
              </label>
              <select
                id="timeline"
                name="timeline"
                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-white"
              >
                <option value="">Select a timeline</option>
                <option value="urgent">Urgent (within 1 week)</option>
                <option value="soon">Soon (1-4 weeks)</option>
                <option value="planning">Planning (1-3 months)</option>
                <option value="exploring">Exploring options</option>
              </select>
            </div>

            <!-- Hidden field for service tracking -->
            <input type="hidden" id="service" name="service" value="" />

            <div class="flex flex-col sm:flex-row gap-4">
              <button
                type="submit"
                class="flex-1 bg-accent-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-accent-700 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:ring-offset-2 transition-colors"
              >
                Send Message
              </button>
              <button
                type="button"
                id="copy-email"
                class="px-6 py-3 border-2 border-accent-600 text-accent-600 dark:text-accent-400 dark:border-accent-400 rounded-lg font-medium hover:bg-accent-50 dark:hover:bg-accent-900/20 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:ring-offset-2 transition-colors inline-flex items-center justify-center gap-2"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                Copy Email
              </button>
            </div>
          </form>

          <!-- Toast notification -->
          <div
            id="toast"
            class="hidden fixed bottom-4 right-4 bg-green-600 text-white px-6 py-3 rounded-lg shadow-lg"
          >
            Email copied to clipboard!
          </div>
        </Card>

        <!-- Direct Contact Info -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="text-center p-6 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
            <div class="text-accent-600 dark:text-accent-400 mb-3 flex justify-center">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Email</h3>
            <a href="mailto:William.Mau@gmail.com" class="text-accent-600 dark:text-accent-400 hover:underline">
              William.Mau@gmail.com
            </a>
          </div>

          <div class="text-center p-6 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
            <div class="text-accent-600 dark:text-accent-400 mb-3 flex justify-center">
              <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 dark:text-white mb-1">LinkedIn</h3>
            <a href="https://www.linkedin.com/in/will-mau/" target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-400 hover:underline">
              /in/will-mau
            </a>
          </div>

          <div class="text-center p-6 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
            <div class="text-accent-600 dark:text-accent-400 mb-3 flex justify-center">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Phone</h3>
            <a href="tel:518-930-8185" class="text-accent-600 dark:text-accent-400 hover:underline">
              518-930-8185
            </a>
          </div>
        </div>
      </div>
    </Section>
  </main>

  <Footer />

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const copyEmailBtn = document.getElementById('copy-email');
    const toast = document.getElementById('toast');
    const serviceBadge = document.getElementById('service-badge');
    const serviceName = document.getElementById('service-name');
    const serviceInput = document.getElementById('service') as HTMLInputElement;

    // Service name mapping
    const serviceNames: Record<string, string> = {
      'salesforce': 'Salesforce Consulting',
      'website-design': 'Website Design',
      'automation': 'Process Automation',
      'tech-consulting': 'Technology Consulting',
      'ai-integration': 'AI Integration'
    };

    // Read service from URL query parameter
    const urlParams = new URLSearchParams(window.location.search);
    const serviceParam = urlParams.get('service');

    if (serviceParam && serviceNames[serviceParam]) {
      // Show badge with service name
      if (serviceBadge && serviceName) {
        serviceName.textContent = serviceNames[serviceParam];
        serviceBadge.classList.remove('hidden');
      }

      // Set hidden field value
      if (serviceInput) {
        serviceInput.value = serviceParam;
      }
    }

    // Handle form submission (mailto)
    form?.addEventListener('submit', (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const name = formData.get('name');
      const email = formData.get('email');
      const company = formData.get('company');
      const message = formData.get('message');
      const timeline = formData.get('timeline');
      const service = formData.get('service');

      let body = `Name: ${name}\n`;
      body += `Email: ${email}\n`;
      if (company) body += `Company: ${company}\n`;
      if (service && serviceNames[service as string]) {
        body += `Interested In: ${serviceNames[service as string]}\n`;
      }
      if (timeline) body += `Timeline: ${timeline}\n`;
      body += `\nMessage:\n${message}`;

      // Include service in subject if available
      const serviceText = service && serviceNames[service as string] ? ` - ${serviceNames[service as string]}` : '';
      const subject = `Website Contact from ${name}${serviceText}`;
      const mailtoLink = `mailto:William.Mau@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

      window.location.href = mailtoLink;
    });

    // Handle copy email button
    copyEmailBtn?.addEventListener('click', async () => {
      const email = 'William.Mau@gmail.com';

      try {
        await navigator.clipboard.writeText(email);
        toast?.classList.remove('hidden');
        setTimeout(() => {
          toast?.classList.add('hidden');
        }, 3000);
      } catch (err) {
        console.error('Failed to copy email:', err);
      }
    });
  </script>
</BaseLayout>
