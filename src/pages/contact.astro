---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
---

<BaseLayout
  title="Get in Touch | Free Consultation"
  description="Contact Mau Consulting for a free consultation. Fractional operations leadership, Salesforce, AI &amp; automation, and websites for small businesses in Schenectady, Albany, and the Capital Region."
  pageLabel="Contact"
>
  <Header />

  <main>
    <Section class="bg-gradient-to-b from-stone-50 to-white dark:from-gray-900 dark:to-gray-950 py-16 sm:py-24">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <h1 class="text-4xl sm:text-5xl font-bold text-navy-900 dark:text-white mb-4">
            Let's Talk About What's Stuck and Fix It
          </h1>
          <p class="text-xl text-stone-600 dark:text-stone-300">
            Tell me what you are dealing with and I will give you honest advice on what to do next. No pitch.
          </p>

          <!-- Service Interest Badge (populated by JavaScript) -->
          <div id="service-badge" class="hidden mt-6">
            <div class="inline-flex items-center px-4 py-2 bg-accent-100 dark:bg-accent-900/30 text-accent-700 dark:text-accent-300 rounded-full text-sm font-medium">
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              Interested in: <span id="service-name" class="ml-1 font-semibold"></span>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <Card class="mb-8">
          <form
            id="contact-form"
            action="https://formspree.io/f/xkovklqa"
            method="POST"
            class="space-y-6"
          >
            <!-- Honeypot field for spam prevention -->
            <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

            <div>
              <label for="name" class="block text-sm font-medium text-stone-700 dark:text-stone-300 mb-2">
                Name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-2 border border-stone-300 dark:border-stone-700 rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500 bg-white dark:bg-stone-800 text-gray-900 dark:text-white"
                placeholder="Your name"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-stone-700 dark:text-stone-300 mb-2">
                Email <span class="text-red-500">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-2 border border-stone-300 dark:border-stone-700 rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500 bg-white dark:bg-stone-800 text-gray-900 dark:text-white"
                placeholder="you@company.com"
              />
            </div>

            <div>
              <label for="company" class="block text-sm font-medium text-stone-700 dark:text-stone-300 mb-2">
                Company
              </label>
              <input
                type="text"
                id="company"
                name="company"
                class="w-full px-4 py-2 border border-stone-300 dark:border-stone-700 rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500 bg-white dark:bg-stone-800 text-gray-900 dark:text-white"
                placeholder="Your company (optional)"
              />
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-stone-700 dark:text-stone-300 mb-2">
                What are you trying to improve? <span class="text-red-500">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="6"
                class="w-full px-4 py-2 border border-stone-300 dark:border-stone-700 rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500 bg-white dark:bg-stone-800 text-gray-900 dark:text-white"
                placeholder="Describe what's stuck, what you're trying to fix, or what you need help with..."
              ></textarea>
            </div>

            <div>
              <label for="timeline" class="block text-sm font-medium text-stone-700 dark:text-stone-300 mb-2">
                Timeline
              </label>
              <select
                id="timeline"
                name="timeline"
                class="w-full px-4 py-2 border border-stone-300 dark:border-stone-700 rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500 bg-white dark:bg-stone-800 text-gray-900 dark:text-white"
              >
                <option value="">Select a timeline</option>
                <option value="urgent">Urgent (within 1 week)</option>
                <option value="soon">Soon (1-4 weeks)</option>
                <option value="planning">Planning (1-3 months)</option>
                <option value="exploring">Exploring options</option>
              </select>
            </div>

            <!-- Hidden tracking fields (populated by JavaScript from URL params) -->
            <input type="hidden" id="service" name="service" value="" />
            <input type="hidden" id="tier" name="tier" value="" />
            <input type="hidden" id="source-page" name="source_page" value="" />

            <!-- Formspree subject line -->
            <input type="hidden" name="_subject" id="form-subject" value="New contact from mauconsulting.com" />

            <button
              type="submit"
              id="submit-btn"
              class="w-full bg-accent-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-accent-700 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:ring-offset-2 transition-colors"
            >
              Send Message
            </button>
          </form>

          <!-- Success message (hidden by default) -->
          <div id="success-message" class="hidden text-center py-8">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 rounded-full mb-4">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-navy-900 dark:text-white mb-2">Message sent.</h3>
            <p class="text-stone-600 dark:text-stone-400">I will get back to you within one business day.</p>
          </div>

          <!-- Error message (hidden by default) -->
          <div id="error-message" class="hidden text-center py-4 mt-4">
            <div class="inline-flex items-center gap-2 px-4 py-2 bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-400 rounded-lg text-sm">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" />
              </svg>
              Something went wrong. Please try again or email me directly.
            </div>
          </div>

        </Card>

        <!-- Direct Contact Info -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 max-w-3xl mx-auto">
          <div class="text-center p-6 bg-white dark:bg-stone-900/60 rounded-lg border border-stone-200 dark:border-stone-800">
            <div class="text-accent-600 dark:text-accent-400 mb-3 flex justify-center">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <h3 class="font-semibold text-navy-900 dark:text-white mb-1">Phone</h3>
            <a href="tel:+15183486864" class="text-accent-600 dark:text-accent-400 hover:underline">
              (518) 348-6864
            </a>
          </div>

          <div class="text-center p-6 bg-white dark:bg-stone-900/60 rounded-lg border border-stone-200 dark:border-stone-800">
            <div class="text-accent-600 dark:text-accent-400 mb-3 flex justify-center">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="font-semibold text-navy-900 dark:text-white mb-1">Email</h3>
            <a id="email-link" href="#" class="text-accent-600 dark:text-accent-400 hover:underline">
              <span id="email-text">Loading...</span>
            </a>
          </div>

          <div class="text-center p-6 bg-white dark:bg-stone-900/60 rounded-lg border border-stone-200 dark:border-stone-800">
            <div class="text-accent-600 dark:text-accent-400 mb-3 flex justify-center">
              <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </div>
            <h3 class="font-semibold text-navy-900 dark:text-white mb-1">LinkedIn</h3>
            <a href="https://www.linkedin.com/in/will-mau/" target="_blank" rel="noopener noreferrer" class="text-accent-600 dark:text-accent-400 hover:underline">
              /in/will-mau
            </a>
          </div>
        </div>
      </div>
    </Section>
  </main>

  <Footer />

  <script>
    // Obfuscated email assembly (prevents bot scraping)
    const _u = 'will';
    const _d = 'mauops.com';
    const _e = `${_u}@${_d}`;

    // Populate email link and text
    const emailLink = document.getElementById('email-link') as HTMLAnchorElement;
    const emailText = document.getElementById('email-text');
    if (emailLink) emailLink.href = `mailto:${_e}`;
    if (emailText) emailText.textContent = _e;

    const form = document.getElementById('contact-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const successMessage = document.getElementById('success-message');
    const errorMessage = document.getElementById('error-message');
    const serviceBadge = document.getElementById('service-badge');
    const serviceNameEl = document.getElementById('service-name');
    const serviceInput = document.getElementById('service') as HTMLInputElement;
    const tierInput = document.getElementById('tier') as HTMLInputElement;
    const sourcePageInput = document.getElementById('source-page') as HTMLInputElement;
    const formSubject = document.getElementById('form-subject') as HTMLInputElement;

    // Service name mapping
    const serviceNames: Record<string, string> = {
      'ai': 'AI Solutions',
      'salesforce': 'Salesforce & CRM',
      'automation': 'Workflows & Integrations',
      'website': 'Websites & Digital Presence',
      'advisory': 'Advisory Sessions'
    };

    // Read URL query parameters
    const urlParams = new URLSearchParams(window.location.search);
    const serviceParam = urlParams.get('service');
    const tierParam = urlParams.get('tier');
    const sourceParam = urlParams.get('source');

    // Build display label from service + tier
    let displayLabel = '';
    if (serviceParam && serviceNames[serviceParam]) {
      displayLabel = serviceNames[serviceParam];
      if (serviceInput) serviceInput.value = serviceNames[serviceParam];
    }
    if (tierParam) {
      const tierDecoded = decodeURIComponent(tierParam);
      if (tierInput) tierInput.value = tierDecoded;
      displayLabel += displayLabel ? ` / ${tierDecoded}` : tierDecoded;
    }
    if (sourceParam) {
      if (sourcePageInput) sourcePageInput.value = decodeURIComponent(sourceParam);
    }

    // Show badge
    if (displayLabel && serviceBadge && serviceNameEl) {
      serviceNameEl.textContent = displayLabel;
      serviceBadge.classList.remove('hidden');
    }

    // Set subject line for Formspree email
    if (displayLabel && formSubject) {
      formSubject.value = `Website Contact: ${displayLabel}`;
    }

    // Handle form submission via fetch (AJAX, no redirect)
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Disable button and show loading state
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';
      }
      errorMessage?.classList.add('hidden');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { 'Accept': 'application/json' }
        });

        if (response.ok) {
          // Hide form, show success
          form.classList.add('hidden');
          successMessage?.classList.remove('hidden');
        } else {
          throw new Error('Form submission failed');
        }
      } catch {
        // Show error, re-enable button
        errorMessage?.classList.remove('hidden');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send Message';
        }
      }
    });

  </script>
</BaseLayout>
