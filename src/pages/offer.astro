---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
import { pricing, offer } from '../config/pricing';

const isOpen = offer.active && offer.spotsLeft > 0;
const WORDS = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const w = (n: number) => WORDS[n] ?? String(n);
const W = (n: number) => w(n).charAt(0).toUpperCase() + w(n).slice(1);
const cta = '/contact/?service=website&source=offer-250';

const included = [
  {
    title: 'A real website',
    body: `Up to ${w(offer.pages)} pages, designed and built around your business. Fast, clean, and it works properly on phones.`,
    icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  },
  {
    title: 'Set up to be found',
    body: 'Local SEO built in from the start, and your Google Business Profile set up or cleaned up so you show up for nearby searches.',
    icon: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
  },
  {
    title: 'A session on Google',
    body: 'One-on-one time walking through how customers find you, what helps you show up, and what to keep doing after launch.',
    icon: 'M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z',
  },
  {
    title: `${W(offer.years)} years of care`,
    body: 'Hosting, security patches, uptime monitoring, and a check every quarter on links and speed. All included.',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
];

const yes = [
  `Up to ${w(offer.pages)} pages: home, about, services, contact, and one more`,
  'Mobile-first design that loads fast',
  'Local SEO: page titles, descriptions, structured data, speed',
  'Google Business Profile setup or cleanup',
  'A one-on-one session on getting found on Google',
  'Click-to-call, email, and a map so customers can reach you',
  `${W(offer.years)} years of hosting, SSL, monitoring, patches, and quarterly checks`,
];

const no = [
  { item: 'Contact and booking forms', price: pricing.forms },
  { item: 'A content manager or custom software', price: pricing.app },
  { item: 'Moving an existing site', price: 'Quoted after a conversation' },
  { item: 'Changes and new content after launch', price: `${pricing.hourly}, quick ones free` },
];

const steps = [
  { n: '1', title: 'Tell me about your business', body: 'A short call or a message. What you do, who you serve, and what you want people to do when they land on your site.' },
  { n: '2', title: 'See a free mockup', body: 'You get a real, working version to look at before any money changes hands. If it is not right, you walk away owing nothing.' },
  { n: '3', title: 'Launch and pay', body: `Once you approve it, I publish it and you pay ${offer.price}. That is the whole cost for the site.` },
  { n: '4', title: 'Two years looked after', body: 'I keep it running and patched, set up your Google Business Profile, and we do your session on getting found.' },
];

const faqs = [
  {
    q: `What counts as a standard site?`,
    a: `Up to ${w(offer.pages)} pages, typically home, about, services, contact, and one more of your choosing. It is the right size for most local businesses: enough to explain what you do and make it easy to reach you. If you need more pages, custom forms, or software behind it, those are quoted separately and you will know the price before anything is built.`,
  },
  {
    q: `What does ${w(offer.years)} years of care cover?`,
    a: `Hosting, your SSL certificate, uptime monitoring, security patches, a check every quarter on links and speed, and fixing anything that breaks on my end. It keeps the site running. It does not include changing the site, adding pages, or rewriting content, which are separate.`,
  },
  {
    q: `Can I make changes to my site later?`,
    a: `Yes. Updates and new content are ${pricing.hourly}, billed in 30-minute increments, and anything that takes me a few minutes is free. Most small fixes land in that free category.`,
  },
  {
    q: `What happens after two years?`,
    a: `Care continues at ${pricing.care} if you want it. Nothing renews on its own, and there is no contract that rolls over without you agreeing to it.`,
  },
  {
    q: `Do I pay anything up front?`,
    a: `No. You see a free, working mockup first. You only pay ${offer.price} once you have approved the site and it goes live.`,
  },
  {
    q: `What is the session on getting found on Google?`,
    a: `A one-on-one conversation about how nearby customers actually find businesses like yours: your Google Business Profile, reviews, photos, and the handful of habits that keep you showing up in local search. You leave knowing what to keep doing, not just with a site.`,
  },
  {
    q: `Why only ${w(offer.spots)} spots?`,
    a: `Each one comes with two years of my time, and I would rather look after a few businesses properly than stretch across too many. When the spots are gone, the offer ends.`,
  },
  {
    q: `Do you work outside Schenectady?`,
    a: `Yes. I am based in Schenectady and work with businesses across Albany, Saratoga, Troy, and the rest of the Capital Region, and remotely by video call.`,
  },
];

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});

const offerSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Small business website with two years of care',
  serviceType: 'Website design',
  provider: { '@type': 'ProfessionalService', name: 'Mau Consulting', url: 'https://mauops.com' },
  areaServed: { '@type': 'AdministrativeArea', name: 'Capital Region, New York' },
  offers: {
    '@type': 'Offer',
    price: '250',
    priceCurrency: 'USD',
    availability: isOpen ? 'https://schema.org/LimitedAvailability' : 'https://schema.org/SoldOut',
    url: 'https://mauops.com/offer/',
  },
});
---

<BaseLayout
  title="$250 Website, Two Years of Care | Schenectady NY"
  brandSuffix={false}
  description="A small business website for $250 with two years of hosting and care, local SEO, and a session on getting found on Google. Capital Region, NY."
  pageLabel="$250 Website Offer"
  image="/og-offer.jpg"
  imageAlt="A real website for $250 with two years of care included, three spots, shown on a laptop and a phone"
>
  <Header />
  <script type="application/ld+json" is:inline set:html={faqSchema} />
  <script type="application/ld+json" is:inline set:html={offerSchema} />

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden py-16 sm:py-24 bg-white dark:bg-gray-950">
      <div class="absolute inset-0 bg-gradient-to-br from-accent-50/40 via-transparent to-navy-50/30 dark:from-accent-900/10 dark:via-transparent dark:to-navy-950/20" aria-hidden="true"></div>

      <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-3xl mx-auto text-center">
          {isOpen ? (
            <Badge variant="accent" class="mb-5">
              Limited offer &middot; {offer.spotsLeft} of {offer.spots} spots open
            </Badge>
          ) : (
            <Badge variant="accent" class="mb-5">This offer has ended</Badge>
          )}

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-navy-900 dark:text-white mb-6">
            A real website for {offer.price}, looked after for two years.
          </h1>

          <p class="text-xl text-stone-600 dark:text-stone-300 mb-8">
            A fast, mobile-friendly site for your business, set up to show up on Google, with {w(offer.years)} years of hosting and care included. I am taking {w(offer.spots)} of these.
          </p>

          {isOpen ? (
            <div class="flex flex-wrap gap-4 justify-center">
              <Button href={cta} variant="primary" size="lg">Claim a spot</Button>
              <Button href="#included" variant="outline" size="lg">See what is included</Button>
            </div>
          ) : (
            <div class="flex flex-wrap gap-4 justify-center">
              <Button href="/website-design/" variant="primary" size="lg">See current website pricing</Button>
            </div>
          )}

          <p class="mt-6 text-sm text-stone-500 dark:text-stone-400">
            Free mockup first. You pay nothing until you have seen it and approved it.
          </p>
        </div>
      </div>
    </section>

    <!-- What you get -->
    <Section id="included" class="bg-stone-50 dark:bg-gray-900" title="What you get" subtitle={`Everything a local business needs to be found online, for ${offer.price}.`}>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-5xl">
        {included.map((item) => (
          <Card class="h-full">
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-11 h-11 rounded-xl bg-accent-100 dark:bg-accent-900/40 text-accent-600 dark:text-accent-400 flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-navy-900 dark:text-white mb-1">{item.title}</h3>
                <p class="text-stone-600 dark:text-stone-400">{item.body}</p>
              </div>
            </div>
          </Card>
        ))}
      </div>
    </Section>

    <!-- The math -->
    <Section class="bg-white dark:bg-gray-950" title="The math">
      <div class="max-w-xl">
        <Card>
          <dl class="divide-y divide-stone-200 dark:divide-stone-800">
            <div class="flex justify-between py-3">
              <dt class="text-stone-600 dark:text-stone-400">Standard site</dt>
              <dd class="font-medium text-navy-900 dark:text-white">$250</dd>
            </div>
            <div class="flex justify-between py-3">
              <dt class="text-stone-600 dark:text-stone-400">Care, {w(offer.years)} years at {pricing.care}</dt>
              <dd class="font-medium text-navy-900 dark:text-white">$200</dd>
            </div>
            <div class="flex justify-between py-3">
              <dt class="text-stone-600 dark:text-stone-400">Google Business Profile and session</dt>
              <dd class="font-medium text-navy-900 dark:text-white">Included</dd>
            </div>
            <div class="flex justify-between py-3">
              <dt class="text-stone-600 dark:text-stone-400">Usual total</dt>
              <dd class="font-medium text-stone-500 dark:text-stone-400 line-through">{offer.value}</dd>
            </div>
            <div class="flex justify-between py-4">
              <dt class="text-lg font-semibold text-navy-900 dark:text-white">Your price</dt>
              <dd class="text-2xl font-bold text-accent-600 dark:text-accent-400">{offer.price}</dd>
            </div>
          </dl>
        </Card>
      </div>
    </Section>

    <!-- Scope -->
    <Section class="bg-stone-50 dark:bg-gray-900" title="Exactly what is in it" subtitle="So there are no surprises, here is what the offer covers and what costs extra.">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl">
        <Card class="h-full">
          <h3 class="text-lg font-semibold text-navy-900 dark:text-white mb-4">Included</h3>
          <ul class="space-y-3">
            {yes.map((item) => (
              <li class="flex gap-3 text-stone-700 dark:text-stone-300">
                <svg class="w-5 h-5 flex-shrink-0 text-green-600 dark:text-green-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </Card>
        <Card class="h-full">
          <h3 class="text-lg font-semibold text-navy-900 dark:text-white mb-4">Available separately</h3>
          <ul class="space-y-3">
            {no.map((row) => (
              <li class="flex justify-between gap-4 text-stone-700 dark:text-stone-300">
                <span>{row.item}</span>
                <span class="text-right text-sm text-stone-500 dark:text-stone-400 whitespace-nowrap">{row.price}</span>
              </li>
            ))}
          </ul>
        </Card>
      </div>
    </Section>

    <!-- How it works -->
    <Section class="bg-white dark:bg-gray-950" title="How it works">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {steps.map((s) => (
          <div>
            <div class="w-10 h-10 rounded-full bg-accent-600 text-white font-bold flex items-center justify-center mb-4">{s.n}</div>
            <h3 class="text-lg font-semibold text-navy-900 dark:text-white mb-2">{s.title}</h3>
            <p class="text-stone-600 dark:text-stone-400">{s.body}</p>
          </div>
        ))}
      </div>
    </Section>

    <!-- FAQ -->
    <Section class="bg-stone-50 dark:bg-gray-900" title="Questions">
      <div class="max-w-3xl space-y-4">
        {faqs.map((f) => (
          <details class="group bg-white dark:bg-gray-950 border border-stone-200 dark:border-stone-800 rounded-xl p-5">
            <summary class="flex justify-between items-center cursor-pointer font-semibold text-navy-900 dark:text-white list-none">
              {f.q}
              <svg class="w-5 h-5 text-stone-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="mt-3 text-stone-600 dark:text-stone-400">{f.a}</p>
          </details>
        ))}
      </div>
    </Section>

    <!-- CTA -->
    <section class="py-16 sm:py-20 bg-navy-900 dark:bg-navy-950">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-2xl">
        {isOpen ? (
          <>
            <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">{offer.spotsLeft} of {offer.spots} spots open</h2>
            <p class="text-lg text-stone-300 mb-8">Start with a free mockup. If it is not right for your business, you owe nothing.</p>
            <Button href={cta} variant="primary" size="lg">Claim a spot</Button>
          </>
        ) : (
          <>
            <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">This offer has ended</h2>
            <p class="text-lg text-stone-300 mb-8">Thanks to everyone who took a spot. Websites are still available at regular pricing, with a free mockup first.</p>
            <Button href="/website-design/" variant="primary" size="lg">See website pricing</Button>
          </>
        )}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
