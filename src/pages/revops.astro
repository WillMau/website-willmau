---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
---

<BaseLayout
  title="Salesforce & RevOps Systems"
  description="Salesforce-certified RevOps expert. Eliminate funnel bottlenecks, improve data quality, build executive dashboards, and optimize your revenue operations workflows."
>
  <Header />

  <main>
    <Hero
      title="Salesforce & Revenue Operations Systems"
      subtitle="Certified Salesforce Administrator specializing in workflow optimization, executive reporting, and eliminating revenue friction."
    >
      <Button href="/contact" variant="primary" size="lg">Request Consultation</Button>
      <Button href="/work" variant="outline" size="lg">View Case Studies</Button>
    </Hero>

    <!-- What I Do -->
    <Section
      title="What I Do"
      subtitle="Practical Salesforce and RevOps work that improves sales velocity and data quality"
      class="bg-white dark:bg-gray-900"
    >
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <div class="flex items-start gap-3">
          <span class="text-accent-600 dark:text-accent-400 text-2xl">→</span>
          <div>
            <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Lifecycle Definitions</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">Clear stage definitions, entry/exit criteria, and handoff protocols between Marketing and Sales</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-accent-600 dark:text-accent-400 text-2xl">→</span>
          <div>
            <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Routing & Ownership</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">Lead/account assignment rules, queue management, and preventing leads from falling through cracks</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-accent-600 dark:text-accent-400 text-2xl">→</span>
          <div>
            <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Stage Conversion Diagnostics</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">Identify where deals stall, measure conversion rates, and surface bottlenecks in the pipeline</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-accent-600 dark:text-accent-400 text-2xl">→</span>
          <div>
            <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Data Hygiene & Dedupe</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">Merge duplicates, enforce validation rules, and establish data quality controls</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-accent-600 dark:text-accent-400 text-2xl">→</span>
          <div>
            <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Automation Cleanup</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">Audit workflows, process builder, and flows to remove redundancies and improve performance</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-accent-600 dark:text-accent-400 text-2xl">→</span>
          <div>
            <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Executive Dashboards</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">Pipeline health, win rates, rep performance, forecast accuracy—built for decision-making</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-accent-600 dark:text-accent-400 text-2xl">→</span>
          <div>
            <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Lead Scoring (without Einstein)</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">Build pragmatic scoring models using native fields, formulas, and automation</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-accent-600 dark:text-accent-400 text-2xl">→</span>
          <div>
            <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Pardot/Account Engagement</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">Marketing automation setup, nurture campaigns, form handlers, and Salesforce sync</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-accent-600 dark:text-accent-400 text-2xl">→</span>
          <div>
            <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Governance & Documentation</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">Field audit, process documentation, and change management protocols</p>
          </div>
        </div>
      </div>
    </Section>

    <!-- Engagement Types -->
    <Section
      title="RevOps Engagements"
      subtitle="Fixed-scope projects designed to deliver measurable improvements"
      class="bg-gray-50 dark:bg-gray-800"
    >
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        <!-- Health Check -->
        <Card>
          <Badge variant="accent" class="mb-4">1–2 Weeks</Badge>
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">
            Salesforce Health Check
          </h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            Comprehensive audit of your Salesforce instance to identify bottlenecks, data issues, and quick wins.
          </p>
          <div class="mb-4">
            <p class="font-semibold text-gray-900 dark:text-white mb-2">You'll get:</p>
            <ul class="space-y-1 text-sm text-gray-700 dark:text-gray-300">
              <li class="flex items-start gap-2">
                <span class="text-accent-600 dark:text-accent-400">✓</span>
                <span>Funnel health assessment</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent-600 dark:text-accent-400">✓</span>
                <span>Data quality report</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent-600 dark:text-accent-400">✓</span>
                <span>Automation audit</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent-600 dark:text-accent-400">✓</span>
                <span>Prioritized recommendations</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent-600 dark:text-accent-400">✓</span>
                <span>30-minute leadership debrief</span>
              </li>
            </ul>
          </div>
          <Button href="/contact" variant="primary" size="sm">Request Health Check</Button>
        </Card>

        <!-- Routing & Lifecycle Sprint -->
        <Card>
          <Badge variant="accent" class="mb-4">2 Weeks</Badge>
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">
            Routing & Lifecycle Sprint
          </h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            Fix lead routing, define lifecycle stages, and establish clear handoffs between Marketing and Sales.
          </p>
          <div class="mb-4">
            <p class="font-semibold text-gray-900 dark:text-white mb-2">You'll get:</p>
            <ul class="space-y-1 text-sm text-gray-700 dark:text-gray-300">
              <li class="flex items-start gap-2">
                <span class="text-accent-600 dark:text-accent-400">✓</span>
                <span>Documented lifecycle definitions</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent-600 dark:text-accent-400">✓</span>
                <span>Lead routing rules (territory, round-robin, queue)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent-600 dark:text-accent-400">✓</span>
                <span>MQL/SQL criteria and handoff protocols</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent-600 dark:text-accent-400">✓</span>
                <span>Validation and testing</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent-600 dark:text-accent-400">✓</span>
                <span>Team training documentation</span>
              </li>
            </ul>
          </div>
          <Button href="/contact" variant="primary" size="sm">Start Sprint</Button>
        </Card>

        <!-- Dashboard Pack -->
        <Card>
          <Badge variant="accent" class="mb-4">1 Week</Badge>
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">
            Executive Dashboard Pack
          </h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            Custom dashboards designed for executives who need clean, actionable insights.
          </p>
          <div class="mb-4">
            <p class="font-semibold text-gray-900 dark:text-white mb-2">You'll get:</p>
            <ul class="space-y-1 text-sm text-gray-700 dark:text-gray-300">
              <li class="flex items-start gap-2">
                <span class="text-accent-600 dark:text-accent-400">✓</span>
                <span>3–5 executive dashboards</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent-600 dark:text-accent-400">✓</span>
                <span>Pipeline health & velocity</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent-600 dark:text-accent-400">✓</span>
                <span>Win rates & conversion metrics</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent-600 dark:text-accent-400">✓</span>
                <span>Rep performance tracking</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent-600 dark:text-accent-400">✓</span>
                <span>Usage guide & training</span>
              </li>
            </ul>
          </div>
          <Button href="/contact" variant="primary" size="sm">Order Dashboard Pack</Button>
        </Card>
      </div>
    </Section>

    <!-- Proof / Case Studies -->
    <Section
      title="Proven Results"
      subtitle="Real improvements from Salesforce and RevOps engagements"
      class="bg-white dark:bg-gray-900"
    >
      <div class="max-w-4xl mx-auto space-y-6">
        <div class="bg-accent-50 dark:bg-accent-900/20 rounded-lg p-6 border-l-4 border-accent-600">
          <p class="text-lg text-gray-900 dark:text-white font-semibold mb-2">
            87% reduction in funnel bottlenecks
          </p>
          <p class="text-gray-700 dark:text-gray-300">
            Reengineered Salesforce and Pardot workflows to eliminate major friction points, improving sales velocity and forecasting accuracy. Documented lifecycle stages, fixed routing rules, and automated data quality checks.
          </p>
        </div>

        <div class="bg-accent-50 dark:bg-accent-900/20 rounded-lg p-6 border-l-4 border-accent-600">
          <p class="text-lg text-gray-900 dark:text-white font-semibold mb-2">
            10x productivity increase in 6 months
          </p>
          <p class="text-gray-700 dark:text-gray-300">
            Led enterprise-wide Salesforce implementation automating workflows, improving data integrity, and standardizing reporting. Result: measurable productivity gains and better visibility for leadership.
          </p>
        </div>

        <div class="bg-accent-50 dark:bg-accent-900/20 rounded-lg p-6 border-l-4 border-accent-600">
          <p class="text-lg text-gray-900 dark:text-white font-semibold mb-2">
            Executive dashboards guiding strategic decisions
          </p>
          <p class="text-gray-700 dark:text-gray-300">
            Built performance dashboards tracking pipeline health, win rates, and rep performance. Sales leadership used these insights to guide territory planning, quota setting, and investment decisions.
          </p>
        </div>
      </div>

      <div class="text-center mt-12">
        <Button href="/work" variant="primary" size="lg">View Full Case Studies</Button>
      </div>
    </Section>

    <!-- Tools & Approach -->
    <Section
      title="Tools & Approach"
      class="bg-gray-50 dark:bg-gray-800"
    >
      <div class="max-w-4xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
              Primary Tools
            </h3>
            <div class="space-y-2">
              <Badge variant="accent">Salesforce Sales Cloud</Badge>
              <Badge variant="accent">Pardot / Account Engagement</Badge>
              <Badge variant="accent">Salesforce Reporting & Dashboards</Badge>
              <Badge variant="accent">Process Builder / Flows</Badge>
              <Badge variant="accent">Validation Rules & Formulas</Badge>
              <Badge variant="accent">Excel / CSV Data Tools</Badge>
            </div>
          </div>

          <div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
              My Approach
            </h3>
            <ul class="space-y-3 text-gray-700 dark:text-gray-300">
              <li class="flex items-start gap-3">
                <span class="text-accent-600 dark:text-accent-400 mt-1">▸</span>
                <span><strong>Diagnostic-first:</strong> Understand the system before changing it</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-accent-600 dark:text-accent-400 mt-1">▸</span>
                <span><strong>Pragmatic:</strong> Use native tools before adding complexity</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-accent-600 dark:text-accent-400 mt-1">▸</span>
                <span><strong>Security-minded:</strong> Respect data governance and compliance</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-accent-600 dark:text-accent-400 mt-1">▸</span>
                <span><strong>Documented:</strong> Every change comes with clear documentation</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </Section>

    <!-- CTA -->
    <Section class="bg-accent-600 dark:bg-accent-700 text-white">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl sm:text-4xl font-bold mb-6">
          Let's diagnose what's broken
        </h2>
        <p class="text-xl mb-8 text-accent-50">
          If your Salesforce instance has bottlenecks, data quality issues, or unclear workflows—let's fix it.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <Button href="/contact" variant="secondary" size="lg">Request Consultation</Button>
          <Button href="/consulting" variant="outline" size="lg" class="!border-white !text-white hover:!bg-white/10">View All Services</Button>
        </div>
      </div>
    </Section>
  </main>

  <Footer />
</BaseLayout>
