---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
  title="Home"
  description="Mau Consulting — Business technology consulting for small businesses. Salesforce, automation, websites, AI, and team training. Your technical partner for growth."
>
  <Header />

  <main>
    <!-- ============================= -->
    <!-- HERO                           -->
    <!-- ============================= -->
    <section class="relative overflow-hidden bg-white dark:bg-gray-950">
      <!-- Subtle circuit-grid background -->
      <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.05]" aria-hidden="true" style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M60 0H0v60' fill='none' stroke='%231ab893' stroke-width='.5'/%3E%3C/svg%3E&quot;); background-size: 60px 60px;"></div>

      <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 pt-16 sm:pt-24 pb-16 sm:pb-20">
        <!-- Headline + proof -->
        <div class="max-w-3xl mx-auto text-center mb-14">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 dark:text-white mb-6 leading-[1.1]">
            Technology that works<br />
            <span class="text-accent-600 dark:text-accent-400">as hard as you do.</span>
          </h1>
          <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-400 leading-relaxed max-w-2xl mx-auto mb-8">
            I help small businesses untangle their tech, automate the busywork,
            and build systems that actually scale&nbsp;&mdash; then train your team to run them.
          </p>

          <!-- Proof bar inline -->
          <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-slate-500 dark:text-slate-400 mb-10">
            <span class="font-semibold text-slate-900 dark:text-white">Salesforce Certified</span>
            <span class="hidden sm:inline text-slate-300 dark:text-slate-700">|</span>
            <span>15+ Years Operations</span>
            <span class="hidden sm:inline text-slate-300 dark:text-slate-700">|</span>
            <span>New York&ndash;Based</span>
            <span class="hidden sm:inline text-slate-300 dark:text-slate-700">|</span>
            <span>Documentation + Training</span>
          </div>

          <div class="flex flex-wrap gap-4 justify-center">
            <Button href="/contact" variant="primary" size="lg">
              Book a Free Call
            </Button>
            <Button href="#problems" variant="outline" size="lg">
              See How I Can Help
            </Button>
          </div>
        </div>

        <!-- Service tiles — immediately visible -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 max-w-4xl mx-auto">
          {[
            {
              title: 'Salesforce & CRM',
              desc: 'A CRM your team actually uses.',
              href: '/salesforce-consulting',
              icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
            },
            {
              title: 'Workflows & Integrations',
              desc: 'Turn chaos into a clear flow.',
              href: '/automation-consulting',
              icon: 'M13 10V3L4 14h7v7l9-11h-7z',
            },
            {
              title: 'Websites & Digital Presence',
              desc: 'A sharp site that brings leads in.',
              href: '/website-design',
              icon: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9',
            },
            {
              title: 'Systems & Process Design',
              desc: 'Make tools work together—on purpose.',
              href: '/consulting',
              icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
            },
          ].map((svc) => (
            <a href={svc.href} class="group block">
              <div class="h-full p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 hover:border-accent-400 dark:hover:border-accent-600 hover:shadow-lg hover:shadow-accent-500/[0.08] hover:-translate-y-0.5 transition-all duration-200 text-center">
                <div class="w-10 h-10 rounded-lg bg-accent-50 dark:bg-accent-900/30 border border-accent-200/60 dark:border-accent-800/40 flex items-center justify-center mx-auto mb-3 group-hover:bg-accent-100 dark:group-hover:bg-accent-900/50 transition-colors">
                  <svg class="w-5 h-5 text-accent-600 dark:text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={svc.icon} />
                  </svg>
                </div>
                <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-1 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">{svc.title}</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">{svc.desc}</p>
              </div>
            </a>
          ))}
        </div>
        <p class="text-center font-mono text-[10px] tracking-widest uppercase text-slate-400 dark:text-slate-500 mt-5">AI-enabled workflows &ensp;|&ensp; Documentation &ensp;|&ensp; Team Training included</p>
      </div>
    </section>

    <!-- ============================= -->
    <!-- PROBLEMS (moved up)            -->
    <!-- ============================= -->
    <section id="problems" class="py-16 sm:py-20 bg-slate-50 dark:bg-gray-900">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center">
          <p class="font-mono text-xs tracking-widest uppercase text-accent-600 dark:text-accent-400 mb-3">Sound Familiar?</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-10">
            Problems I solve every week
          </h2>
          <div class="flex flex-wrap justify-center gap-3">
            {[
              '\u201CSales doesn\u2019t see value in our CRM\u201D',
              '\u201CWe\u2019re stuck in copy/paste between tools\u201D',
              '\u201COur process lives in people\u2019s heads\u201D',
              '\u201COur numbers never match\u201D',
              '\u201CLeads fall through the cracks\u201D',
              '\u201CWe need a website that converts\u201D',
              '\u201CAI feels overwhelming \u2014 where do we start?\u201D',
            ].map((problem) => (
              <span class="inline-block px-4 py-2.5 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm text-slate-600 dark:text-slate-300 shadow-sm hover:border-accent-300 dark:hover:border-accent-600 hover:shadow-md transition-all duration-200 cursor-default">
                {problem}
              </span>
            ))}
          </div>
          <p class="mt-8 text-slate-500 dark:text-slate-400">
            If any of these hit home,
            <a href="/contact" class="text-accent-600 dark:text-accent-400 font-medium hover:underline underline-offset-2">let&rsquo;s talk</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================= -->
    <!-- SERVICES (detailed)            -->
    <!-- ============================= -->
    <section id="services" class="py-20 sm:py-28 bg-white dark:bg-gray-950">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <p class="font-mono text-xs tracking-widest uppercase text-accent-600 dark:text-accent-400 mb-3">What I Do</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-4">
          Build it. Connect it. Teach it.
        </h2>
        <p class="text-lg text-slate-500 dark:text-slate-400 mb-14 max-w-2xl">
          I don&rsquo;t just set things up and disappear. Every project includes documentation and training&hellip;so your team can run it confidently without me.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {[
            {
              label: 'CRM + PIPELINE',
              title: 'Salesforce & CRM',
              desc: 'Make your CRM useful for sales\u2014clear stages, clean data, and dashboards you trust.',
              items: ['Setup & cleanup', 'Sales stages that match reality', 'Dashboards & reporting', 'Data hygiene & permissions'],
              href: '/salesforce-consulting',
            },
            {
              label: 'AUTOMATION + INTEGRATIONS',
              title: 'Workflows & Integrations',
              desc: 'Turn chaos into a clear flow\u2014so leads, tasks, and updates move smoothly across your tools.',
              items: ['Automate handoffs (less copy/paste)', 'Connect tools using built-in integrations', 'Lightweight API connections (when needed)', 'Keep data clean and consistent'],
              href: '/automation-consulting',
            },
            {
              label: 'GROWTH + DIGITAL',
              title: 'Websites & Digital Presence',
              desc: 'A modern site that looks sharp and brings in inquiries\u2014built to connect to how you work.',
              items: ['Website builds & refreshes', 'Forms + lead capture', 'Tracking basics (so you know what\u2019s working)', 'Easy handoff and simple edits'],
              href: '/website-design',
            },
            {
              label: 'TRAINING + ENABLEMENT',
              title: 'Training & Documentation',
              desc: 'Clear handoff, clear docs, and training your team will actually use.',
              items: ['Live walkthroughs', 'Documentation of changes + \u201Chow it works\u201D', 'Simple guides and checklists', 'Post-launch support (as needed)'],
              href: '/consulting',
            },
          ].map((svc) => (
            <a href={svc.href} class="group block">
              <div class="relative h-full p-8 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 hover:border-accent-300 dark:hover:border-accent-700 hover:shadow-lg hover:shadow-accent-500/[0.06] hover:-translate-y-1 transition-all duration-300">
                <p class="font-mono text-[10px] tracking-widest uppercase text-slate-400 dark:text-slate-500 mb-4">{svc.label}</p>
                <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">{svc.title}</h3>
                <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed mb-6">{svc.desc}</p>
                <ul class="space-y-2.5">
                  {svc.items.map((item: string) => (
                    <li class="flex items-center gap-2.5 text-sm text-slate-600 dark:text-slate-300">
                      <div class="w-1.5 h-1.5 rounded-full bg-accent-500 flex-shrink-0"></div>
                      {item}
                    </li>
                  ))}
                </ul>
                <div class="mt-6 text-accent-600 dark:text-accent-400 text-sm font-medium opacity-0 group-hover:opacity-100 translate-y-1 group-hover:translate-y-0 transition-all duration-200">
                  Learn more&ensp;&rarr;
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================= -->
    <!-- HOW I WORK                     -->
    <!-- ============================= -->
    <section class="py-20 sm:py-28 bg-slate-50 dark:bg-gray-900">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <p class="font-mono text-xs tracking-widest uppercase text-accent-600 dark:text-accent-400 mb-3">Partner Approach</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-14">
          How it works
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
          {[
            {
              step: '01',
              title: 'Listen & Map',
              desc: 'Free 30-minute call. I learn how your business actually runs\u2014your tools, your people, your pain points. No pressure\u2014just questions.',
            },
            {
              step: '02',
              title: 'Build & Ship',
              desc: 'Clear scope, fixed timeline. I build, test, and deliver\u2014so your system runs smoothly and your team knows what to do next.',
            },
            {
              step: '03',
              title: 'Train & Support',
              desc: 'I train your team to own the system\u2014so you\u2019re not dependent on me. Then I\u2019m here if you need support as you grow. No lock-in. No surprises.',
            },
          ].map((item) => (
            <div class="relative group">
              <div class="flex items-center gap-3 mb-4">
                <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-accent-50 dark:bg-accent-900/30 text-accent-600 dark:text-accent-400 font-mono text-xs font-bold border border-accent-200/60 dark:border-accent-800/40">
                  {item.step}
                </span>
                <div class="h-px flex-1 bg-slate-200 dark:bg-slate-800 group-hover:bg-accent-300 dark:group-hover:bg-accent-700 transition-colors"></div>
              </div>
              <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">{item.title}</h3>
              <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================= -->
    <!-- RESULTS                        -->
    <!-- ============================= -->
    <section id="results" class="py-20 sm:py-28 bg-white dark:bg-gray-950">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <p class="font-mono text-xs tracking-widest uppercase text-accent-600 dark:text-accent-400 mb-3">Results</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-4">
          Real projects. Real impact.
        </h2>
        <p class="text-lg text-slate-500 dark:text-slate-400 mb-14 max-w-2xl">
          Practical changes that saved time, reduced manual work, and made systems reliable.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

          <!-- Card 1: Process Optimization -->
          <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/60 hover:shadow-md transition-shadow duration-200 overflow-hidden flex flex-col">
            <div class="p-8 flex-1">
              <div class="mb-6 pb-5 border-b border-slate-100 dark:border-slate-800">
                <span class="text-4xl font-bold text-accent-600 dark:text-accent-400 tabular-nums" data-countup="89" data-suffix="%">0%</span>
                <span class="block text-sm text-slate-500 dark:text-slate-400 mt-1">fewer manual steps</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Process Optimization</h3>
              <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed mb-5">Cut a sprawling 73-step process down to 8 by removing redundant handoffs and consolidating spreadsheets into one reliable workflow.</p>
              <p class="font-mono text-[10px] tracking-widest uppercase text-slate-400 dark:text-slate-500 mb-2">Highlights</p>
              <ul class="space-y-2 mb-5">
                <li class="flex items-start gap-2.5 text-sm text-slate-600 dark:text-slate-300"><div class="w-1.5 h-1.5 rounded-full bg-accent-500 flex-shrink-0 mt-1.5"></div>Consolidated 15 spreadsheets</li>
                <li class="flex items-start gap-2.5 text-sm text-slate-600 dark:text-slate-300"><div class="w-1.5 h-1.5 rounded-full bg-accent-500 flex-shrink-0 mt-1.5"></div>Steps reduced: 73 &rarr; 8</li>
                <li class="flex items-start gap-2.5 text-sm text-slate-600 dark:text-slate-300"><div class="w-1.5 h-1.5 rounded-full bg-accent-500 flex-shrink-0 mt-1.5"></div>Trained teams across 3 verticals</li>
              </ul>
              <div class="flex flex-wrap gap-2">
                <span class="text-[11px] font-medium px-2.5 py-1 rounded-md bg-accent-50 dark:bg-accent-900/30 text-accent-700 dark:text-accent-300 border border-accent-200/50 dark:border-accent-800/30">Systems & Process</span>
                <span class="text-[11px] font-medium px-2.5 py-1 rounded-md bg-accent-50 dark:bg-accent-900/30 text-accent-700 dark:text-accent-300 border border-accent-200/50 dark:border-accent-800/30">Workflows</span>
              </div>
            </div>
            <!-- Blueprint diagram: dense flow → clean flow -->
            <div class="border-t border-slate-100 dark:border-slate-800 bg-slate-100/50 dark:bg-slate-800/20 px-6 py-4 text-center">
              <p class="font-mono text-[9px] tracking-widest uppercase text-slate-400 dark:text-slate-500 mb-2">Before &rarr; After</p>
              <svg class="w-full max-w-[260px] mx-auto" viewBox="0 0 280 90" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Before: dense tangled nodes -->
                <g stroke="currentColor" stroke-width="0.9" class="text-slate-400 dark:text-slate-500">
                  <rect x="6" y="8" width="12" height="9" rx="2"/>
                  <rect x="6" y="22" width="12" height="9" rx="2"/>
                  <rect x="6" y="36" width="12" height="9" rx="2"/>
                  <rect x="6" y="50" width="12" height="9" rx="2"/>
                  <rect x="6" y="64" width="12" height="9" rx="2"/>
                  <rect x="24" y="15" width="12" height="9" rx="2"/>
                  <rect x="24" y="29" width="12" height="9" rx="2"/>
                  <rect x="24" y="43" width="12" height="9" rx="2"/>
                  <rect x="24" y="57" width="12" height="9" rx="2"/>
                  <rect x="42" y="8" width="12" height="9" rx="2"/>
                  <rect x="42" y="22" width="12" height="9" rx="2"/>
                  <rect x="42" y="36" width="12" height="9" rx="2"/>
                  <rect x="42" y="50" width="12" height="9" rx="2"/>
                  <rect x="42" y="64" width="12" height="9" rx="2"/>
                  <rect x="60" y="15" width="12" height="9" rx="2"/>
                  <rect x="60" y="36" width="12" height="9" rx="2"/>
                  <rect x="60" y="57" width="12" height="9" rx="2"/>
                  <path d="M18 13 L24 19 M18 27 L24 33 M18 41 L24 47 M18 55 L24 61 M18 27 L24 19 M18 55 L24 47" stroke-dasharray="2 2"/>
                  <path d="M36 19 L42 13 M36 33 L42 27 M36 47 L42 41 M36 61 L42 55 M36 19 L42 27 M36 47 L42 55" stroke-dasharray="2 2"/>
                  <path d="M54 13 L60 19 M54 27 L60 19 M54 41 L60 41 M54 55 L60 61 M54 69 L60 61" stroke-dasharray="2 2"/>
                </g>
                <!-- Label -->
                <text x="40" y="84" font-family="ui-monospace, monospace" font-size="7" fill="currentColor" text-anchor="middle" class="text-slate-400 dark:text-slate-500">73 steps</text>

                <!-- Arrow -->
                <g class="text-accent-600 dark:text-accent-400">
                  <path d="M90 40 L128 40" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 3"/>
                  <path d="M124 36 L130 40 L124 44" stroke="currentColor" stroke-width="1.5" fill="none"/>
                </g>

                <!-- After: clean 4-step flow -->
                <g stroke="currentColor" stroke-width="1.4" class="text-accent-600 dark:text-accent-400">
                  <rect x="148" y="6" width="28" height="16" rx="3" fill="none"/>
                  <rect x="148" y="30" width="28" height="16" rx="3" fill="none"/>
                  <rect x="148" y="54" width="28" height="16" rx="3" fill="none"/>
                  <rect x="194" y="30" width="28" height="16" rx="3" fill="none"/>
                  <path d="M162 22 L162 30 M162 46 L162 54 M176 38 L194 38"/>
                  <path d="M156 12 L159 16 L165 10" stroke-width="1.1"/>
                  <path d="M156 36 L159 40 L165 34" stroke-width="1.1"/>
                  <path d="M156 60 L159 64 L165 58" stroke-width="1.1"/>
                  <path d="M202 36 L205 40 L211 34" stroke-width="1.1"/>
                </g>
                <text x="176" y="84" font-family="ui-monospace, monospace" font-size="7" fill="currentColor" text-anchor="middle" class="text-accent-600 dark:text-accent-400">8 steps</text>
              </svg>
            </div>
          </div>

          <!-- Card 2: Enrollment Flow -->
          <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/60 hover:shadow-md transition-shadow duration-200 overflow-hidden flex flex-col">
            <div class="p-8 flex-1">
              <div class="mb-6 pb-5 border-b border-slate-100 dark:border-slate-800">
                <span class="text-4xl font-bold text-accent-600 dark:text-accent-400 tabular-nums" data-countup="15" data-suffix=" min">0 min</span>
                <span class="block text-sm text-slate-500 dark:text-slate-400 mt-1">interest &rarr; enrolled</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Enrollment Flow</h3>
              <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed mb-5">Reduced the time from interest to enrollment with a single online workflow and a simple, repeatable handoff package.</p>
              <p class="font-mono text-[10px] tracking-widest uppercase text-slate-400 dark:text-slate-500 mb-2">Highlights</p>
              <ul class="space-y-2 mb-5">
                <li class="flex items-start gap-2.5 text-sm text-slate-600 dark:text-slate-300"><div class="w-1.5 h-1.5 rounded-full bg-accent-500 flex-shrink-0 mt-1.5"></div>Interest &rarr; enrolled in 15 min</li>
                <li class="flex items-start gap-2.5 text-sm text-slate-600 dark:text-slate-300"><div class="w-1.5 h-1.5 rounded-full bg-accent-500 flex-shrink-0 mt-1.5"></div>Auto-enrollment workflow</li>
                <li class="flex items-start gap-2.5 text-sm text-slate-600 dark:text-slate-300"><div class="w-1.5 h-1.5 rounded-full bg-accent-500 flex-shrink-0 mt-1.5"></div>Video + quick admin guide</li>
              </ul>
              <div class="flex flex-wrap gap-2">
                <span class="text-[11px] font-medium px-2.5 py-1 rounded-md bg-accent-50 dark:bg-accent-900/30 text-accent-700 dark:text-accent-300 border border-accent-200/50 dark:border-accent-800/30">Enablement</span>
                <span class="text-[11px] font-medium px-2.5 py-1 rounded-md bg-accent-50 dark:bg-accent-900/30 text-accent-700 dark:text-accent-300 border border-accent-200/50 dark:border-accent-800/30">Training</span>
              </div>
            </div>
            <!-- Blueprint diagram: long timeline → stopwatch -->
            <div class="border-t border-slate-100 dark:border-slate-800 bg-slate-100/50 dark:bg-slate-800/20 px-6 py-4 text-center">
              <p class="font-mono text-[9px] tracking-widest uppercase text-slate-400 dark:text-slate-500 mb-2">Before &rarr; After</p>
              <svg class="w-full max-w-[260px] mx-auto" viewBox="0 0 280 90" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Before: calendar + long timeline -->
                <g stroke="currentColor" stroke-width="0.9" class="text-slate-400 dark:text-slate-500">
                  <!-- Calendar -->
                  <rect x="10" y="6" width="18" height="16" rx="2"/>
                  <path d="M10 13 L28 13"/>
                  <path d="M15 3 L15 8 M23 3 L23 8"/>
