---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';

const faqs = [
  {
    q: 'How much does this cost?',
    a: 'Most projects fall between $3,500 and $15K+, depending on scope. After a 30-minute call, I’ll send a clear plan and a fixed quote. No surprises.',
  },
  {
    q: 'Do you work with businesses outside New York?',
    a: 'Yes. Most of my work is remote, and I’ve supported teams across the U.S. and internationally.',
  },
  {
    q: 'We have Salesforce, but people don’t use it. Can you fix that?',
    a: 'Yes. I’ll audit what you have, clean up the data, simplify the workflow, and rebuild the parts that slow your team down. The goal is to make Salesforce a tool your team actually wants to use.',
  },
  {
    q: 'What happens after the project is done?',
    a: 'Every project includes documentation and training so your team can own the system. If you want ongoing support, I also offer office hours.',
  },
  {
    q: 'How long does a typical project take?',
    a: 'Most projects take 2 to 6 weeks depending on scope. After our call, you’ll get a simple timeline with clear milestones.',
  },
  {
    q: 'What if I just need advice, not a full project?',
    a: 'That works too. I offer paid advisory sessions for quick answers, planning, or a second opinion. No long engagement required.',
  },
  {
    q: 'Do you work with small teams or non-technical owners?',
    a: 'Yes. I translate technical work into plain language and build systems your team can actually run day to day.',
  },
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
});
---

<BaseLayout
  title="Home"
  description="Mau Consulting offers fractional operations leadership for small businesses — Salesforce, AI, automation, dashboards, and the systems work in between. Schenectady, Albany, and Capital Region."
>
  <Header />
  <script type="application/ld+json" set:html={faqSchema} />

  <main>
    <!-- ============================= -->
    <!-- HERO                           -->
    <!-- ============================= -->
    <section class="relative overflow-hidden bg-white dark:bg-gray-950">
      <!-- Warm subtle gradient background -->
      <div class="absolute inset-0 bg-gradient-to-br from-accent-50/40 via-transparent to-navy-50/30 dark:from-accent-900/10 dark:via-transparent dark:to-navy-950/20" aria-hidden="true"></div>

      <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 pt-16 sm:pt-24 pb-16 sm:pb-20">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center max-w-6xl mx-auto">
          <!-- Left column: Headline + proof -->
          <div class="text-center lg:text-left">
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-navy-900 dark:text-white mb-6 leading-[1.1]">
              The operations executive your<br />
              <span class="text-accent-600 dark:text-accent-400">small business can&rsquo;t hire full-time.</span>
            </h1>
            <p class="text-lg sm:text-xl text-stone-600 dark:text-stone-400 leading-relaxed max-w-2xl lg:max-w-none mb-8">
              Fifteen years running revenue, technology, and operations at growth-stage companies. Now solving the same problems for small businesses &mdash; Salesforce, AI, dashboards, customer service, automation, and the unglamorous in-between.
            </p>

            <!-- Proof bar inline -->
            <div class="flex flex-wrap items-center justify-center lg:justify-start gap-x-6 gap-y-2 text-sm text-stone-500 dark:text-stone-400 mb-10">
              <span class="font-semibold text-navy-800 dark:text-white">Salesforce Certified</span>
              <span class="hidden sm:inline text-stone-300 dark:text-stone-700">|</span>
              <span>15+ Years Operations</span>
              <span class="hidden sm:inline text-stone-300 dark:text-stone-700">|</span>
              <span>Diagnose Before Building</span>
            </div>

            <div class="flex flex-wrap gap-4 justify-center lg:justify-start">
              <Button href="/contact/?source=homepage" variant="primary" size="lg">
                Book a Free Call
              </Button>
              <Button href="#services" variant="outline" size="lg">
                See What I Do
              </Button>
            </div>

            <p class="mt-5 text-sm text-stone-500 dark:text-stone-400 inline-flex items-center gap-2">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
              </span>
              Currently accepting new projects
            </p>
          </div>

          <!-- Right column: B&W photo -->
          <div>
            <img
              src="/hero-consulting.jpg"
              alt="Consultant working with a client on their business systems"
              class="rounded-2xl grayscale shadow-xl w-full object-cover aspect-[4/3]"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ============================= -->
    <!-- PROBLEMS                       -->
    <!-- ============================= -->
    <section id="problems" class="py-16 sm:py-20 bg-stone-50 dark:bg-gray-900">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center">
          <p class="text-sm font-semibold uppercase tracking-wide text-accent-600 dark:text-accent-400 mb-3">Sound Familiar?</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-navy-900 dark:text-white mb-10">
            Problems I solve every week
          </h2>
          <div class="flex flex-wrap justify-center gap-3">
            {[
              '\u201CWe can\u2019t afford another customer service hire\u201D',
              '\u201CI\u2019m running ops, sales, and the back office myself\u201D',
              '\u201COur reports take all weekend and nobody trusts them\u201D',
              '\u201CSales doesn\u2019t see value in our CRM\u201D',
              '\u201CWe\u2019re stuck in copy/paste between tools\u201D',
              '\u201COur process lives in people\u2019s heads\u201D',
              '\u201CLeads fall through the cracks\u201D',
              '\u201CWe need a website that converts\u201D',
            ].map((problem) => (
              <span class="inline-block px-4 py-2.5 rounded-full bg-white dark:bg-stone-800 border border-stone-200 dark:border-stone-700 text-sm text-stone-600 dark:text-stone-300 shadow-sm hover:border-accent-300 dark:hover:border-accent-600 hover:shadow-md transition-all duration-200 cursor-default">
                {problem}
              </span>
            ))}
          </div>
          <!-- Audit CTA -->
          <div class="mt-10 rounded-2xl border-2 border-accent-300/60 dark:border-accent-700/40 bg-gradient-to-br from-accent-50 to-white dark:from-accent-900/20 dark:to-stone-900/40 p-6 sm:p-8 max-w-2xl mx-auto shadow-sm">
            <div class="flex items-center justify-center gap-2 mb-3">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-accent-600 text-white shadow">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                Free Tool
              </span>
              <span class="text-xs font-semibold uppercase tracking-wide text-stone-500 dark:text-stone-400">5 minutes</span>
            </div>
            <h3 class="text-xl sm:text-2xl font-bold text-navy-900 dark:text-white mb-2">
              Take the Small Business Operations Self-Audit.
            </h3>
            <p class="text-stone-600 dark:text-stone-400 mb-5 leading-relaxed">
              16 plain-spoken questions. Instant personalized diagnosis with your score, your weakest area, and what it&rsquo;s costing you in time and money. No email required to see your results.
            </p>
            <a
              href="/audit/"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-accent-600 hover:bg-accent-700 text-white font-semibold shadow-lg shadow-accent-500/20 hover:shadow-xl hover:shadow-accent-500/30 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
            >
              Start the Audit
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
            <p class="text-xs text-stone-500 dark:text-stone-400 mt-4">
              Or, if you&rsquo;re ready to talk: <a href="/contact/?source=homepage" class="text-accent-600 dark:text-accent-400 font-medium hover:underline underline-offset-2">book a free call</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================= -->
    <!-- SERVICES (detailed)            -->
    <!-- ============================= -->
    <section id="services" class="py-20 sm:py-28 bg-white dark:bg-gray-950">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-sm font-semibold uppercase tracking-wide text-accent-600 dark:text-accent-400 mb-3">What I Do</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-navy-900 dark:text-white mb-4">
          Diagnose. Build. Document. Move on.
        </h2>
        <p class="text-lg text-stone-500 dark:text-stone-400 mb-14 max-w-2xl">
          Four ways I help small businesses. Every project starts with diagnosing the actual problem &mdash; then building, buying, or untangling the smallest thing that fixes it. Documentation and training included, so your team owns the system without depending on me.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            {
              label: 'OPERATIONS',
              title: 'Operations & Process',
              desc: 'Diagnose the bottleneck. Document the work. Replace the duct tape with systems that don\u2019t fall apart when someone goes on vacation.',
              items: ['Process diagnosis & redesign', 'Documentation & runbooks', 'Spreadsheets \u2192 real systems', 'Buy-vs-build advice'],
              href: '/operations/',
            },
            {
              label: 'CRM + PIPELINE',
              title: 'Salesforce & Revenue Systems',
              desc: 'Make your CRM useful for sales: clear stages, clean data, lead routing that works, and dashboards owners actually look at.',
              items: ['Setup & cleanup', 'Lead routing & assignment', 'Pipeline + revenue dashboards', 'Data hygiene & permissions'],
              href: '/salesforce-consulting/',
            },
            {
              label: 'AI + AUTOMATION',
              title: 'AI & Automation',
              desc: 'When the right answer is software, I build it. When the right answer is a vendor, I tell you that instead. AI is one tool \u2014 not the only one.',
              items: ['AI agents for repetitive work', 'Cross-tool workflow automation', 'Document & receipt processing', 'Internal AI assistants'],
              href: '/ai-solutions/',
            },
            {
              label: 'GROWTH + DIGITAL',
              title: 'Websites & Digital Presence',
              desc: 'A modern site that captures leads instead of sitting there. Hooked into the tools you actually use.',
              items: ['Builds & refreshes', 'Forms + lead capture', 'Tracking + SEO basics', 'Easy handoff to non-technical owners'],
              href: '/website-design/',
            },
          ].map((svc) => (
            <a href={svc.href} class="group block">
              <div class="relative h-full p-8 rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900/40 hover:border-accent-300 dark:hover:border-accent-700 hover:shadow-lg hover:shadow-accent-500/[0.06] hover:-translate-y-1 transition-all duration-300">
                <p class="text-xs font-semibold uppercase tracking-wide text-navy-400 dark:text-stone-500 mb-4">{svc.label}</p>
                <h3 class="text-xl font-bold text-navy-900 dark:text-white mb-3 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">{svc.title}</h3>
                <p class="text-sm text-stone-500 dark:text-stone-400 leading-relaxed mb-6">{svc.desc}</p>
                <ul class="space-y-2.5">
                  {svc.items.map((item: string) => (
                    <li class="flex items-center gap-2.5 text-sm text-stone-600 dark:text-stone-300">
                      <div class="w-1.5 h-1.5 rounded-full bg-accent-500 flex-shrink-0"></div>
                      {item}
                    </li>
                  ))}
                </ul>
                <div class="mt-6 text-accent-600 dark:text-accent-400 text-sm font-medium opacity-0 group-hover:opacity-100 translate-y-1 group-hover:translate-y-0 transition-all duration-200">
                  Learn more&ensp;&rarr;
                </div>
              </div>
            </a>
          ))}
        </div>

        <!-- Training callout -->
        <div class="mt-8 rounded-2xl border border-accent-200/60 dark:border-accent-800/40 bg-accent-50/50 dark:bg-accent-900/10 p-6 flex flex-col sm:flex-row items-start sm:items-center gap-4">
          <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-accent-100 dark:bg-accent-900/30 flex items-center justify-center">
            <svg class="w-5 h-5 text-accent-600 dark:text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-navy-900 dark:text-white">Every project includes training + documentation.</p>
            <p class="text-sm text-stone-500 dark:text-stone-400">Live walkthroughs, clear docs, and simple guides so your team owns the system without depending on me.</p>
          </div>
        </div>

        <!-- Fractional banner -->
        <a href="/contact/?source=homepage-fractional" class="group block mt-6 rounded-2xl border border-navy-200/60 dark:border-navy-800/40 bg-navy-50/50 dark:bg-navy-900/20 p-6 hover:border-accent-300 dark:hover:border-accent-700 hover:shadow-md transition-all duration-300">
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-navy-100 dark:bg-navy-900/40 flex items-center justify-center">
              <svg class="w-5 h-5 text-navy-700 dark:text-navy-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
              </svg>
            </div>
            <div class="flex-1">
              <p class="text-sm font-semibold text-navy-900 dark:text-white">Need someone to own a project without hiring full-time?</p>
              <p class="text-sm text-stone-500 dark:text-stone-400">I take on 6&ndash;12 week engagements as fractional ops leadership &mdash; launches, system migrations, project rescue, executive-team backup. When you need an executive in the seat, temporarily.</p>
            </div>
            <div class="hidden sm:block text-accent-600 dark:text-accent-400 text-sm font-medium opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">
              Let&rsquo;s talk&ensp;&rarr;
            </div>
          </div>
        </a>
      </div>
    </section>

    <!-- ============================= -->
    <!-- AI SPOTLIGHT (proof of capability) -->
    <!-- ============================= -->
    <section id="ai-spotlight" class="relative py-20 sm:py-28 overflow-hidden bg-navy-900 dark:bg-navy-950">
      <!-- Decorative pattern -->
      <div class="absolute inset-0 opacity-10" aria-hidden="true" style="background-image: radial-gradient(circle at 20% 30%, white 1px, transparent 1px), radial-gradient(circle at 80% 70%, white 1px, transparent 1px); background-size: 50px 50px;"></div>
      <div class="absolute inset-0 bg-gradient-to-br from-navy-900 via-navy-900 to-accent-900/40" aria-hidden="true"></div>

      <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-6xl mx-auto">
          <!-- Section header -->
          <div class="flex items-center gap-3 mb-4">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-accent-500 text-white shadow-lg">
              <span class="relative flex h-2 w-2 mr-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-white"></span>
              </span>
              Proof of Capability
            </span>
            <span class="text-xs font-semibold uppercase tracking-wide text-accent-300">Recent Win</span>
          </div>

          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4 leading-tight">
            Real result: 68% of a customer-service<br class="hidden sm:inline" /> queue, automated.
          </h2>
          <p class="text-lg text-stone-300 mb-12 max-w-3xl leading-relaxed">
            Here&rsquo;s what one AI build looked like when it was the right tool. The customer-service team scaled from 6 people to 3 while response time improved. About $4/month in API costs. AI isn&rsquo;t always the answer &mdash; but when it is, this is what it looks like.
          </p>

          <!-- Stats grid + CTA -->
          <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 items-center">
            <!-- Big stat -->
            <div class="lg:col-span-2">
              <div class="text-center bg-white/10 backdrop-blur-sm border-2 border-accent-400/50 rounded-2xl p-8">
                <div class="text-xs uppercase tracking-widest text-accent-300 font-bold mb-3">Production Result</div>
                <div class="text-7xl sm:text-8xl font-black text-white leading-none mb-2">68<span class="text-accent-400">%</span></div>
                <div class="text-lg font-semibold text-white mb-1">Cases Auto-Handled</div>
                <div class="text-sm text-stone-300">end-to-end, no human review</div>
              </div>
            </div>

            <!-- Supporting metrics + capabilities -->
            <div class="lg:col-span-3 space-y-6">
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-lg p-4 text-center">
                  <div class="text-2xl font-bold text-white">~$4</div>
                  <div class="text-xs text-stone-300 mt-1">per month</div>
                </div>
                <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-lg p-4 text-center">
                  <div class="text-2xl font-bold text-white">1,516</div>
                  <div class="text-xs text-stone-300 mt-1">cases / 5 weeks</div>
                </div>
                <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-lg p-4 text-center">
                  <div class="text-2xl font-bold text-white">$0.003</div>
                  <div class="text-xs text-stone-300 mt-1">per case</div>
                </div>
                <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-lg p-4 text-center">
                  <div class="text-2xl font-bold text-white">24/7</div>
                  <div class="text-xs text-stone-300 mt-1">running hours</div>
                </div>
              </div>

              <!-- What can be built -->
              <div>
                <p class="text-sm font-semibold text-accent-300 uppercase tracking-wide mb-3">What I can build for you</p>
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2">
                  {[
                    'Customer service agents',
                    'Lead qualification &amp; routing',
                    'Document &amp; receipt automation',
                    'Internal AI assistants',
                    'Custom Salesforce AI integrations',
                    'Smart cross-tool workflows',
                  ].map((item) => (
                    <li class="flex items-center gap-2 text-stone-200">
                      <svg class="w-4 h-4 text-accent-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                      </svg>
                      <span class="text-sm" set:html={item}></span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- CTAs -->
              <div class="flex flex-wrap gap-4 pt-2">
                <a href="/work/" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-accent-500 hover:bg-accent-600 text-white font-semibold transition-colors shadow-lg">
                  See more case studies
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                </a>
                <a href="/contact/?source=homepage-ai-spotlight" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border-2 border-white/30 hover:border-white text-white font-semibold transition-colors">
                  Talk about your bottleneck
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================= -->
    <!-- HOW I WORK                     -->
    <!-- ============================= -->
    <section class="py-20 sm:py-28 bg-stone-50 dark:bg-gray-900">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-sm font-semibold uppercase tracking-wide text-accent-600 dark:text-accent-400 mb-3">Partner Approach</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-navy-900 dark:text-white mb-14">
          How it works
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
          {[
            {
              step: '01',
              title: 'Listen & Map',
              desc: 'Free 30-minute call. I learn how your business actually runs: your tools, your people, your pain points. No pressure, just questions.',
            },
            {
              step: '02',
              title: 'Build & Ship',
              desc: 'Clear scope, fixed timeline. I build, test, and deliver so your system runs smoothly and your team knows what to do next.',
            },
            {
              step: '03',
              title: 'Train & Support',
              desc: 'I train your team to own the system so you\u2019re not dependent on me. Then I\u2019m here if you need support as you grow. No lock-in. No surprises.',
            },
          ].map((item) => (
            <div class="relative group">
              <div class="flex items-center gap-3 mb-4">
                <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-accent-50 dark:bg-accent-900/30 text-accent-600 dark:text-accent-400 text-xs font-bold border border-accent-200/60 dark:border-accent-800/40">
                  {item.step}
                </span>
                <div class="h-px flex-1 bg-stone-200 dark:bg-stone-800 group-hover:bg-accent-300 dark:group-hover:bg-accent-700 transition-colors"></div>
              </div>
              <h3 class="text-xl font-bold text-navy-900 dark:text-white mb-3">{item.title}</h3>
              <p class="text-sm text-stone-500 dark:text-stone-400 leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================= -->
    <!-- PHOTO BREAK                    -->
    <!-- ============================= -->
    <section class="relative h-64 sm:h-80 lg:h-96 overflow-hidden">
      <img
        src="/photo-break-workspace.jpg"
        alt="Modern workspace with natural light"
        class="absolute inset-0 w-full h-full object-cover grayscale"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-navy-950/70 to-navy-900/20 dark:from-gray-950/80 dark:to-gray-950/30"></div>
      <div class="relative z-10 h-full flex items-center">
