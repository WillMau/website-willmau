---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
  title="Home"
  description="Mau Consulting builds production AI Agents for small businesses. Customer service automation, lead qualification, document automation, and Salesforce AI integrations. Schenectady, Albany, and Capital Region."
>
  <Header />

  <main>
    <!-- ============================= -->
    <!-- HERO                           -->
    <!-- ============================= -->
    <section class="relative overflow-hidden bg-white dark:bg-gray-950">
      <!-- Warm subtle gradient background -->
      <div class="absolute inset-0 bg-gradient-to-br from-accent-50/40 via-transparent to-navy-50/30 dark:from-accent-900/10 dark:via-transparent dark:to-navy-950/20" aria-hidden="true"></div>

      <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 pt-16 sm:pt-24 pb-16 sm:pb-20">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center max-w-6xl mx-auto">
          <!-- Left column: Headline + proof -->
          <div class="text-center lg:text-left">
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-navy-900 dark:text-white mb-6 leading-[1.1]">
              AI Agents Built<br />
              <span class="text-accent-600 dark:text-accent-400">For Small Businesses.</span>
            </h1>
            <p class="text-lg sm:text-xl text-stone-600 dark:text-stone-400 leading-relaxed max-w-2xl lg:max-w-none mb-8">
              I build production AI Agents that automate the work you can't afford to hire for. One I shipped handles <span class="font-bold text-navy-900 dark:text-white">68% of customer service cases</span> end-to-end for under <span class="font-bold text-navy-900 dark:text-white">$5/month</span>. Not demos. Real systems running today.
            </p>

            <!-- Proof bar inline -->
            <div class="flex flex-wrap items-center justify-center lg:justify-start gap-x-6 gap-y-2 text-sm text-stone-500 dark:text-stone-400 mb-10">
              <span class="font-semibold text-navy-800 dark:text-white">Salesforce Certified</span>
              <span class="hidden sm:inline text-stone-300 dark:text-stone-700">|</span>
              <span>AI + Automation</span>
              <span class="hidden sm:inline text-stone-300 dark:text-stone-700">|</span>
              <span>15+ Years Operations</span>
            </div>

            <div class="flex flex-wrap gap-4 justify-center lg:justify-start">
              <Button href="/contact/?source=homepage" variant="primary" size="lg">
                Book a Free Call
              </Button>
              <Button href="#services" variant="outline" size="lg">
                See What I Do
              </Button>
            </div>
          </div>

          <!-- Right column: B&W photo -->
          <div>
            <img
              src="/hero-consulting.jpg"
              alt="Consultant working with a client on their business systems"
              class="rounded-2xl grayscale shadow-xl w-full object-cover aspect-[4/3]"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ============================= -->
    <!-- PROBLEMS                       -->
    <!-- ============================= -->
    <section id="problems" class="py-16 sm:py-20 bg-stone-50 dark:bg-gray-900">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center">
          <p class="text-sm font-semibold uppercase tracking-wide text-accent-600 dark:text-accent-400 mb-3">Sound Familiar?</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-navy-900 dark:text-white mb-10">
            Problems I solve every week
          </h2>
          <div class="flex flex-wrap justify-center gap-3">
            {[
              '\u201CSales doesn\u2019t see value in our CRM\u201D',
              '\u201CWe\u2019re stuck in copy/paste between tools\u201D',
              '\u201COur process lives in people\u2019s heads\u201D',
              '\u201COur numbers never match\u201D',
              '\u201CLeads fall through the cracks\u201D',
              '\u201CWe need a website that converts\u201D',
              '\u201CAI feels overwhelming. Where do we start?\u201D',
            ].map((problem) => (
              <span class="inline-block px-4 py-2.5 rounded-full bg-white dark:bg-stone-800 border border-stone-200 dark:border-stone-700 text-sm text-stone-600 dark:text-stone-300 shadow-sm hover:border-accent-300 dark:hover:border-accent-600 hover:shadow-md transition-all duration-200 cursor-default">
                {problem}
              </span>
            ))}
          </div>
          <p class="mt-8 text-stone-500 dark:text-stone-400">
            If any of these hit home,
            <a href="/contact/?source=homepage" class="text-accent-600 dark:text-accent-400 font-medium hover:underline underline-offset-2">let&rsquo;s talk</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================= -->
    <!-- SERVICES (detailed)            -->
    <!-- ============================= -->
    <section id="services" class="py-20 sm:py-28 bg-white dark:bg-gray-950">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-sm font-semibold uppercase tracking-wide text-accent-600 dark:text-accent-400 mb-3">What I Do</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-navy-900 dark:text-white mb-4">
          Build it. Connect it. Teach it.
        </h2>
        <p class="text-lg text-stone-500 dark:text-stone-400 mb-14 max-w-2xl">
          I don&rsquo;t just set things up and disappear. Every project includes documentation and training so your team can run it confidently without me.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {[
            {
              label: 'CRM + PIPELINE',
              title: 'Salesforce & CRM',
              desc: 'Make your CRM useful for sales: clear stages, clean data, and dashboards you trust.',
              items: ['Setup & cleanup', 'Sales stages that match reality', 'Dashboards & reporting', 'Data hygiene & permissions'],
              href: '/salesforce-consulting',
            },
            {
              label: 'AUTOMATION + INTEGRATIONS',
              title: 'Workflows & Integrations',
              desc: 'Turn chaos into a clear flow so leads, tasks, and updates move smoothly across your tools.',
              items: ['Automate handoffs (less copy/paste)', 'Connect tools using built-in integrations', 'Lightweight API connections (when needed)', 'Keep data clean and consistent'],
              href: '/automation-consulting',
            },
            {
              label: 'GROWTH + DIGITAL',
              title: 'Websites & Digital Presence',
              desc: 'A modern site that looks sharp and brings in inquiries, built to connect to how you work.',
              items: ['Website builds & refreshes', 'Forms + lead capture', 'Tracking basics (so you know what\u2019s working)', 'Easy handoff and simple edits'],
              href: '/website-design',
            },
          ].map((svc) => (
            <a href={svc.href} class="group block">
              <div class="relative h-full p-8 rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900/40 hover:border-accent-300 dark:hover:border-accent-700 hover:shadow-lg hover:shadow-accent-500/[0.06] hover:-translate-y-1 transition-all duration-300">
                <p class="text-xs font-semibold uppercase tracking-wide text-navy-400 dark:text-stone-500 mb-4">{svc.label}</p>
                <h3 class="text-xl font-bold text-navy-900 dark:text-white mb-3 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">{svc.title}</h3>
                <p class="text-sm text-stone-500 dark:text-stone-400 leading-relaxed mb-6">{svc.desc}</p>
                <ul class="space-y-2.5">
                  {svc.items.map((item: string) => (
                    <li class="flex items-center gap-2.5 text-sm text-stone-600 dark:text-stone-300">
                      <div class="w-1.5 h-1.5 rounded-full bg-accent-500 flex-shrink-0"></div>
                      {item}
                    </li>
                  ))}
                </ul>
                <div class="mt-6 text-accent-600 dark:text-accent-400 text-sm font-medium opacity-0 group-hover:opacity-100 translate-y-1 group-hover:translate-y-0 transition-all duration-200">
                  Learn more&ensp;&rarr;
                </div>
              </div>
            </a>
          ))}
        </div>

        <!-- Training callout -->
        <div class="mt-8 rounded-2xl border border-accent-200/60 dark:border-accent-800/40 bg-accent-50/50 dark:bg-accent-900/10 p-6 flex flex-col sm:flex-row items-start sm:items-center gap-4">
          <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-accent-100 dark:bg-accent-900/30 flex items-center justify-center">
            <svg class="w-5 h-5 text-accent-600 dark:text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-navy-900 dark:text-white">Every project includes training + documentation.</p>
            <p class="text-sm text-stone-500 dark:text-stone-400">Live walkthroughs, clear docs, and simple guides so your team owns the system without depending on me.</p>
          </div>
        </div>

        <!-- Advisory banner -->
        <a href="/consulting" class="group block mt-6 rounded-2xl border border-navy-200/60 dark:border-navy-800/40 bg-navy-50/50 dark:bg-navy-900/20 p-6 hover:border-accent-300 dark:hover:border-accent-700 hover:shadow-md transition-all duration-300">
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-navy-100 dark:bg-navy-900/40 flex items-center justify-center">
              <svg class="w-5 h-5 text-navy-700 dark:text-navy-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
            </div>
            <div class="flex-1">
              <p class="text-sm font-semibold text-navy-900 dark:text-white">Not ready for a full project? Book a strategy call instead.</p>
              <p class="text-sm text-stone-500 dark:text-stone-400">One-off calls, monthly office hours, and half-day deep dives for when you just need honest advice from someone in the trenches.</p>
            </div>
            <div class="hidden sm:block text-accent-600 dark:text-accent-400 text-sm font-medium opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">
              Learn more&ensp;&rarr;
            </div>
          </div>
        </a>
      </div>
    </section>

    <!-- ============================= -->
    <!-- HOW I WORK                     -->
    <!-- ============================= -->
    <section class="py-20 sm:py-28 bg-stone-50 dark:bg-gray-900">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-sm font-semibold uppercase tracking-wide text-accent-600 dark:text-accent-400 mb-3">Partner Approach</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-navy-900 dark:text-white mb-14">
          How it works
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
          {[
            {
              step: '01',
              title: 'Listen & Map',
              desc: 'Free 30-minute call. I learn how your business actually runs: your tools, your people, your pain points. No pressure, just questions.',
            },
            {
              step: '02',
              title: 'Build & Ship',
              desc: 'Clear scope, fixed timeline. I build, test, and deliver so your system runs smoothly and your team knows what to do next.',
            },
            {
              step: '03',
              title: 'Train & Support',
              desc: 'I train your team to own the system so you\u2019re not dependent on me. Then I\u2019m here if you need support as you grow. No lock-in. No surprises.',
            },
          ].map((item) => (
            <div class="relative group">
              <div class="flex items-center gap-3 mb-4">
                <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-accent-50 dark:bg-accent-900/30 text-accent-600 dark:text-accent-400 text-xs font-bold border border-accent-200/60 dark:border-accent-800/40">
                  {item.step}
                </span>
                <div class="h-px flex-1 bg-stone-200 dark:bg-stone-800 group-hover:bg-accent-300 dark:group-hover:bg-accent-700 transition-colors"></div>
              </div>
              <h3 class="text-xl font-bold text-navy-900 dark:text-white mb-3">{item.title}</h3>
              <p class="text-sm text-stone-500 dark:text-stone-400 leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================= -->
    <!-- PHOTO BREAK                    -->
    <!-- ============================= -->
    <section class="relative h-64 sm:h-80 lg:h-96 overflow-hidden">
      <img
        src="/photo-break-workspace.jpg"
        alt="Modern workspace with natural light"
        class="absolute inset-0 w-full h-full object-cover grayscale"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-navy-950/70 to-navy-900/20 dark:from-gray-950/80 dark:to-gray-950/30"></div>
      <div class="relative z-10 h-full flex items-center">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <p class="text-white text-2xl sm:text-3xl lg:text-4xl font-bold max-w-lg leading-snug">
            Less time fixing tools.<br />
            More time running your business.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================= -->
    <!-- RESULTS                        -->
    <!-- ============================= -->
    <section id="results" class="py-20 sm:py-28 bg-white dark:bg-gray-950">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-sm font-semibold uppercase tracking-wide text-accent-600 dark:text-accent-400 mb-3">Results</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-navy-900 dark:text-white mb-4">
          Real projects. Real impact.
        </h2>
        <p class="text-lg text-stone-500 dark:text-stone-400 mb-14 max-w-2xl">
          Practical changes that saved time, reduced manual work, and made systems reliable.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

          <!-- Card 1: Process Optimization -->
          <div class="rounded-2xl border border-stone-200 dark:border-stone-800 bg-stone-50/50 dark:bg-stone-900/60 p-8 hover:shadow-md transition-shadow duration-200">
            <span class="text-5xl sm:text-6xl font-bold text-accent-600 dark:text-accent-400 tabular-nums leading-none" data-countup="89" data-suffix="%">0%</span>
            <p class="text-sm font-medium text-navy-800 dark:text-white mt-3 mb-2">fewer manual steps</p>
            <p class="text-sm text-stone-500 dark:text-stone-400 leading-relaxed mb-5">Cut a 73-step process down to 8 by removing redundant handoffs and consolidating 15 spreadsheets into one workflow.</p>
            <div class="flex flex-wrap gap-2">
              <span class="text-[11px] font-medium px-2.5 py-1 rounded-md bg-accent-50 dark:bg-accent-900/30 text-accent-700 dark:text-accent-300 border border-accent-200/50 dark:border-accent-800/30">Systems & Process</span>
              <span class="text-[11px] font-medium px-2.5 py-1 rounded-md bg-accent-50 dark:bg-accent-900/30 text-accent-700 dark:text-accent-300 border border-accent-200/50 dark:border-accent-800/30">Workflows</span>
            </div>
          </div>

          <!-- Card 2: Enrollment Flow -->
          <div class="rounded-2xl border border-stone-200 dark:border-stone-800 bg-stone-50/50 dark:bg-stone-900/60 p-8 hover:shadow-md transition-shadow duration-200">
            <span class="text-5xl sm:text-6xl font-bold text-accent-600 dark:text-accent-400 tabular-nums leading-none" data-countup="15" data-suffix=" min">0 min</span>
            <p class="text-sm font-medium text-navy-800 dark:text-white mt-3 mb-2">from interest to enrolled</p>
            <p class="text-sm text-stone-500 dark:text-stone-400 leading-relaxed mb-5">Built a single online workflow with auto-enrollment so the process that used to take weeks now takes 15 minutes.</p>
            <div class="flex flex-wrap gap-2">
              <span class="text-[11px] font-medium px-2.5 py-1 rounded-md bg-accent-50 dark:bg-accent-900/30 text-accent-700 dark:text-accent-300 border border-accent-200/50 dark:border-accent-800/30">Enablement</span>
              <span class="text-[11px] font-medium px-2.5 py-1 rounded-md bg-accent-50 dark:bg-accent-900/30 text-accent-700 dark:text-accent-300 border border-accent-200/50 dark:border-accent-800/30">Training</span>
            </div>
          </div>

          <!-- Card 3: Reporting Automation -->
          <div class="rounded-2xl border border-stone-200 dark:border-stone-800 bg-stone-50/50 dark:bg-stone-900/60 p-8 hover:shadow-md transition-shadow duration-200">
            <span class="text-5xl sm:text-6xl font-bold text-accent-600 dark:text-accent-400 tabular-nums leading-none" data-countup="10" data-suffix="&times;">0&times;</span>
            <p class="text-sm font-medium text-navy-800 dark:text-white mt-3 mb-2">faster reporting</p>
            <p class="text-sm text-stone-500 dark:text-stone-400 leading-relaxed mb-5">Automated dashboards across 3 Salesforce orgs so leaders get trusted answers in minutes, not hours of spreadsheet work.</p>
            <div class="flex flex-wrap gap-2">
              <span class="text-[11px] font-medium px-2.5 py-1 rounded-md bg-accent-50 dark:bg-accent-900/30 text-accent-700 dark:text-accent-300 border border-accent-200/50 dark:border-accent-800/30">Salesforce & CRM</span>
              <span class="text-[11px] font-medium px-2.5 py-1 rounded-md bg-accent-50 dark:bg-accent-900/30 text-accent-700 dark:text-accent-300 border border-accent-200/50 dark:border-accent-800/30">Reporting</span>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ============================= -->
    <!-- ABOUT                          -->
    <!-- ============================= -->
    <section class="py-20 sm:py-28 bg-stone-50 dark:bg-gray-900">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
          <p class="text-sm font-semibold uppercase tracking-wide text-accent-600 dark:text-accent-400 mb-3">About</p>
          <div class="flex flex-col md:flex-row gap-10 items-start">
            <div class="flex-shrink-0">
              <img
                src="/william-mau-headshot.jpg"
                alt="William Mau"
                class="w-48 h-48 rounded-2xl grayscale object-cover shadow-lg"
                loading="lazy"
              />
            </div>
            <div>
              <h2 class="text-3xl sm:text-4xl font-bold text-navy-900 dark:text-white mb-6">
                Hey, I&rsquo;m Will.
              </h2>
              <div class="space-y-4 text-stone-600 dark:text-stone-400 leading-relaxed">
                <p>
                  I&rsquo;ve spent 15+ years in revenue operations, enablement, and business technology, most of it at
                  <a href="https://www.talentsmarteq.com" target="_blank" rel="noopener noreferrer" class="text-navy-800 dark:text-white font-semibold hover:text-accent-600 dark:hover:text-accent-400 underline underline-offset-2 transition-colors">TalentSmartEQ</a>,
                  where I run the technical side of a global training organization. I help small businesses get real value out of Salesforce, automation, and reporting.
                </p>
                <p>
                  I&rsquo;m not an agency. You work directly with me. I listen, map how your business really works, and build practical improvements you can own. Every project includes documentation and training so your team can run the system long after I&rsquo;m done.
                </p>
              </div>
              <div class="mt-8">
                <Button href="/resume" variant="outline" size="md">
                  View Full Resume&ensp;&rarr;
                </Button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================= -->
    <!-- FAQ                            -->
    <!-- ============================= -->
    <section class="py-20 sm:py-28 bg-white dark:bg-gray-950">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
          <p class="text-sm font-semibold uppercase tracking-wide text-accent-600 dark:text-accent-400 mb-3">FAQ</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-navy-900 dark:text-white mb-12">
            Common questions
          </h2>
          <div class="space-y-3">
            {[
              {
                q: 'How much does this cost?',
                a: 'Most projects fall between $2K and $15K, depending on scope. After a 30-minute call, I\u2019ll send a clear plan and a fixed quote. No surprises.',
              },
              {
                q: 'Do you work with businesses outside New York?',
                a: 'Yes. Most of my work is remote, and I\u2019ve supported teams across the U.S. and internationally.',
              },
              {
                q: 'We have Salesforce, but people don\u2019t use it. Can you fix that?',
                a: 'Yes. I\u2019ll audit what you have, clean up the data, simplify the workflow, and rebuild the parts that slow your team down. The goal is to make Salesforce a tool your team actually wants to use.',
              },
              {
                q: 'What happens after the project is done?',
                a: 'Every project includes documentation and training so your team can own the system. If you want ongoing support, I also offer office hours.',
              },
              {
                q: 'How long does a typical project take?',
                a: 'Most projects take 2 to 6 weeks depending on scope. After our call, you\u2019ll get a simple timeline with clear milestones.',
              },
              {
                q: 'What if I just need advice, not a full project?',
                a: 'That works too. I offer paid advisory sessions for quick answers, planning, or a second opinion. No long engagement required.',
              },
              {
                q: 'Do you work with small teams or non-technical owners?',
                a: 'Yes. I translate technical work into plain language and build systems your team can actually run day to day.',
              },
            ].map((faq) => (
              <details class="group rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900/60 overflow-hidden">
                <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-navy-900 dark:text-white font-medium hover:bg-stone-50/50 dark:hover:bg-stone-800/30 transition-colors list-none [&::-webkit-details-marker]:hidden">
                  <span>{faq.q}</span>
                  <svg class="w-5 h-5 text-stone-400 group-open:rotate-180 transition-transform duration-200 flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <div class="px-6 pb-5 text-sm text-stone-500 dark:text-stone-400 leading-relaxed">
                  {faq.a}
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============================= -->
    <!-- FOOTER CTA                     -->
    <!-- ============================= -->
    <section class="py-20 sm:py-28 bg-navy-900 dark:bg-navy-950">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mx-auto text-center">
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
            Ready to make your systems run smoother?
          </h2>
          <p class="text-lg text-navy-200 mb-10">
            30-minute free call. No pitch. Just a quick look at what&rsquo;s not working and a clear plan for what to do next.
          </p>
          <div class="flex flex-wrap gap-4 justify-center">
            <Button href="/contact/?source=homepage" variant="primary" size="lg">
              Book a Free Call
            </Button>
            <a href="#results" class="group relative inline-flex items-center justify-center font-medium rounded-lg transition-all focus:outline-none focus:ring-2 focus:ring-offset-2 overflow-hidden px-8 py-4 text-lg border-2 border-white/30 text-white hover:bg-white/10 hover:scale-105 active:scale-95">
              <span class="relative z-10">See Example Results</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    function animateCountUp(el: HTMLElement) {
      const target = parseInt(el.dataset.countup || '0', 10);
      const suffix = el.dataset.suffix || '';
      const duration = 1600;
      const steps = 40;
      const stepTime = duration / steps;
      let current = 0;
      const increment = target / steps;

      const timer = setInterval(() => {
        current += increment;
        if (current >= target) {
          current = target;
          clearInterval(timer);
        }
        el.textContent = Math.round(current) + suffix;
      }, stepTime);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            animateCountUp(el);
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.5 }
    );

    document.querySelectorAll<HTMLElement>('[data-countup]').forEach((el) => {
      observer.observe(el);
    });
  </script>
</BaseLayout>
