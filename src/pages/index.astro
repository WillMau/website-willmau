---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
  title="Home"
  description="Mau Consulting — Business technology consulting for small businesses. Salesforce, automation, websites, and AI integration. Your technical partner for growth."
>
  <Header />

  <main>
    <!-- ============================= -->
    <!-- A · HERO                       -->
    <!-- ============================= -->
    <section class="relative overflow-hidden min-h-[90vh] flex items-center bg-white dark:bg-gray-950">
      <!-- Blueprint grid overlay -->
      <div class="absolute inset-0 opacity-[0.04] dark:opacity-[0.06]" style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M60 0H0v60' fill='none' stroke='%2310B981' stroke-width='.5'/%3E%3C/svg%3E&quot;); background-size: 60px 60px;"></div>

      <!-- Mint glow blob -->
      <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-accent-400/15 dark:bg-accent-500/10 rounded-full blur-[120px] pointer-events-none"></div>

      <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-3xl mx-auto text-center">
          <p class="font-mono text-xs tracking-widest uppercase text-accent-600 dark:text-accent-400 mb-6 animate-fade-in-up">
            Systems&ensp;·&ensp;Automation&ensp;·&ensp;Growth
          </p>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 dark:text-white mb-6 animate-delay-100">
            Technology that works<br />
            <span class="text-accent-600 dark:text-accent-400">as hard as you do.</span>
          </h1>

          <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-400 mb-10 max-w-2xl mx-auto leading-relaxed animate-delay-200">
            I help small businesses untangle their tech, automate the busywork,
            and build systems that actually scale — so you can focus on
            running the business.
          </p>

          <div class="flex flex-wrap gap-4 justify-center animate-delay-300">
            <Button href="/contact" variant="primary" size="lg">
              Book a Free Call
            </Button>
            <Button href="#services" variant="outline" size="lg">
              See How I Help
            </Button>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================= -->
    <!-- B · TRUST STRIP                -->
    <!-- ============================= -->
    <div class="border-y border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-5">
        <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-slate-500 dark:text-slate-400">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-accent-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
            Salesforce Certified Administrator
          </span>
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-accent-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
            10+ Years in Revenue Operations
          </span>
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-accent-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
            Based in New York
          </span>
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-accent-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
            Free 30-Min Consultation
          </span>
        </div>
      </div>
    </div>

    <!-- ============================= -->
    <!-- C · SERVICES (3 Buckets)       -->
    <!-- ============================= -->
    <section id="services" class="py-20 sm:py-28 bg-white dark:bg-gray-950">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <p class="font-mono text-xs tracking-widest uppercase text-accent-600 dark:text-accent-400 mb-3">Services</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-4">
          Three ways I help
        </h2>
        <p class="text-lg text-slate-500 dark:text-slate-400 mb-14 max-w-2xl">
          Every engagement starts with understanding your business — then building the right solution, not the most complicated one.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {[
            {
              label: 'REVENUE + OPS',
              title: 'Salesforce & RevOps',
              desc: 'CRM setup, pipeline optimization, dashboards, and reporting that actually tells you something useful. Certified Salesforce Admin.',
              items: ['CRM Implementation', 'Pipeline Optimization', 'Custom Dashboards', 'Data Migration'],
              href: '/salesforce-consulting',
              color: 'accent',
            },
            {
              label: 'AUTOMATION + INTEGRATIONS',
              title: 'Automation & Integrations',
              desc: 'Connect your tools, eliminate manual work, and build workflows that run themselves. Zapier, Power Automate, custom APIs.',
              items: ['Workflow Automation', 'App Integrations', 'API Development', 'Process Design'],
              href: '/automation-consulting',
              color: 'blue',
            },
            {
              label: 'GROWTH + DIGITAL',
              title: 'Websites, AI & Tech Strategy',
              desc: 'Modern websites, AI-powered tools, and tech strategy for businesses ready to level up. No bloated enterprise nonsense.',
              items: ['Web Development', 'AI Integration', 'Tech Stack Audits', 'Digital Strategy'],
              href: '/website-design',
              color: 'purple',
            },
          ].map((svc) => (
            <a href={svc.href} class="group block">
              <div class="relative h-full p-8 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 hover:border-accent-300 dark:hover:border-accent-700 hover:shadow-xl hover:shadow-accent-500/5 hover:-translate-y-1 transition-all duration-300">
                <p class="font-mono text-[10px] tracking-widest uppercase text-slate-400 dark:text-slate-500 mb-4">{svc.label}</p>
                <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">{svc.title}</h3>
                <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed mb-6">{svc.desc}</p>
                <ul class="space-y-2">
                  {svc.items.map((item: string) => (
                    <li class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-300">
                      <div class="w-1.5 h-1.5 rounded-full bg-accent-500 flex-shrink-0"></div>
                      {item}
                    </li>
                  ))}
                </ul>
                <div class="mt-6 text-accent-600 dark:text-accent-400 text-sm font-medium opacity-0 group-hover:opacity-100 translate-y-1 group-hover:translate-y-0 transition-all">
                  Learn more →
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================= -->
    <!-- D · COMMON PROBLEMS            -->
    <!-- ============================= -->
    <section class="py-20 sm:py-28 bg-slate-50 dark:bg-gray-900">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center">
          <p class="font-mono text-xs tracking-widest uppercase text-accent-600 dark:text-accent-400 mb-3">Sound Familiar?</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-12">
            Problems I solve every week
          </h2>

          <div class="flex flex-wrap justify-center gap-3">
            {[
              '"Our CRM is a mess"',
              '"We\'re drowning in manual data entry"',
              '"I don\'t trust our reports"',
              '"Our tools don\'t talk to each other"',
              '"We need a website that actually converts"',
              '"I know AI can help but don\'t know where to start"',
              '"We outgrew our spreadsheets"',
              '"Our sales process is all over the place"',
            ].map((problem) => (
              <span class="inline-block px-4 py-2.5 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm text-slate-600 dark:text-slate-300 shadow-sm hover:border-accent-300 dark:hover:border-accent-600 hover:shadow-md transition-all cursor-default">
                {problem}
              </span>
            ))}
          </div>

          <p class="mt-10 text-slate-500 dark:text-slate-400">
            If any of these hit home,
            <a href="/contact" class="text-accent-600 dark:text-accent-400 font-medium hover:underline">let's talk</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================= -->
    <!-- E · HOW I WORK (3 Steps)       -->
    <!-- ============================= -->
    <section class="py-20 sm:py-28 bg-white dark:bg-gray-950">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <p class="font-mono text-xs tracking-widest uppercase text-accent-600 dark:text-accent-400 mb-3">Partner Approach</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-14">
          How it works
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            {
              step: '01',
              title: 'Listen & Map',
              desc: 'Free 30-minute call. I learn how your business actually runs — the tools, the people, the pain points. No pitch, just questions.',
            },
            {
              step: '02',
              title: 'Build & Ship',
              desc: 'Clear scope, fixed timeline. I build the solution, test it, and hand it off with documentation you can actually follow.',
            },
            {
              step: '03',
              title: 'Support & Scale',
              desc: 'Ongoing support when you need it. As your business grows, your systems grow with it. No lock-in, no retainer games.',
            },
          ].map((item) => (
            <div class="relative pl-8 border-l-2 border-slate-200 dark:border-slate-800 hover:border-accent-400 dark:hover:border-accent-500 transition-colors">
              <span class="font-mono text-xs text-accent-500 dark:text-accent-400 font-bold">{item.step}</span>
              <h3 class="text-xl font-bold text-slate-900 dark:text-white mt-2 mb-3">{item.title}</h3>
              <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================= -->
    <!-- F · CASE STUDIES (3 Cards)     -->
    <!-- ============================= -->
    <section class="py-20 sm:py-28 bg-slate-50 dark:bg-gray-900">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <p class="font-mono text-xs tracking-widest uppercase text-accent-600 dark:text-accent-400 mb-3">Results</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-14">
          Real projects, real impact
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {[
            {
              metric: '87%',
              metricLabel: 'fewer bottlenecks',
              title: 'Sales Pipeline Overhaul',
              desc: 'Rebuilt a 200-person org\'s Salesforce instance from scratch — custom objects, automated lead routing, and dashboards that replaced 15 spreadsheets.',
              tags: ['Salesforce', 'RevOps'],
            },
            {
              metric: '10×',
              metricLabel: 'faster reporting',
              title: 'Reporting Automation',
              desc: 'Replaced manual weekly reports with automated Salesforce dashboards and Slack alerts. What took 4 hours now takes zero.',
              tags: ['Automation', 'Salesforce'],
            },
            {
              metric: '3 weeks',
              metricLabel: 'to full launch',
              title: 'Website + CRM Integration',
              desc: 'Designed and shipped a marketing site with built-in lead capture flowing directly into Salesforce. SEO-optimized, sub-2s load times.',
              tags: ['Web Dev', 'Integration'],
            },
          ].map((study) => (
            <div class="p-8 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60">
              <div class="mb-6">
                <span class="text-4xl font-bold text-accent-600 dark:text-accent-400">{study.metric}</span>
                <span class="block text-sm text-slate-500 dark:text-slate-400 mt-1">{study.metricLabel}</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">{study.title}</h3>
              <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed mb-4">{study.desc}</p>
              <div class="flex flex-wrap gap-2">
                {study.tags.map((tag: string) => (
                  <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-accent-50 dark:bg-accent-900/30 text-accent-700 dark:text-accent-300">{tag}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================= -->
    <!-- G · TOOLBOX STRIP              -->
    <!-- ============================= -->
    <section class="py-16 bg-white dark:bg-gray-950 border-y border-slate-100 dark:border-slate-800">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <p class="font-mono text-xs tracking-widest uppercase text-accent-600 dark:text-accent-400 mb-6 text-center">Toolbox</p>
        <div class="flex flex-wrap justify-center gap-3">
          {[
            'Salesforce', 'Pardot', 'HubSpot', 'Zapier', 'Power Automate',
            'Astro', 'React', 'Tailwind CSS', 'Node.js', 'PostgreSQL',
            'OpenAI API', 'Claude API', 'Vercel', 'GitHub', 'Figma',
          ].map((tool) => (
            <span class="px-4 py-2 rounded-lg bg-slate-100 dark:bg-slate-800 text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-accent-50 dark:hover:bg-accent-900/30 hover:text-accent-700 dark:hover:text-accent-300 transition-colors cursor-default">
              {tool}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================= -->
    <!-- H · ABOUT                      -->
    <!-- ============================= -->
    <section class="py-20 sm:py-28 bg-white dark:bg-gray-950">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
          <p class="font-mono text-xs tracking-widest uppercase text-accent-600 dark:text-accent-400 mb-3">About</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-6">
            Hey, I'm Will.
          </h2>
          <div class="space-y-4 text-slate-600 dark:text-slate-400 leading-relaxed">
            <p>
              I've spent 10+ years in revenue operations, sales enablement, and
              business technology — most of it at
              <strong class="text-slate-900 dark:text-white">TalentSmartEQ</strong>,
              where I run the technical side of a global training and consulting company.
            </p>
            <p>
              I started Mau Consulting because I kept meeting small business
              owners who were stuck: paying too much for software they didn't
              fully use, buried in manual processes, or getting bad advice from
              agencies that didn't understand their business.
            </p>
            <p>
              I'm not an agency. I'm one person who knows this stuff inside and
              out. When you work with me, you get direct access — no account
              managers, no junior devs, no runaround.
            </p>
          </div>
          <div class="mt-8">
            <Button href="/resume" variant="outline" size="md">
              View Full Resume →
            </Button>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================= -->
    <!-- I · FAQ ACCORDION              -->
    <!-- ============================= -->
    <section class="py-20 sm:py-28 bg-slate-50 dark:bg-gray-900">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
          <p class="font-mono text-xs tracking-widest uppercase text-accent-600 dark:text-accent-400 mb-3">FAQ</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-12">
            Common questions
          </h2>

          <div class="space-y-4" id="faq-list">
            {[
              {
                q: 'How much does this cost?',
                a: 'It depends on scope. Most projects range from $2K–$15K. I\'ll give you a clear quote after our first call — no surprises.',
              },
              {
                q: 'Do you work with businesses outside New York?',
                a: 'Yes. Most of my work is remote. I\'ve worked with teams across the US and internationally.',
              },
              {
                q: 'I already have Salesforce but it\'s a mess. Can you fix it?',
                a: 'That\'s literally my favorite kind of project. I\'ll audit what you have, clean up the data, and rebuild it so it actually works for your team.',
              },
              {
                q: 'How long does a typical project take?',
                a: 'Small automations: 1–2 weeks. CRM overhauls: 4–8 weeks. Websites: 2–4 weeks. I\'ll always give you a timeline upfront.',
              },
              {
                q: 'What if I just need advice, not a full project?',
                a: 'That\'s what the free consultation is for. And if you need ongoing advisory, I offer flexible hourly support.',
              },
            ].map((faq) => (
              <details class="group rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 overflow-hidden">
                <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-slate-900 dark:text-white font-medium hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                  {faq.q}
                  <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <div class="px-6 pb-5 text-sm text-slate-500 dark:text-slate-400 leading-relaxed">
                  {faq.a}
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============================= -->
    <!-- J · FOOTER CTA                 -->
    <!-- ============================= -->
    <section class="relative py-20 sm:py-28 bg-white dark:bg-gray-950 overflow-hidden">
      <!-- Mint glow -->
      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[500px] h-[300px] bg-accent-400/10 dark:bg-accent-500/5 rounded-full blur-[100px] pointer-events-none"></div>

      <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-2xl mx-auto text-center">
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-4">
            Ready to fix your tech?
          </h2>
          <p class="text-lg text-slate-500 dark:text-slate-400 mb-10">
            30-minute free call. No pitch — just a conversation about what's
            not working and how to make it better.
          </p>

          <div class="flex flex-wrap gap-4 justify-center">
            <Button href="/contact" variant="primary" size="lg">
              Book a Free Call
            </Button>
            <Button href="/work" variant="outline" size="lg">
              View My Work
            </Button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
