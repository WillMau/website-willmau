---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Terms of Use';
const description = 'The simple terms for using the Mau Consulting website, its free tools, and its guides. Plain language, no fine-print surprises.';
const updated = 'August 17, 2026';
---

<BaseLayout title={title} description={description} pageLabel="Terms">
  <Header />

  <main>
    <article class="bg-white dark:bg-gray-950">
      <!-- Header -->
      <div class="bg-gradient-to-b from-stone-50 to-white dark:from-gray-900 dark:to-gray-950">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 pt-16 sm:pt-24 pb-8">
          <div class="max-w-3xl mx-auto">
            <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-navy-900 dark:text-white mb-4 leading-[1.1]">
              Terms of Use
            </h1>
            <p class="text-lg text-stone-500 dark:text-stone-400">Last updated: {updated}</p>
          </div>
        </div>
      </div>

      <!-- Body -->
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24">
        <div class="max-w-3xl mx-auto text-lg text-stone-700 dark:text-stone-300 leading-relaxed space-y-6">

          <p>
            These are the terms for using this website, mauops.com, operated by Mau Consulting (&ldquo;I,&rdquo; &ldquo;me,&rdquo; or &ldquo;this site&rdquo;). By using the site, its free tools, or its guides, you agree to these terms. If you do not agree, please do not use the site. I have kept this plain and short on purpose.
          </p>

          <h2 class="text-2xl sm:text-3xl font-bold text-navy-900 dark:text-white pt-6">Using this website</h2>
          <p>
            You are welcome to browse the site, read the guides, and use the free tools for your own personal or business use. Please do not misuse the site: do not try to break it, overload it, use it for anything unlawful, or copy its content to pass off as your own.
          </p>

          <h2 class="text-2xl sm:text-3xl font-bold text-navy-900 dark:text-white pt-6">Free tools</h2>
          <p>
            Tools on this site, such as the <a href="/tools/image-converter/" class="text-accent-600 dark:text-accent-400 font-medium hover:underline underline-offset-2">image converter</a>, are provided free and as a convenience. They run inside your own browser, so your files stay with you. Because they run on your device and I never see your files, <strong class="text-navy-900 dark:text-white">you are responsible for your own files and for keeping your own backups.</strong> The tools are provided &ldquo;as is,&rdquo; and while I want them to work well for everyone, I cannot guarantee they will work perfectly with every file or on every device.
          </p>

          <h2 class="text-2xl sm:text-3xl font-bold text-navy-900 dark:text-white pt-6">Guides and information</h2>
          <p>
            The guides and articles on this site are shared to be genuinely helpful, but they are general information, not formal legal, financial, or professional advice for your specific situation. Every business is different. Results are not guaranteed, and you should use your own judgment or consult a professional before making important decisions.
          </p>

          <h2 class="text-2xl sm:text-3xl font-bold text-navy-900 dark:text-white pt-6">Paid work is separate</h2>
          <p>
            These terms cover the website only. If you hire me for a project, that work is governed by a separate written agreement or proposal we both accept. Nothing on this site is a binding offer of services, a quote, or a contract on its own.
          </p>

          <h2 class="text-2xl sm:text-3xl font-bold text-navy-900 dark:text-white pt-6">Intellectual property</h2>
          <p>
            The design, text, logo, and content of this site belong to Mau Consulting unless noted otherwise. You are welcome to link to the site and to share the guides. Please do not copy, republish, or resell the content or branding as your own without permission.
          </p>

          <h2 class="text-2xl sm:text-3xl font-bold text-navy-900 dark:text-white pt-6">Links to other sites</h2>
          <p>
            This site may link to other websites for your convenience. I do not control those sites and am not responsible for their content or their practices.
          </p>

          <h2 class="text-2xl sm:text-3xl font-bold text-navy-900 dark:text-white pt-6">No warranties</h2>
          <p>
            This website and its tools are provided &ldquo;as is&rdquo; and &ldquo;as available,&rdquo; without warranties of any kind, whether express or implied. I do not promise the site will always be available, error free, or fit for a particular purpose.
          </p>

          <h2 class="text-2xl sm:text-3xl font-bold text-navy-900 dark:text-white pt-6">Limitation of liability</h2>
          <p>
            To the fullest extent allowed by law, Mau Consulting is not liable for any loss or damage arising from your use of this website, its tools, or its guides, including any lost data or files. You use the site and its tools at your own risk.
          </p>

          <h2 class="text-2xl sm:text-3xl font-bold text-navy-900 dark:text-white pt-6">Changes to these terms</h2>
          <p>
            I may update these terms from time to time. When I do, I will change the date at the top. Continuing to use the site after a change means you accept the updated terms.
          </p>

          <h2 class="text-2xl sm:text-3xl font-bold text-navy-900 dark:text-white pt-6">Governing law</h2>
          <p>
            These terms are governed by the laws of the State of New York, United States, without regard to its conflict of law rules.
          </p>

          <h2 class="text-2xl sm:text-3xl font-bold text-navy-900 dark:text-white pt-6">Contact</h2>
          <p>
            Questions about these terms? Email me at
            <a id="terms-email" href="#" class="text-accent-600 dark:text-accent-400 font-medium hover:underline underline-offset-2"><span id="terms-email-text">the address below</span></a>.
            You can also read how your information is handled in the
            <a href="/privacy/" class="text-accent-600 dark:text-accent-400 font-medium hover:underline underline-offset-2">Privacy Policy</a>.
          </p>

        </div>
      </div>
    </article>
  </main>

  <Footer />

  <script>
    // Assemble email in the browser to reduce scraping
    const _u = 'will';
    const _d = 'mauops.com';
    const _e = `${_u}@${_d}`;
    const link = document.getElementById('terms-email') as HTMLAnchorElement | null;
    const text = document.getElementById('terms-email-text');
    if (link) link.href = `mailto:${_e}`;
    if (text) text.textContent = _e;
  </script>
</BaseLayout>
