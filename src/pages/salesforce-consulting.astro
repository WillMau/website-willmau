---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';



const services = [
  {
    title: 'CRM Setup & Configuration',
    description: 'Clean Salesforce setup tailored to your sales process, including custom objects, fields, page layouts, and validation rules that match how your team actually works.',
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'
  },
  {
    title: 'Pipeline & Revenue Operations',
    description: 'Align sales, marketing, and customer success with unified lifecycle stages, lead routing, and dashboards that tell the truth about your pipeline.',
    icon: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6'
  },
  {
    title: 'Automation & Flows',
    description: 'Replace broken workflows with reliable automation, including Flows, approval processes, email alerts, and AI-assisted lead scoring that keep deals moving.',
    icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z'
  },
  {
    title: 'Reporting & Dashboards',
    description: 'Executive-ready reports and real-time dashboards that track what actually matters: pipeline velocity, conversion rates, and revenue forecasts.',
    icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z'
  },
  {
    title: 'Pardot / Account Engagement',
    description: 'Lead scoring, email campaigns, drip nurture sequences, and marketing-to-sales handoff automation that closes the loop between marketing spend and revenue.',
    icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'
  },
  {
    title: 'Data Cleanup & Migration',
    description: 'Clean imports, deduplication, field mapping, and ongoing data hygiene. I also set up AI-powered duplicate detection and enrichment workflows.',
    icon: 'M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4'
  }
];

const packages = [
  {
    name: 'Health Check',
    price: '$3,500',
    duration: 'Delivered in ~2 weeks',
    description: 'Productized audit of your current Salesforce setup. About 15–25 hours of my time across two calendar weeks. You get a prioritized roadmap and a 60-minute findings call.',
    features: [
      'Data quality assessment',
      'Automation & flow review',
      'User workflow analysis',
      'Security & permissions audit',
      'AI opportunity identification',
      'Detailed improvement roadmap',
      '60-minute findings presentation'
    ]
  },
  {
    name: 'Implementation Project',
    price: 'Starting at $7,500',
    duration: '2–6 weeks',
    description: 'Build or fix a specific Salesforce capability. Final pricing depends on scope and complexity, locked in after a free scoping call.',
    features: [
      'Custom object & field setup',
      'Process automation (Flows, approvals)',
      'Report & dashboard creation',
      'Integration setup',
      'AI-assisted workflows where applicable',
      'Team training & documentation',
      'Post-launch support (2 weeks)'
    ]
  },
  {
    name: 'Ongoing Partner',
    price: 'From $2,500/month',
    duration: 'Monthly retainer',
    description: 'Continuous Salesforce support, optimization, and team enablement. Typically 5–10 hours per month. Cancel anytime.',
    features: [
      'Priority support (24–48hr response)',
      'Monthly optimization reviews',
      'Ongoing automation improvements',
      'New feature implementation',
      'Team training & enablement sessions',
      'Documentation kept up to date',
      'Strategic planning sessions'
    ]
  }
];

const faqs = [
  {
    question: 'Do you work with Salesforce Classic or Lightning?',
    answer: 'Primarily Lightning Experience, which is Salesforce\'s modern interface. If you\'re still on Classic, I can help you plan and execute a migration.'
  },
  {
    question: 'Can you help with custom development (Apex/Visualforce)?',
    answer: 'Yes. I build Lightning Web Components (LWC) for custom UI, and handle all declarative work: Flows, formulas, validation rules, and configuration. For complex Apex back-end logic, I can recommend trusted developers and manage the project.'
  },
  {
    question: 'What size companies do you work with?',
    answer: 'Primarily small to mid-size businesses (10–200 employees) who need expert Salesforce help without hiring a full-time admin.'
  },
  {
    question: 'How do you use AI in Salesforce projects?',
    answer: 'I integrate AI where it adds real value: lead scoring, duplicate detection, data enrichment, and smart automation triggers. No gimmicks, just practical time savings.'
  },
  {
    question: 'Do you provide training after a project?',
    answer: 'Every project includes documentation and hands-on training for your team. The goal is for your people to run the system confidently without me.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
});
---

<BaseLayout
  title="Salesforce & Revenue Systems for Small Businesses | Schenectady, NY"
  description="Certified Salesforce Administrator who builds the revenue systems your team actually uses. CRM setup, pipeline dashboards, lead routing, AI-powered automation, and executive reporting for small businesses in the Capital Region and nationwide."
  pageLabel="Salesforce & Revenue Systems"
>
  <Header />
  <script type="application/ld+json" set:html={faqSchema} />

  <main>
  <!-- Hero Section -->
  <section class="relative overflow-hidden py-16 sm:py-24 bg-white dark:bg-gray-950">
    <div class="absolute inset-0 bg-gradient-to-br from-salesforce-50/60 via-transparent to-navy-50/30 dark:from-salesforce-700/10 dark:via-transparent dark:to-navy-950/20" aria-hidden="true"></div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <!-- Trailblazer Credentials -->
        <a href="https://www.salesforce.com/trailblazer/wmau" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-6 mb-8 animate-fade-in-up group">
          <img
            src="/salesforce-admin-badge.png"
            alt="Salesforce Certified Administrator"
            class="w-24 h-24 sm:w-28 sm:h-28 drop-shadow-xl group-hover:scale-105 transition-transform duration-300"
          />
          <div class="text-left">
            <div class="flex flex-wrap gap-2 mb-2">
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-salesforce-500/20 dark:bg-salesforce-400/10 text-salesforce-700 dark:text-salesforce-300 border border-salesforce-500/30">
                <svg class="w-3.5 h-3.5 mr-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                Certified Administrator
              </span>
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-salesforce-500/20 dark:bg-salesforce-400/10 text-salesforce-700 dark:text-salesforce-300 border border-salesforce-500/30">
                <svg class="w-3.5 h-3.5 mr-1" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                Ranger Rank
              </span>
            </div>
            <span class="text-xs text-stone-500 dark:text-stone-400 group-hover:text-salesforce-500 dark:group-hover:text-salesforce-400 transition-colors">
              View Trailblazer Profile &rarr;
            </span>
          </div>
        </a>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-navy-900 dark:text-white mb-6 animate-delay-200">
          Salesforce &amp; Revenue Systems<br />Your Team Will Actually Use
        </h1>

        <p class="text-xl sm:text-2xl text-stone-600 dark:text-stone-300 mb-8 animate-delay-300">
          Clean CRM setup, lead routing that works, pipeline dashboards owners trust, and AI-powered automation where it earns its keep. Including production agents that auto-handle <span class="font-bold text-accent-600 dark:text-accent-400">68% of cases</span> for under <span class="font-bold text-accent-600 dark:text-accent-400">$5/month</span>.
        </p>

        <div class="flex flex-wrap gap-4 justify-center" style="animation: fade-in-up 0.6s ease-out 0.4s both;">
          <Button href="/contact/?service=salesforce&source=salesforce-consulting" variant="primary" size="lg">
            Request Salesforce Audit
          </Button>
          <Button href="#services" variant="outline" size="lg">
            See What's Included
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- What I Work With -->
  <Section class="bg-salesforce-50/50 dark:bg-salesforce-700/10">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-4 text-navy-900 dark:text-white">
        What I Work With
      </h2>
      <p class="text-center text-stone-600 dark:text-stone-300 mb-12 max-w-2xl mx-auto">
        Deep platform experience across the Salesforce ecosystem. These are the tools and features I build with every day.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Build & Configure -->
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wide text-salesforce-500 dark:text-salesforce-400 mb-4 flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            Build & Configure
          </h3>
          <div class="space-y-2">
            {['Custom Objects & Fields', 'Page Layouts & Record Types', 'Lightning Web Components (LWC)', 'Validation Rules & Formulas'].map(item => (
              <div class="flex items-center gap-2 px-3 py-2 bg-white dark:bg-stone-900/60 rounded-lg border border-salesforce-200/60 dark:border-salesforce-700/30">
                <div class="w-1.5 h-1.5 rounded-full bg-salesforce-400 flex-shrink-0"></div>
                <span class="text-sm text-navy-900 dark:text-stone-200">{item}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Automate & Optimize -->
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wide text-salesforce-500 dark:text-salesforce-400 mb-4 flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            Automate & Optimize
          </h3>
          <div class="space-y-2">
            {['Flows & Process Automation', 'Approval Processes', 'Scheduled Jobs & Triggers', 'AI-Powered Lead Scoring'].map(item => (
              <div class="flex items-center gap-2 px-3 py-2 bg-white dark:bg-stone-900/60 rounded-lg border border-salesforce-200/60 dark:border-salesforce-700/30">
                <div class="w-1.5 h-1.5 rounded-full bg-salesforce-400 flex-shrink-0"></div>
                <span class="text-sm text-navy-900 dark:text-stone-200">{item}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Analyze & Report -->
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wide text-salesforce-500 dark:text-salesforce-400 mb-4 flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            Analyze & Report
          </h3>
          <div class="space-y-2">
            {['Reports & Dashboards', 'Pipeline Analytics', 'Data Hygiene & Deduplication', 'Forecast Modeling'].map(item => (
              <div class="flex items-center gap-2 px-3 py-2 bg-white dark:bg-stone-900/60 rounded-lg border border-salesforce-200/60 dark:border-salesforce-700/30">
                <div class="w-1.5 h-1.5 rounded-full bg-salesforce-400 flex-shrink-0"></div>
                <span class="text-sm text-navy-900 dark:text-stone-200">{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- What's Included -->
  <Section id="services" title="What I Do" subtitle="Salesforce services tailored to your business, with AI and training built in">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((service) => (
        <Card shimmer={true}>
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-salesforce-500 to-salesforce-600 rounded-xl flex items-center justify-center text-white shadow-lg">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={service.icon} />
              </svg>
            </div>
            <div class="flex-1">
              <h3 class="text-lg font-semibold text-navy-900 dark:text-white mb-2">
                {service.title}
              </h3>
              <p class="text-stone-600 dark:text-stone-400 text-sm">
                {service.description}
              </p>
            </div>
          </div>
        </Card>
      ))}
    </div>
  </Section>

  <!-- Every Project Includes -->
  <Section class="bg-accent-50/50 dark:bg-accent-950/20" title="Every Project Includes">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
      {[
        { title: 'Documentation', desc: 'Step-by-step guides, process maps, and reference docs your team can actually follow.', icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' },
        { title: 'Hands-On Training', desc: 'Live walkthroughs and recorded sessions so your team knows exactly how to use what I build.', icon: 'M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z' },
        { title: 'AI Where It Helps', desc: 'Smart automation, lead scoring, and data enrichment. Practical AI that saves real time.', icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z' }
      ].map(item => (
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-14 h-14 bg-salesforce-100 dark:bg-salesforce-700/30 text-salesforce-500 dark:text-salesforce-400 rounded-2xl mb-4">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-navy-900 dark:text-white mb-2">{item.title}</h3>
          <p class="text-sm text-stone-600 dark:text-stone-400">{item.desc}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- What I've Built -->
  <Section title="What I've Built" subtitle="Production Salesforce and AI systems running today, not slide decks.">
    <div class="max-w-6xl mx-auto">

      <!-- FEATURED: AI Service Agent -->
      <div class="relative mb-8 rounded-2xl overflow-hidden border-2 border-accent-500/40 dark:border-accent-400/40 shadow-2xl">
        <!-- Gradient background -->
        <div class="absolute inset-0 bg-gradient-to-br from-navy-900 via-navy-900 to-accent-900"></div>
        <!-- Decorative pattern -->
        <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 50%, white 1px, transparent 1px), radial-gradient(circle at 80% 50%, white 1px, transparent 1px); background-size: 40px 40px;"></div>

        <div class="relative grid grid-cols-1 lg:grid-cols-5 gap-8 p-8 sm:p-10 lg:p-12">
          <!-- Left: Description -->
          <div class="lg:col-span-3">
            <div class="flex items-center gap-3 mb-4">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-accent-500 text-white shadow-lg">
                <span class="relative flex h-2 w-2 mr-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-white"></span>
                </span>
                Featured Build
              </span>
              <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold bg-white/10 text-white border border-white/20">AI Customer Service Agent</span>
            </div>

            <h3 class="text-3xl sm:text-4xl font-bold text-white mb-4 leading-tight">
              An AI Agent That Replaces a Customer Service Rep
            </h3>

            <p class="text-lg text-stone-200 mb-6 leading-relaxed">
              I built a production AI Customer Service Agent inside Salesforce that classifies, responds to, and resolves inbound cases autonomously. It uses GPT-4o for vision (reading receipts, validating images), GPT-4o-mini for classification, and writes responses from approved templates. Phased rollout means the team sees and trusts the work before the agent goes autonomous.
            </p>

            <div class="grid grid-cols-2 gap-3 mb-6">
              <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-lg p-4">
                <div class="text-xs uppercase tracking-wide text-stone-300 mb-1">Cases Handled</div>
                <div class="text-lg font-bold text-white">1,031 of 1,516</div>
              </div>
              <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-lg p-4">
                <div class="text-xs uppercase tracking-wide text-stone-300 mb-1">Operating Cost</div>
                <div class="text-lg font-bold text-white">~$4/month</div>
              </div>
              <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-lg p-4">
                <div class="text-xs uppercase tracking-wide text-stone-300 mb-1">Cost Per Case</div>
                <div class="text-lg font-bold text-white">$0.003</div>
              </div>
              <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-lg p-4">
                <div class="text-xs uppercase tracking-wide text-stone-300 mb-1">Stack</div>
                <div class="text-sm font-semibold text-white">Apex, GPT-4o, Flow</div>
              </div>
            </div>

            <p class="text-sm text-stone-300 italic">
              Want one of these for your business? I build AI Agents that live inside your Salesforce org (or any platform), handle inbound at all hours, and ramp up safely with full audit trails.
            </p>
          </div>

          <!-- Right: Hero stat -->
          <div class="lg:col-span-2 flex items-center justify-center">
            <div class="text-center bg-white/10 backdrop-blur-sm border-2 border-accent-400/50 rounded-2xl p-8 w-full">
              <div class="text-xs uppercase tracking-widest text-accent-300 font-bold mb-3">Headline Result</div>
              <div class="text-7xl sm:text-8xl font-black text-white leading-none mb-2">68<span class="text-accent-400">%</span></div>
              <div class="text-lg font-semibold text-white mb-1">Cases Auto-Handled</div>
              <div class="text-sm text-stone-300">end-to-end, no human review</div>
              <div class="mt-6 pt-6 border-t border-white/20">
                <div class="text-xs text-stone-300">5 weeks of stable production data</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Supporting Builds -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- AI Lead Qualifier -->
        <Card class="h-full flex flex-col">
          <div class="flex flex-col h-full">
            <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-accent-500 to-accent-600 rounded-xl flex items-center justify-center text-white shadow-lg mb-4">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
            </div>
