---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import NetworkBackground from '../components/NetworkBackground.astro';
import Badge from '../components/Badge.astro';
---

<BaseLayout
  title="Technology Stack Consulting | Tech Recommendations for Small Business"
  description="Technology consulting for small businesses. SaaS recommendations, tech stack optimization, vendor selection, and integration planning."
>
  <Header />

  <main>
  <section class="relative overflow-hidden py-16 sm:py-24 bg-gradient-to-br from-orange-50 via-amber-50 to-yellow-50 dark:from-gray-900 dark:via-orange-950 dark:to-yellow-950">
    <NetworkBackground density="normal" opacity={0.5} />

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <Badge variant="accent" class="mb-4">
          <svg class="w-4 h-4 inline-block mr-1" fill="currentColor" viewBox="0 0 20 20">
            <path d="M11 3a1 1 0 10-2 0v1a1 1 0 102 0V3zM15.657 5.757a1 1 0 00-1.414-1.414l-.707.707a1 1 0 001.414 1.414l.707-.707zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zM5.05 6.464A1 1 0 106.464 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zM5 10a1 1 0 01-1 1H3a1 1 0 110-2h1a1 1 0 011 1zM8 16v-1h4v1a2 2 0 11-4 0zM12 14c.015-.34.208-.646.477-.859a4 4 0 10-4.954 0c.27.213.462.519.476.859h4.002z" />
          </svg>
          Strategic Technology Advisor
        </Badge>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-gray-900 dark:text-white mb-6 animate-fade-in-up">
          Choose the Right Tools<br />For Your Business
        </h1>

        <p class="text-xl sm:text-2xl text-gray-600 dark:text-gray-300 mb-8 animate-delay-100">
          Stop overpaying for software you don't need. Get expert recommendations on CRMs, project management, communication tools, and more.
        </p>

        <div class="flex flex-wrap gap-4 justify-center animate-delay-200">
          <Button href="/contact?service=tech-consulting" variant="primary" size="lg">
            Request Tech Review
          </Button>
          <Button href="#services" variant="outline" size="lg">
            See What I Review
          </Button>
        </div>
      </div>
    </div>
  </section>

  <Section id="services" title="What I Help You Choose" subtitle="Technology categories I specialize in">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {[
        { title: 'CRM Systems', desc: 'Salesforce, HubSpot, Pipedrive - which fits your sales process and budget?', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z' },
        { title: 'Project Management', desc: 'Asana, Monday, ClickUp, Notion - find the right fit for your team', icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01' },
        { title: 'Communication Tools', desc: 'Slack, Teams, Zoom - streamline team collaboration', icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z' },
        { title: 'Marketing Automation', desc: 'Mailchimp, Pardot, ActiveCampaign - email and lead nurturing', icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
        { title: 'Cloud Infrastructure', desc: 'Microsoft 365, Google Workspace, Azure - productivity suites', icon: 'M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z' },
        { title: 'Analytics & BI', desc: 'Google Analytics, Tableau, Power BI - data insights', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' }
      ].map(item => (
        <Card shimmer={true}>
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-orange-500 to-amber-500 rounded-xl flex items-center justify-center text-white shadow-lg">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">{item.title}</h3>
              <p class="text-sm text-gray-600 dark:text-gray-400">{item.desc}</p>
            </div>
          </div>
        </Card>
      ))}
    </div>
  </Section>

  <Section class="bg-gray-50 dark:bg-gray-800" title="How It Works">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      {[
        { step: '01', title: 'Current State', desc: 'Inventory your existing tools and pain points' },
        { step: '02', title: 'Requirements', desc: 'Define must-haves, nice-to-haves, and budget' },
        { step: '03', title: 'Recommendations', desc: 'Top 3 options with pros/cons and pricing' },
        { step: '04', title: 'Implementation', desc: 'Help with setup, migration, and training' }
      ].map(phase => (
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-orange-500 to-amber-500 text-white rounded-2xl font-bold text-2xl mb-4 shadow-lg">
            {phase.step}
          </div>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">{phase.title}</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400">{phase.desc}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section title="Pricing">
    <div class="max-w-2xl mx-auto">
      <Card class="text-center">
        <h3 class="text-2xl font-bold mb-2">Technology Stack Review</h3>
        <div class="text-4xl font-bold text-orange-600 dark:text-orange-400 mb-4">$1,500</div>
        <p class="text-gray-600 dark:text-gray-300 mb-6">
          Comprehensive review of your current tools with recommendations report (1 week turnaround)
        </p>
        <ul class="text-left space-y-3 mb-8">
          {['Tool inventory & cost analysis', 'Workflow assessment', '3-5 recommendations per category', 'Implementation roadmap', '60-minute presentation', 'Free 30-day follow-up support'].map(f => (
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>{f}</span>
            </li>
          ))}
        </ul>
        <Button href="/contact?service=tech-consulting" variant="primary" size="lg" class="w-full">Request Review</Button>
      </Card>
    </div>
  </Section>

  <Section class="relative overflow-hidden bg-gradient-to-br from-orange-50/50 via-amber-50/50 to-yellow-50/50 dark:from-gray-900/50 dark:via-orange-950/50 dark:to-yellow-950/50">
    <NetworkBackground density="sparse" opacity={0.4} />
    <div class="relative z-10 text-center max-w-3xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold mb-6">Stop Guessing About Software</h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 mb-8">
        Get expert recommendations tailored to your business, budget, and goals.
      </p>
      <Button href="/contact?service=tech-consulting" variant="primary" size="lg">Schedule Free Consultation</Button>
    </div>
  </Section>
  </main>

  <Footer />
</BaseLayout>
