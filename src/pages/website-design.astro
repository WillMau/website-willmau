---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import NetworkBackground from '../components/NetworkBackground.astro';
import StatCard from '../components/StatCard.astro';
import Badge from '../components/Badge.astro';

const features = [
  {
    title: 'Modern, Fast Websites',
    description: 'Built with Astro for lightning-fast load times. No WordPress bloat, no complex CMSs to manage.',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z'
  },
  {
    title: 'Mobile-First Design',
    description: 'Responsive on all devices. Looks perfect on phones, tablets, and desktops.',
    icon: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z'
  },
  {
    title: 'SEO Optimized',
    description: 'Built-in SEO best practices. Proper meta tags, structured data, fast Core Web Vitals scores.',
    icon: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z'
  },
  {
    title: 'Easy to Update',
    description: 'Simple content updates via GitHub or I can handle it for you. No complicated admin panels.',
    icon: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z'
  },
  {
    title: 'Hosting Included',
    description: 'Free, fast hosting on GitHub Pages or Netlify. SSL certificate, CDN, and 99.9% uptime included.',
    icon: 'M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z'
  },
  {
    title: 'Contact Forms',
    description: 'Working contact forms that route to your email. Optional integrations with your CRM.',
    icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'
  }
];

const portfolioSites = [
  {
    name: 'Shoreline Senior Care',
    url: 'https://shorelineseniorcareadvocates.com',
    description: 'Clean, professional site for senior care advocacy services. Built with Astro, optimized for conversions.',
    tags: ['Astro', 'Tailwind', 'SEO']
  },
  {
    name: 'Rockford Milling',
    url: 'https://rockfordmilling.com',
    description: 'Industrial manufacturing site with product catalog and contact forms.',
    tags: ['Astro', 'Contact Forms', 'Responsive']
  }
];

const packages = [
  {
    name: 'Landing Page',
    price: '$1,500',
    duration: '1 week',
    description: 'Single-page site perfect for service businesses or product launches.',
    features: [
      '1 custom designed page',
      'Mobile responsive',
      'Contact form',
      'SEO optimization',
      'Free hosting setup',
      'SSL certificate',
      '1 round of revisions'
    ]
  },
  {
    name: 'Business Website',
    price: '$3,500',
    duration: '2-3 weeks',
    description: 'Multi-page website with custom design, SEO, and all the essentials.',
    features: [
      '5-7 custom pages',
      'Full custom design',
      'Contact forms + CRM integration',
      'Blog/news section (optional)',
      'Advanced SEO setup',
      'Analytics integration',
      'Free hosting + SSL',
      '2 rounds of revisions',
      '30 days post-launch support'
    ]
  },
  {
    name: 'E-Commerce / Custom',
    price: 'Custom pricing',
    duration: '3-6 weeks',
    description: 'Online stores, member portals, or complex custom functionality.',
    features: [
      'Custom page count',
      'Payment processing (Stripe)',
      'Product catalog',
      'Member login/authentication',
      'Custom functionality',
      'API integrations',
      'Ongoing support available'
    ]
  }
];

const faqs = [
  {
    question: 'Do you use WordPress?',
    answer: 'No - I build with modern frameworks like Astro that are faster, more secure, and easier to maintain. No plugin bloat, no security vulnerabilities.'
  },
  {
    question: 'Can I update the content myself?',
    answer: 'Yes! Simple content changes can be made through GitHub, or I offer a monthly retainer ($200/mo) where I handle all updates for you.'
  },
  {
    question: 'What about hosting and domain names?',
    answer: 'Hosting is free (GitHub Pages or Netlify). Domain names cost ~$15/year - I can help you register one or connect an existing domain.'
  },
  {
    question: 'How long does a website take to build?',
    answer: 'Landing pages: 1 week. Full business sites: 2-3 weeks. Custom projects: 3-6 weeks. Timeline depends on content readiness and revision rounds.'
  }
];
---

<BaseLayout
  title="Website Design | Modern, Fast Websites for Small Businesses"
  description="Custom website design and development for small businesses. Modern, fast sites built with Astro. Free hosting, SEO-optimized, mobile responsive."
>
  <Header />

  <main>
  <!-- Hero Section with Network Theme -->
  <section class="relative overflow-hidden py-16 sm:py-24 bg-gradient-to-br from-purple-50 via-pink-50 to-fuchsia-50 dark:from-gray-900 dark:via-purple-950 dark:to-fuchsia-950">
    <NetworkBackground density="normal" opacity={0.5} />

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <Badge variant="accent" class="mb-4">
          <svg class="w-4 h-4 inline-block mr-1" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M12.316 3.051a1 1 0 01.633 1.265l-4 12a1 1 0 11-1.898-.632l4-12a1 1 0 011.265-.633zM5.707 6.293a1 1 0 010 1.414L3.414 10l2.293 2.293a1 1 0 11-1.414 1.414l-3-3a1 1 0 010-1.414l3-3a1 1 0 011.414 0zm8.586 0a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 11-1.414-1.414L16.586 10l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
          Built with Modern Technology
        </Badge>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-gray-900 dark:text-white mb-6 animate-fade-in-up">
          Websites That Actually<br />Help Your Business
        </h1>

        <p class="text-xl sm:text-2xl text-gray-600 dark:text-gray-300 mb-8 animate-delay-100">
          Fast, modern websites for small businesses. No WordPress bloat. No monthly fees. Just clean, professional sites that convert visitors into customers.
        </p>

        <div class="flex flex-wrap gap-4 justify-center animate-delay-200">
          <Button href="/contact?service=website-design" variant="primary" size="lg">
            Get a Free Quote
          </Button>
          <Button href="#portfolio" variant="outline" size="lg">
            View Portfolio
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose These Websites -->
  <Section class="relative overflow-hidden bg-white dark:bg-gray-900">
    <div class="relative z-10">
      <h2 class="text-3xl font-bold text-center mb-12 text-gray-900 dark:text-white">
        What Makes These Sites Different
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <StatCard
          value="<1s"
          label="Average Load Time"
          color="purple"
        />
        <StatCard
          value="95+"
          label="Lighthouse Performance Score"
          color="green"
        />
        <StatCard
          value="$0/mo"
          label="Hosting Costs After Launch"
          color="blue"
        />
      </div>
    </div>
  </Section>

  <!-- Features -->
  <Section title="What's Included" subtitle="Everything you need for a professional online presence">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((feature) => (
        <Card shimmer={true}>
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-purple-500 to-pink-500 rounded-xl flex items-center justify-center text-white shadow-lg">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={feature.icon} />
              </svg>
            </div>
            <div class="flex-1">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
                {feature.title}
              </h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm">
                {feature.description}
              </p>
            </div>
          </div>
        </Card>
      ))}
    </div>
  </Section>

  <!-- Portfolio -->
  <Section id="portfolio" class="bg-gray-50 dark:bg-gray-800" title="Recent Projects" subtitle="Live examples of websites I've built">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {portfolioSites.map((site) => (
        <Card class="h-full flex flex-col">
          <div class="flex-1">
            <div class="flex items-start justify-between mb-4">
              <h3 class="text-2xl font-bold text-gray-900 dark:text-white">
                {site.name}
              </h3>
              <a
                href={site.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300"
              >
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>

            <p class="text-gray-600 dark:text-gray-300 mb-4">
              {site.description}
            </p>

            <div class="flex flex-wrap gap-2">
              {site.tags.map((tag) => (
                <Badge variant="accent">{tag}</Badge>
              ))}
            </div>
          </div>

          <div class="mt-6">
            <Button href={site.url} variant="outline" class="w-full">
              Visit Site →
            </Button>
          </div>
        </Card>
      ))}
    </div>
  </Section>

  <!-- Packages & Pricing -->
  <Section title="Pricing & Packages" subtitle="Fixed-price packages with no surprises">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {packages.map((pkg) => (
        <Card class="h-full flex flex-col">
          <div class="flex-1">
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">
              {pkg.name}
            </h3>
            <div class="text-3xl font-bold text-purple-600 dark:text-purple-400 mb-2">
              {pkg.price}
            </div>
            <div class="text-sm text-gray-500 dark:text-gray-400 mb-4">
              {pkg.duration}
            </div>
            <p class="text-gray-600 dark:text-gray-300 mb-6">
              {pkg.description}
            </p>

            <ul class="space-y-3">
              {pkg.features.map((feature) => (
                <li class="flex items-start gap-2 text-sm">
                  <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  <span class="text-gray-600 dark:text-gray-400">{feature}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-8">
            <Button href="/contact?service=website-design" variant="primary" class="w-full">
              Get Started
            </Button>
          </div>
        </Card>
      ))}
    </div>
  </Section>

  <!-- How It Works -->
  <Section class="bg-gray-50 dark:bg-gray-800" title="How It Works">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      {[
        { step: '01', title: 'Discovery', desc: 'Free call to discuss your business, goals, and design preferences' },
        { step: '02', title: 'Design', desc: 'Mockup and wireframes for your review (2-3 days)' },
        { step: '03', title: 'Build', desc: 'Full development with weekly progress updates' },
        { step: '04', title: 'Launch', desc: 'Domain setup, hosting, and training on how to make updates' }
      ].map((phase) => (
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-purple-500 to-pink-500 text-white rounded-2xl font-bold text-2xl mb-4 shadow-lg">
            {phase.step}
          </div>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
            {phase.title}
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            {phase.desc}
          </p>
        </div>
      ))}
    </div>
  </Section>

  <!-- FAQ -->
  <Section title="Frequently Asked Questions">
    <div class="max-w-3xl mx-auto space-y-6">
      {faqs.map((faq) => (
        <Card>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
            {faq.question}
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            {faq.answer}
          </p>
        </Card>
      ))}
    </div>
  </Section>

  <!-- CTA Section -->
  <Section class="relative overflow-hidden bg-gradient-to-br from-purple-50/50 via-pink-50/50 to-fuchsia-50/50 dark:from-gray-900/50 dark:via-purple-950/50 dark:to-fuchsia-950/50">
    <NetworkBackground density="sparse" opacity={0.4} />

    <div class="relative z-10 text-center max-w-3xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-6">
        Ready for a Website That Works?
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 mb-8">
        Get a free quote and see examples of what I can build for your business.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <Button href="/contact?service=website-design" variant="primary" size="lg">
          Get Free Quote
        </Button>
        <Button href="#portfolio" variant="outline" size="lg">
          View More Examples
        </Button>
      </div>
    </div>
  </Section>
  </main>

  <Footer />
</BaseLayout>
