---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
import { pricing } from '../config/pricing';

const services = [
  {
    title: 'Custom Website Design & Build',
    description: 'Clean, fast, mobile-first websites designed around your brand and business goals. No cookie-cutter templates.',
    icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'
  },
  {
    title: 'Content Writing & Strategy',
    description: 'Clear, conversion-focused copy that speaks to your audience. I write for real people, not search engines.',
    icon: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z'
  },
  {
    title: 'CRM & Form Integration',
    description: 'Contact forms that connect directly to Salesforce or your CRM. Leads are captured, routed, and ready for follow-up.',
    icon: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15'
  },
  {
    title: 'SEO & Performance',
    description: 'Built-in search optimization, fast load times, structured data, and sitemaps so your site ranks and performs from day one.',
    icon: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z'
  },
  {
    title: 'Site Refreshes & Redesigns',
    description: 'Modernize an outdated site without starting from scratch. I migrate your content and preserve your SEO value.',
    icon: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15'
  },
  {
    title: 'Ongoing Support & Updates',
    description: 'Content updates, performance monitoring, and maintenance so your site stays fast, secure, and current.',
    icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z'
  }
];

const faqs = [
  {
    question: 'What platforms do you build on?',
    answer: 'Astro and WordPress. I pick the platform that matches your needs, budget, and how comfortable your team is with technology. No lock-in.'
  },
  {
    question: 'Can you redesign my existing website?',
    answer: 'Yes. I can refresh the design in place or rebuild from scratch, depending on what makes sense. Either way, I migrate your content and set up redirects so you keep your SEO value.'
  },
  {
    question: 'Do you write the copy too?',
    answer: 'Yes. I write clear, conversion-focused content for every page. If you already have messaging you like, I will work with that and refine it for the web.'
  },
  {
    question: 'Will I be able to update the site myself?',
    answer: 'Yes. Every project includes training and documentation so your team can make content updates, add pages, and manage the site day to day without needing a developer.'
  },
  {
    question: 'How long does a typical website project take?',
    answer: 'Most sites launch within 2 to 4 weeks. After our call, you get a clear timeline with milestones so you know exactly what to expect.'
  },
  {
    question: 'Do you only work with businesses in Schenectady?',
    answer: 'No. I am based in Schenectady and work with small businesses across the whole Capital Region, including Albany, Saratoga Springs, Troy, Niskayuna, Clifton Park, and the surrounding towns. Most of the work can be done remotely, and I am happy to meet in person when you are nearby.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
});
---

<BaseLayout
  title="Website Design in Schenectady & the Capital Region"
  description="Custom website design for small businesses in Schenectady, Albany, Saratoga, and the Capital Region. Fast, mobile-first sites with local SEO and Google Business Profile setup included."
  pageLabel="Websites & Digital Presence"
>
  <Header />
  <script type="application/ld+json" set:html={faqSchema} />

  <main>
  <!-- Hero -->
  <section class="relative overflow-hidden py-16 sm:py-24 bg-white dark:bg-gray-950">
    <div class="absolute inset-0 bg-gradient-to-br from-accent-50/40 via-transparent to-navy-50/30 dark:from-accent-900/10 dark:via-transparent dark:to-navy-950/20" aria-hidden="true"></div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <Badge variant="accent" class="mb-4">
          <svg class="w-4 h-4 inline-block mr-1" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M4.083 9h1.946c.089-1.546.383-2.97.837-4.118A6.004 6.004 0 004.083 9zM10 2a8 8 0 100 16 8 8 0 000-16zm0 2c-.076 0-.232.032-.465.262-.238.234-.497.623-.737 1.182-.389.907-.673 2.142-.766 3.556h3.936c-.093-1.414-.377-2.649-.766-3.556-.24-.56-.5-.948-.737-1.182C10.232 4.032 10.076 4 10 4zm3.971 5c-.089-1.546-.383-2.97-.837-4.118A6.004 6.004 0 0115.917 9h-1.946zm-2.003 2H8.032c.093 1.414.377 2.649.766 3.556.24.56.5.948.737 1.182.233.23.389.262.465.262.076 0 .232-.032.465-.262.238-.234.497-.623.737-1.182.389-.907.673-2.142.766-3.556zm1.166 4.118c.454-1.147.748-2.572.837-4.118h1.946a6.004 6.004 0 01-2.783 4.118zm-6.268 0C6.412 13.97 6.118 12.546 6.029 11H4.083a6.004 6.004 0 002.783 4.118z" clip-rule="evenodd" />
          </svg>
          Web Design & Development
        </Badge>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-navy-900 dark:text-white mb-6 animate-fade-in-up">
          A Sharp Site That<br />Brings Leads In
        </h1>

        <p class="text-xl sm:text-2xl text-stone-600 dark:text-stone-300 mb-8 animate-delay-100">
          Fast, modern websites for small businesses across Schenectady, Albany, and the Capital Region. Clear copy, CRM integration, and local SEO built in, with training so your team stays in control.
        </p>

        <div class="flex flex-wrap gap-4 justify-center animate-delay-200">
          <Button href="/contact/?service=website&source=website-design" variant="primary" size="lg">
            Get a Free Site Review
          </Button>
          <Button href="#portfolio" variant="outline" size="lg">
            See My Work
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Free mockup first -->
  <section class="bg-accent-50/60 dark:bg-accent-950/20 border-y border-accent-200/60 dark:border-accent-800/40">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
      <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-start gap-6">
        <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-accent-600 text-white flex items-center justify-center shadow-md">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
        </div>
        <div>
          <p class="text-sm font-semibold uppercase tracking-wide text-accent-700 dark:text-accent-400 mb-2">Step one, and it is free</p>
          <h2 class="text-2xl sm:text-3xl font-bold text-navy-900 dark:text-white mb-3">You see your site before you pay anything</h2>
          <p class="text-base text-stone-700 dark:text-stone-300 leading-relaxed">
            I build you a real, working mockup first, with your brand, your photos, and your words. Not a picture of a website, an actual site you can click through on your phone. It lives at your own review address, something like <span class="font-medium text-navy-900 dark:text-white">yourbusiness.mauops.com</span>, and it costs you nothing.
          </p>
          <p class="text-base text-stone-700 dark:text-stone-300 leading-relaxed mt-3">
            If you like it, we talk about what it takes to launch it. If you do not, you owe me nothing and you walk away. No deposit, and no contract to sign before you have seen the work.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Portfolio -->
  <Section id="portfolio" class="bg-stone-50 dark:bg-gray-900" title="Sites I Have Built" subtitle="Production websites I designed, wrote the content for, built, and launched.">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl">

      <!-- LMNOP Advisors -->
      <Card class="overflow-hidden">
        <img src="/portfolio/lmnop-logo.png" alt="LMNOP Advisors logo" class="w-full h-48 object-contain bg-stone-100 dark:bg-stone-800 rounded-lg mb-4 p-6" loading="lazy" />
        <div class="text-sm text-accent-600 dark:text-accent-400 font-medium mb-1">WordPress Migration</div>
        <h3 class="text-xl font-semibold text-navy-900 dark:text-white mb-2">LMNOP Advisors</h3>
        <p class="text-sm text-stone-600 dark:text-stone-400 mb-4">Full rebuild for a fractional COO practice in Clifton Park, NY. Moved off WordPress to a fast static site with service pages, an insights section, and online booking.</p>
        <a
          href="https://lmnopadvisors.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent-600 dark:text-accent-400 hover:text-accent-700 dark:hover:text-accent-300 font-medium inline-flex items-center gap-2 text-sm"
        >
          Visit lmnopadvisors.com
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </Card>

      <!-- Rockford Milling -->
      <Card class="overflow-hidden">
        <img src="/portfolio/rockford-logo.png" alt="Rockford Milling & Woodworking logo" class="w-full h-48 object-contain bg-stone-100 dark:bg-stone-800 rounded-lg mb-4 p-6" loading="lazy" />
        <div class="text-sm text-accent-600 dark:text-accent-400 font-medium mb-1">Portfolio Site</div>
        <h3 class="text-xl font-semibold text-navy-900 dark:text-white mb-2">Rockford Milling & Woodworking</h3>
        <p class="text-sm text-stone-600 dark:text-stone-400 mb-4">Custom woodworking portfolio showcasing craftsmanship with clean layout, product categories, and clear contact options for custom orders.</p>
        <a
          href="https://www.rockfordmilling.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent-600 dark:text-accent-400 hover:text-accent-700 dark:hover:text-accent-300 font-medium inline-flex items-center gap-2 text-sm"
        >
          Visit rockfordmilling.com
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </Card>

      <!-- BSA Troop 54 -->
      <Card class="overflow-hidden">
        <img src="/portfolio/troop54-logo.png" alt="Troop 54 Schenectady logo" class="w-full h-48 object-contain bg-stone-100 dark:bg-stone-800 rounded-lg mb-4 p-6" loading="lazy" />
        <div class="text-sm text-accent-600 dark:text-accent-400 font-medium mb-1">Organization Website</div>
        <h3 class="text-xl font-semibold text-navy-900 dark:text-white mb-2">BSA Troop 54</h3>
        <p class="text-sm text-stone-600 dark:text-stone-400 mb-4">Website for a Scout troop in Rotterdam, NY. Meeting info, event details, and recruitment content for families and prospective Scouts.</p>
        <a
          href="https://www.troop3054.org"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent-600 dark:text-accent-400 hover:text-accent-700 dark:hover:text-accent-300 font-medium inline-flex items-center gap-2 text-sm"
        >
          Visit troop3054.org
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </Card>

      <!-- Mau Consulting (this site) -->
      <Card class="overflow-hidden">
        <img src="/portfolio/mau-consulting-favicon-M-consulting-transparent.jpg" alt="Mau Consulting logo" class="w-full h-48 object-contain bg-stone-100 dark:bg-stone-800 rounded-lg mb-4 p-6" loading="lazy" />
        <div class="text-sm text-accent-600 dark:text-accent-400 font-medium mb-1">Consulting Site</div>
        <h3 class="text-xl font-semibold text-navy-900 dark:text-white mb-2">Mau Consulting</h3>
        <p class="text-sm text-stone-600 dark:text-stone-400 mb-4">This site. Built on Astro with Tailwind CSS, custom branding, dark mode, and optimized for performance and SEO. Designed and coded from scratch.</p>
        <span class="text-accent-600 dark:text-accent-400 font-medium text-sm">You are here</span>
      </Card>

    </div>
  </Section>

  <!-- Services -->
  <Section id="services" title="What I Build" subtitle="Everything you need for a site that works as hard as your business.">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map(item => (
        <Card shimmer={true}>
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-accent-500 to-accent-600 rounded-xl flex items-center justify-center text-white shadow-lg">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-navy-900 dark:text-white mb-2">{item.title}</h3>
              <p class="text-sm text-stone-600 dark:text-stone-400">{item.description}</p>
            </div>
          </div>
        </Card>
      ))}
    </div>
  </Section>

  <!-- Every Project Includes -->
  <Section class="bg-accent-50/50 dark:bg-accent-950/20" title="Every Project Includes">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
      {[
        { title: 'Documentation', desc: 'Site architecture docs, content management guides, and update procedures your team can follow without a developer.', icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' },
        { title: 'Hands-On Training', desc: 'Live walkthrough of how to update content, add pages, and manage your site. Plus recorded guides your team can reference anytime.', icon: 'M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z' },
        { title: 'SEO Built In', desc: 'Meta tags, structured data, sitemaps, fast load times, and mobile optimization so your site performs well from launch day.', icon: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z' }
      ].map(item => (
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-14 h-14 bg-accent-100 dark:bg-accent-900/30 text-accent-600 dark:text-accent-400 rounded-2xl mb-4">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-navy-900 dark:text-white mb-2">{item.title}</h3>
          <p class="text-sm text-stone-600 dark:text-stone-400">{item.desc}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Photo Break -->
  <section class="relative h-64 sm:h-80 lg:h-96 overflow-hidden">
    <img
      src="/photo-break-laptop.jpg"
      alt="Laptop and notepad on a clean desk"
      class="absolute inset-0 w-full h-full object-cover grayscale"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-navy-950/70 to-navy-900/20 dark:from-gray-950/80 dark:to-gray-950/30"></div>
    <div class="relative z-10 h-full flex items-center">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-white text-2xl sm:text-3xl lg:text-4xl font-bold max-w-lg leading-snug">
          A site your team can<br />
          actually update themselves.
        </p>
      </div>
    </div>
  </section>

  <!-- Toolkit -->
  <Section class="bg-white dark:bg-gray-950">
    <h2 class="text-3xl font-bold text-center mb-4 text-navy-900 dark:text-white">Built With</h2>
    <p class="text-center text-stone-600 dark:text-stone-300 mb-12 max-w-2xl mx-auto">
      I pick the platform that matches your needs and your team's comfort level. No lock-in.
    </p>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 max-w-4xl mx-auto">
      {[
        { name: 'Astro', desc: 'Fast Static Sites', highlight: true },
        { name: 'WordPress', desc: 'CMS & Blogs' },
        { name: 'Tailwind CSS', desc: 'Modern Styling' },
        { name: 'Salesforce', desc: 'CRM Integration' },
        { name: 'Google Analytics', desc: 'Tracking' },
        { name: 'GitHub', desc: 'Version Control' },
      ].map(tool => (
        <div class:list={[
          'text-center p-4 rounded-xl border transition-colors',
          tool.highlight
            ? 'border-accent-300 dark:border-accent-700 bg-accent-50/50 dark:bg-accent-900/10'
            : 'border-stone-200 dark:border-stone-800 bg-stone-50/50 dark:bg-stone-900/30'
        ]}>
          <p class="text-sm font-semibold text-navy-900 dark:text-white">{tool.name}</p>
          <p class="text-xs text-stone-500 dark:text-stone-400 mt-1">{tool.desc}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- How I Compare -->
  <Section class="bg-white dark:bg-gray-950" title="How I compare" subtitle="Agency-level service and the things others charge extra for, at honest prices with no agency overhead. Here is where I fit.">
    <div class="max-w-5xl mx-auto">
      <div class="overflow-x-auto -mx-4 px-4 sm:mx-0 sm:px-0">
        <table class="w-full min-w-[680px] border-collapse">
          <thead>
            <tr>
              <th class="p-3"></th>
              <th class="p-3 text-center text-sm font-semibold text-navy-700 dark:text-stone-300">DIY builder</th>
              <th class="p-3 text-center text-sm font-semibold text-navy-700 dark:text-stone-300">Freelancer / Fiverr</th>
              <th class="p-3 text-center text-sm font-semibold text-navy-700 dark:text-stone-300">Agency</th>
              <th class="p-3 text-center text-sm font-bold text-white bg-accent-600 rounded-t-xl">Mau Consulting</th>
            </tr>
          </thead>
          <tbody>
            {[
              { label: 'Typical price', diy: '$0–$30/mo', freelancer: '$1k–$5k', agency: '$6k–$35k', mau: '$250–$500 + add-ons', check: false },
              { label: 'See a working site before you pay', diy: 'n/a', freelancer: 'Rarely', agency: 'No, paid discovery', mau: 'Yes, free mockup', check: true },
              { label: 'You work directly with who builds it', diy: 'You do it all', freelancer: 'Sometimes', agency: 'No, an account manager', mau: 'Yes, always me', check: true },
              { label: 'Content written for you', diy: 'No', freelancer: 'Sometimes', agency: 'Extra cost', mau: 'Included', check: true },
              { label: 'Getting found on Google (SEO + Business Profile)', diy: 'No', freelancer: 'Rarely', agency: 'Extra cost', mau: 'Included', check: true },
              { label: 'Support after launch', diy: 'You', freelancer: 'Often gone', agency: 'Paid retainer', mau: 'Included', check: true },
              { label: 'Training to update it yourself', diy: 'n/a', freelancer: 'Rarely', agency: 'Extra cost', mau: 'Included', check: true },
              { label: 'The systems behind it (CRM, lead follow-up)', diy: 'No', freelancer: 'No', agency: 'Limited', mau: 'Yes, 15 yrs of ops', check: true },
              { label: 'Local, meets in person', diy: 'n/a', freelancer: 'Usually not', agency: 'Maybe', mau: 'Yes, Capital Region', check: true },
              { label: 'Fixed price, no surprises', diy: 'n/a', freelancer: 'Varies', agency: 'Varies', mau: 'Yes', check: true },
            ].map((row, i, arr) => (
              <tr class="border-t border-stone-200 dark:border-stone-800">
                <td class="p-3 text-sm font-medium text-navy-900 dark:text-white">{row.label}</td>
                <td class="p-3 text-center text-sm text-stone-500 dark:text-stone-400">{row.diy}</td>
                <td class="p-3 text-center text-sm text-stone-500 dark:text-stone-400">{row.freelancer}</td>
                <td class="p-3 text-center text-sm text-stone-500 dark:text-stone-400">{row.agency}</td>
                <td class:list={["p-3 text-center text-sm font-semibold text-accent-700 dark:text-accent-300 bg-accent-50/70 dark:bg-accent-900/15", i === arr.length - 1 && "rounded-b-xl"]}>
                  <span class="inline-flex items-center justify-center gap-1.5">
                    {row.check && (
