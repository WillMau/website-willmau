      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .answer-btn[aria-checked="true"],
    .hours-btn[aria-checked="true"],
    .screening-btn[aria-checked="true"] {
      background: linear-gradient(135deg, rgb(236 98 73), rgb(217 74 51));
