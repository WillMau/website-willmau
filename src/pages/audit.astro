  </style>

  <!-- Chart.js for the radar chart (loaded before the inline audit logic) -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

  <!-- canvas-confetti for Strong-tier celebration (tiny, ~2kb) -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>

  <!-- lottie-web for the "analyzing" animation (~10kb gzipped). The animation JSON is loaded only if /audit/lottie-analyzing.json exists. -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/lottie-web@5.12.2/build/player/lottie_light.min.js"></script>

  <script is:inline define:vars={{ categoryIds: categories.map(c => c.id), questionList: questions, hoursOptionsData: hoursOptions, categoryNames: categories.map(c => c.name), employeeOptionsData: screeningEmployeeOptions, revenueOptionsData: screeningRevenueOptions }}>
    // ============================
    // AUDIT LOGIC (vanilla JS)
    // ============================

    const STORAGE_KEY = 'mauops-audit-v2';
    const SCREENS = ['intro', 'screening', ...categoryIds, 'quant', 'analyzing', 'results'];

    // Tier definitions
    const TIERS = [
      { min: 80, max: 100, name: 'Strong', color: 'bg-green-500 text-white',
        headline: 'Solid operations. Room to optimize, not rebuild.' },
      { min: 60, max: 79, name: 'Solid', color: 'bg-yellow-500 text-white',
        headline: 'Good base. A few real gaps costing you time and money.' },
      { min: 40, max: 59, name: 'Gaps', color: 'bg-orange-500 text-white',
        headline: 'Significant ops debt. You’re losing hours every week to fixable problems.' },
      { min: 0,  max: 39, name: 'Critical', color: 'bg-red-500 text-white',
        headline: 'Operations are holding the business back. The good news: this is where the biggest gains live.' },
    ];

    // Category metadata for diagnosis. weakDiags/strongDiags indexed by question position within the category.
    const CAT_META = {
      marketing: {
        name: 'Marketing & Digital Presence',
        weakDiags: [
          'visitors come and go but rarely become leads',
          'people searching for what you do can’t find you on Google Maps',
          'you’re spending on marketing without a clean signal of what actually closes',
        ],
        strongDiags: [
          'Your website does the heavy lifting of converting visitors to leads.',
          'You show up where you should when people search locally.',
          'You can name the marketing channel that actually closes business.',
        ],
        fixSteps: [
          'Add lead-capture forms and a clear next step to every page of your website.',
          'Claim and complete your Google Business Profile. Then ask five happy customers for a review.',
          'Tag where every lead came from. A single “How did you find us?” field is a fine place to start.',
        ],
        serviceLink: '/website-design/',
        serviceLabel: 'See: Websites & Digital Presence',
      },
      sales: {
        name: 'Sales & Pipeline',
        weakDiags: [
          'leads scatter across inboxes and texts. Things slip',
          'follow-up depends on whoever remembered to check the inbox today',
        ],
        strongDiags: [
          'Your CRM is doing its job. Every lead lives somewhere you can find it.',
          'You’ve got a documented follow-up that runs even when you’re slammed.',
        ],
        fixSteps: [
          'Pick one place every lead lives. CRM, spreadsheet, anything. Just one place.',
          'Build a simple 5-touch follow-up sequence. Day 0, day 2, day 7, day 14, day 30.',
          'Set a 24-hour reply standard for new leads. An auto-reply counts as a start.',
        ],
        serviceLink: '/salesforce-consulting/',
        serviceLabel: 'See: Salesforce & Revenue Systems',
      },
      service: {
        name: 'Customers & Service',
        weakDiags: [
          'customer issues are scattered across texts, voicemail, and three inboxes',
          'you find out a customer is unhappy when they’re already gone',
        ],
        strongDiags: [
          'Customer issues land in one place where nothing falls through.',
          'You’re close enough to your customers to catch trouble before it walks.',
        ],
        fixSteps: [
          'Get every customer issue into one place. A shared inbox works at the start.',
          'Put a 15-minute weekly account-health check on the calendar. Catch the quiet ones early.',
          'Build a feedback loop. Even a single quarterly check-in email beats nothing.',
        ],
        serviceLink: '/operations/',
        serviceLabel: 'See: Operations & Process',
      },
      ops: {
        name: 'Operations & Tools',
        weakDiags: [
          'your team is retyping the same info between systems all day',
          'you’re leaving easy wins on the table because nothing repetitive is automated',
          'too much work lives in specific people’s heads. If one of them leaves, you’re exposed',
        ],
        strongDiags: [
          'Your tools mostly talk to each other. No human is the integration anymore.',
          'You’re using automation where it earns its keep.',
          'Your processes are documented well enough that the business survives vacations.',
        ],
        fixSteps: [
          'Find where the same info is being typed twice. Connect those two systems first.',
          'Pick the one repetitive task that eats the most time and automate it. Start with a one-hour-saved-per-week win.',
          'Document your top three processes. Anyone could pick them up, not just the one who normally does the work.',
        ],
        serviceLink: '/ai-solutions/',
        serviceLabel: 'See: AI & Automation',
      },
      money: {
        name: 'Money & Time',
        weakDiags: [
          'invoices go out late, which means cash comes in even later',
          'most of your week is reactive admin instead of moving the business forward',
        ],
        strongDiags: [
          'You bill fast, which means you get paid sooner.',
          'You’re spending your time on the work only you can do.',
        ],
        fixSteps: [
          'Invoice the day the work is done. Same-day billing is the cheapest cash-flow fix there is.',
          'Reserve one half-day per week for forward-looking work. Defend it on the calendar.',
          'List the five things only you can do. Delegate or automate one item not on that list this week.',
        ],
        serviceLink: '/operations/',
        serviceLabel: 'See: Operations & Process',
      },
    };

    // State
    let state = {
      step: 0, // index into SCREENS
      answers: {}, // qid -> integer 1-5, or -1 for N/A
      manualHours: null,
      ownerHours: null,
      // Screening
      employees: null,     // index into employeeOptionsData
      revenue: null,       // index into revenue brackets (4 = "prefer not to say")
      businessType: '',    // free-text string
    };

    // ====== Persistence ======
    function loadState() {
      try {
        const raw = sessionStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (parsed && typeof parsed === 'object') {
            state = { ...state, ...parsed };
          }
        }
      } catch (e) { /* ignore */ }
    }
    function saveState() {
      try { sessionStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) {}
    }
    function clearState() {
      try { sessionStorage.removeItem(STORAGE_KEY); } catch (e) {}
    }

    // ====== Screen routing ======
    function showScreen(name) {
      document.querySelectorAll('.audit-screen').forEach(el => el.classList.add('hidden'));
      const el = document.getElementById('screen-' + name);
      if (el) {
        el.classList.remove('hidden');
        // Re-trigger animation
        el.style.animation = 'none';
        el.offsetHeight;
        el.style.animation = '';
        // Scroll to top of screen
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    function updateProgress() {
      const progressWrap = document.getElementById('progress-wrap');
      const fill = document.getElementById('progress-fill');
      const label = document.getElementById('progress-label');
      if (!progressWrap || !fill || !label) return;

      const currentScreen = SCREENS[state.step];
      if (currentScreen === 'intro') {
        progressWrap.classList.add('hidden');
        return;
      }
      progressWrap.classList.remove('hidden');

      const answered = Object.keys(state.answers).length;
      const total = questionList.length;
      let pct;
      let labelText;

      if (currentScreen === 'screening') {
        pct = 5;
        labelText = 'A bit of context first';
      } else if (currentScreen === 'results') {
        pct = 100;
        labelText = 'Diagnosis complete';
      } else if (currentScreen === 'analyzing') {
        pct = 95;
        labelText = 'Analyzing…';
      } else if (currentScreen === 'quant') {
        pct = Math.min(95, ((answered / total) * 85) + 10);
        labelText = 'Two final numbers';
      } else {
        // category screen
        pct = ((answered / total) * 85) + 10;
        labelText = `Question ${Math.min(answered + 1, total)} of ${total}`;
      }

      fill.style.width = pct + '%';
      label.textContent = labelText;
    }

    function goto(stepIdx) {
      state.step = stepIdx;
      saveState();
      showScreen(SCREENS[stepIdx]);
      updateProgress();
    }

    // ====== Wire up answer buttons ======
    function setupAnswerButtons() {
      document.querySelectorAll('.answer-btn').forEach(btn => {
        const qid = btn.dataset.qid;
        const val = parseInt(btn.dataset.value, 10);

        // Restore selected state on load
        if (state.answers[qid] === val) {
          btn.setAttribute('aria-checked', 'true');
        }

        btn.addEventListener('click', () => {
          state.answers[qid] = val;
          // Update sibling buttons
          const siblings = btn.closest('[role="radiogroup"]').querySelectorAll('.answer-btn');
          siblings.forEach(s => s.setAttribute('aria-checked', s === btn ? 'true' : 'false'));
          saveState();
          updateProgress();
          updateNextEnabled();
        });
      });
    }

    function setupHoursButtons() {
      document.querySelectorAll('.hours-btn').forEach(btn => {
        const key = btn.dataset.key;
        const val = parseInt(btn.dataset.value, 10);

        if (state[key] === val) {
          btn.setAttribute('aria-checked', 'true');
        }

        btn.addEventListener('click', () => {
          state[key] = val;
          const siblings = btn.closest('[role="radiogroup"]').querySelectorAll('.hours-btn');
          siblings.forEach(s => s.setAttribute('aria-checked', s === btn ? 'true' : 'false'));
          saveState();
          updateFinishEnabled();
        });
      });
    }

    function setupScreeningButtons() {
      // Employees + Revenue brackets (chunky button group)
      document.querySelectorAll('.screening-btn').forEach(btn => {
        const key = btn.dataset.key;
        const val = parseInt(btn.dataset.value, 10);

        if (state[key] === val) {
          btn.setAttribute('aria-checked', 'true');
        }

        btn.addEventListener('click', () => {
          state[key] = val;
          const siblings = btn.closest('[role="radiogroup"]').querySelectorAll('.screening-btn');
          siblings.forEach(s => s.setAttribute('aria-checked', s === btn ? 'true' : 'false'));
          saveState();
          updateScreeningContinue();
        });
      });

      // Business type free-text input
      const bizInput = document.getElementById('businessType-input');
      if (bizInput) {
        // Restore
        if (state.businessType) bizInput.value = state.businessType;
        bizInput.addEventListener('input', (e) => {
          state.businessType = e.target.value.slice(0, 80);
          saveState();
        });
      }
    }

    function updateScreeningContinue() {
      // Employees is required; revenue and business type are optional.
      const btn = document.getElementById('screening-continue');
      if (!btn) return;
      btn.disabled = state.employees === null;
    }

    // ====== Enable/disable continue buttons ======
    function updateNextEnabled() {
      categoryIds.forEach(catId => {
        const screen = document.getElementById('screen-' + catId);
        if (!screen) return;
        const qs = questionList.filter(q => q.cat === catId);
        const allAnswered = qs.every(q => typeof state.answers[q.id] === 'number');
        const nextBtn = screen.querySelector('.next-btn');
        if (nextBtn) nextBtn.disabled = !allAnswered;
      });
    }
    function updateFinishEnabled() {
      const finishBtn = document.getElementById('finish-btn');
      if (!finishBtn) return;
      finishBtn.disabled = state.manualHours === null || state.ownerHours === null;
    }

    // ====== Setup nav buttons ======
    function setupNav() {
      // "Start the Audit" → goto screening (step 1)
      const startBtn = document.getElementById('start-btn');
      if (startBtn) startBtn.addEventListener('click', () => goto(SCREENS.indexOf('screening')));

      // Generic next-btn: advance one screen
      document.querySelectorAll('.next-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          if (!btn.disabled) goto(state.step + 1);
        });
      });

      // Generic back-btn: back one screen (but never before intro)
      document.querySelectorAll('.back-btn').forEach(btn => {
        btn.addEventListener('click', () => goto(Math.max(0, state.step - 1)));
      });

      const finishBtn = document.getElementById('finish-btn');
      if (finishBtn) finishBtn.addEventListener('click', () => {
        if (finishBtn.disabled) return;
        goto(SCREENS.indexOf('analyzing'));
        runAnalyzing();
      });

      const restartBtn = document.getElementById('restart-btn');
      if (restartBtn) restartBtn.addEventListener('click', () => {
        clearState();
        state = {
          step: 0,
          answers: {},
          manualHours: null,
          ownerHours: null,
          employees: null,
          revenue: null,
          businessType: '',
        };
        document.querySelectorAll('.answer-btn, .hours-btn, .screening-btn').forEach(b => b.setAttribute('aria-checked', 'false'));
        const bizInput = document.getElementById('businessType-input');
        if (bizInput) bizInput.value = '';
        updateNextEnabled();
        updateFinishEnabled();
        updateScreeningContinue();
        goto(0);
      });
    }

    // ====== Analyzing transition ======
    function runAnalyzing() {
      const messages = [
        'Looking at your digital presence…',
        'Reviewing your sales and CRM patterns…',
        'Sizing up your customer-service signals…',
        'Checking how your operations stack runs…',
        'Estimating what this is costing you in dollars…',
      ];
      const msgEl = document.getElementById('analyzing-message');
      let i = 0;
      const interval = setInterval(() => {
        i++;
        if (i >= messages.length) { clearInterval(interval); return; }
        if (msgEl) {
          msgEl.style.opacity = '0';
          setTimeout(() => { msgEl.textContent = messages[i]; msgEl.style.opacity = '1'; }, 200);
        }
      }, 600);

      setTimeout(() => {
        renderResults();
        goto(SCREENS.indexOf('results'));
      }, 3200);
    }

    // ====== Scoring ======
    // N/A (value of -1) is skipped from the score. It does NOT count as 0.
    // Rationale: "we don't have a CRM" is a clean-slate opportunity, not a low-quality CRM.
    function scoreCategory(catId) {
      const qs = questionList.filter(q => q.cat === catId);
      const scored = qs
        .map(q => state.answers[q.id])
        .filter(v => typeof v === 'number' && v >= 1 && v <= 5);
      if (scored.length === 0) {
        // All N/A in this category — treat as 0 score (worst case, opportunity surfaced separately)
        return 0;
      }
      const sum = scored.reduce((a, b) => a + b, 0);
      return Math.round((sum / (scored.length * 5)) * 100);
    }
    function scoreOverall() {
      const scores = categoryIds.map(scoreCategory);
      return Math.round(scores.reduce((a, b) => a + b, 0) / scores.length);
    }
    function pickTier(score) {
      return TIERS.find(t => score >= t.min && score <= t.max) || TIERS[TIERS.length - 1];
    }
    function weakestCategory() {
      const scored = categoryIds.map(id => ({ id, score: scoreCategory(id) }));
      scored.sort((a, b) => a.score - b.score);
      return scored[0];
    }
    function strongestCategory() {
      const scored = categoryIds.map(id => ({ id, score: scoreCategory(id) }));
      scored.sort((a, b) => b.score - a.score);
      return scored[0];
    }
    // Returns array of {qid, label} for every question answered N/A. These get surfaced
    // in the diagnosis as "clean opportunities" — no migration friction, no entrenched habits.
    function naOpportunities() {
      return questionList
        .filter(q => q.na && state.answers[q.id] === -1)
        .map(q => ({ qid: q.id, label: q.na, cat: q.cat }));
    }
    // Cost calc V2: uses BLS Q4 2025 private-industry total compensation ($46.15/hr) for team
    // labor and a conservative $100/hr for owner time. Bracket midpoints from hoursOptionsData.
    function hiddenCost() {
      const teamMid = (hoursOptionsData[state.manualHours] || hoursOptionsData[0]).mid;
      const ownerMid = (hoursOptionsData[state.ownerHours] || hoursOptionsData[0]).mid;
      const TEAM_HOURLY = 46.15;  // BLS ECEC Q4 2025, private industry total comp
      const OWNER_HOURLY = 100;   // conservative SMB owner opportunity cost
      const team = teamMid * TEAM_HOURLY * 52;
      const owner = ownerMid * OWNER_HOURLY * 52;
      return { total: Math.round(team + owner), team: Math.round(team), owner: Math.round(owner), teamMid, ownerMid };
    }

    // ====== Diagnosis composition ======
    // These pickers SKIP N/A answers — N/A is surfaced as an opportunity, not a "low score".
    function lowestQuestionInCategory(catId) {
      const qs = questionList.filter(q => q.cat === catId);
      let idx = 0;
      let lowestScore = 6;
      qs.forEach((q, i) => {
        const v = state.answers[q.id];
        if (typeof v !== 'number' || v < 1 || v > 5) return;
        if (v < lowestScore) { lowestScore = v; idx = i; }
      });
      return idx;
    }

    function highestQuestionInCategory(catId) {
      const qs = questionList.filter(q => q.cat === catId);
      let idx = 0;
      let highestScore = 0;
      qs.forEach((q, i) => {
        const v = state.answers[q.id];
        if (typeof v !== 'number' || v < 1 || v > 5) return;
        if (v > highestScore) { highestScore = v; idx = i; }
      });
      return idx;
    }

    function pickWeakDiag(catId) {
      const meta = CAT_META[catId];
      const idx = lowestQuestionInCategory(catId);
      return meta.weakDiags[idx] || meta.weakDiags[0];
    }

    function pickStrongDiag(catId) {
      const meta = CAT_META[catId];
      const idx = highestQuestionInCategory(catId);
      return meta.strongDiags[idx] || meta.strongDiags[0];
    }

    function hoursFlavor(manualH, ownerH) {
      if (manualH >= 2 && ownerH >= 2) {
        return 'Your team is buried in manual work, and so are you. Those hours add up fast.';
      }
      if (ownerH >= 2) {
        return 'You personally are putting serious hours into operations work. That’s your most expensive labor going to the wrong tasks.';
      }
      if (manualH >= 2) {
        return 'Your team is spending real hours on copy-paste. That’s the cleanest automation target on this list.';
      }
      if (manualH === 0 && ownerH === 0) {
        return 'Your team isn’t buried in manual work, which is rare at your size. The gaps above are about effectiveness, not capacity.';
      }
      return '';
    }

    function tierIntro(score, tierName) {
      if (tierName === 'Strong') {
        if (score >= 95) return 'You’re in the top 5% of small businesses on operations health. The gaps are minor and the wins are big.';
        if (score >= 85) return 'You’re running tight. Most of what could break is already covered. The question now is which gap is worth your time, not which fire to put out.';
        return 'Solid baseline. A handful of specific improvements would push you into the rare “truly buttoned-up” tier.';
      }
      if (tierName === 'Solid') {
        return 'You’ve got real bones here. A few specific things are leaking time and money, but the foundation is healthy. Tighten the right two or three pieces and you free up real capacity.';
      }
      if (tierName === 'Gaps') {
        return 'You’ve got a real business here, but right now you’re the bottleneck on a few things you shouldn’t be. The good news is the gaps are specific and fixable.';
      }
      return 'Operations are eating your week. Don’t take that personally. Most owners hit this point as the business outgrows the way it was originally run. The fixes don’t have to be big or expensive. They have to be in the right order.';
    }

    function composeDiagnosis(overall, tier, weak, strong, second, opportunities) {
      const weakMeta = CAT_META[weak.id];
      const strongMeta = CAT_META[strong.id];

      const intro = tierIntro(overall, tier.name);

      let weakPara = `Your weakest area is <strong>${weakMeta.name} (${weak.score})</strong>: ${pickWeakDiag(weak.id)}.`;
      if (tier.name === 'Gaps' || tier.name === 'Critical') {
        weakPara += ` The owners I work with at this stage almost always say the same thing. <em>“I know something’s off, I just can’t tell you exactly what.”</em>`;
      }

      let secondPara = '';
      if (second && second.id !== weak.id && (second.score - weak.score) <= 10) {
        const secondMeta = CAT_META[second.id];
        secondPara = `<strong>${secondMeta.name}</strong> isn’t far behind at <strong>${second.score}</strong>. These two often feed each other. Fix one and the other gets cheaper.`;
      }

      // N/A opportunities — "we don't have this yet" = clean-slate wins, no migration friction
      let opportunitiesPara = '';
      if (opportunities && opportunities.length > 0) {
        const labels = opportunities.map(o => `<em>${o.label.replace(/^We /, '').replace(/\.$/, '').toLowerCase()}</em>`);
        const joined = labels.length === 1
          ? labels[0]
          : labels.length === 2
            ? `${labels[0]} and ${labels[1]}`
            : labels.slice(0, -1).join(', ') + ', and ' + labels[labels.length - 1];
        const noun = opportunities.length === 1 ? 'opportunity' : `${opportunities.length} clean opportunities`;
        opportunitiesPara = `You signaled ${noun} <strong>that don’t even show up in the score above</strong>: ${joined}. These are usually the fastest wins because there’s no migration friction, no entrenched habits, and no political pushback from someone defending the current tool.`;
      }

      const hoursLine = hoursFlavor(state.manualHours, state.ownerHours);

      let strongPara = '';
      if (strong.id !== weak.id && strong.score >= 60) {
        strongPara = `Your strongest: <strong>${strongMeta.name} (${strong.score})</strong>. ${pickStrongDiag(strong.id)}`;
      }

      const parts = [
        `<p>${intro}</p>`,
        `<p>${weakPara}</p>`,
        secondPara ? `<p>${secondPara}</p>` : '',
        opportunitiesPara ? `<p>${opportunitiesPara}</p>` : '',
        hoursLine ? `<p>${hoursLine}</p>` : '',
        strongPara ? `<p>${strongPara}</p>` : '',
      ];
      return parts.filter(Boolean).join('');
    }

    // ====== Render results ======
    function renderResults() {
      const overall = scoreOverall();
      const tier = pickTier(overall);
      const weak = weakestCategory();
      const strong = strongestCategory();
      const cost = hiddenCost();
      // Second-weakest for "close call" mentions in the diagnosis
      const sortedAsc = categoryIds.map(id => ({ id, score: scoreCategory(id) })).sort((a, b) => a.score - b.score);
      const second = sortedAsc[1] || null;

      // Animate overall score
      animateNumber(document.getElementById('overall-score'), 0, overall, 1500);

      // Tier badge
      const badgeEl = document.getElementById('tier-badge');
      if (badgeEl) {
        badgeEl.className = `inline-block px-4 py-1.5 rounded-full text-sm font-bold uppercase tracking-wider ${tier.color}`;
        badgeEl.textContent = tier.name;
      }
      const headlineEl = document.getElementById('tier-headline');
      if (headlineEl) headlineEl.textContent = tier.headline;

      // Category scores + bars
      categoryIds.forEach(catId => {
        const score = scoreCategory(catId);
        const scoreEl = document.querySelector(`.cat-score[data-cat="${catId}"]`);
        const barEl = document.querySelector(`.cat-bar[data-cat="${catId}"]`);
        if (scoreEl) animateNumber(scoreEl, 0, score, 1200);
        if (barEl) setTimeout(() => { barEl.style.width = score + '%'; }, 100);
      });

      // Hidden cost — now the LEDE of the results page, not a footnote
      const costEl = document.getElementById('hidden-cost');
      if (costEl) animateNumber(costEl, 0, cost.total, 1500, true);
      const costExp = document.getElementById('cost-explainer');
      if (costExp) {
        costExp.innerHTML = `~${cost.teamMid} hrs/wk of team manual work plus ~${cost.ownerMid} hrs/wk of your time, at defensible loaded labor costs (<a href="https://www.bls.gov/news.release/ecec.nr0.htm" target="_blank" rel="noopener" class="underline decoration-stone-400 hover:decoration-accent-500">BLS Q4 2025 private-industry total compensation</a>: $46.15/hr team, $100/hr owner). Not counting deals lost to slow follow-up or decisions made on bad data.`;
      }

      // N/A opportunities — surfaced beneath the cost
      const opportunities = naOpportunities();
      const oppEl = document.getElementById('opportunities-line');
      if (oppEl) {
        if (opportunities.length === 0) {
          oppEl.classList.add('hidden');
        } else {
          oppEl.classList.remove('hidden');
          const labels = opportunities.map(o => `<span class="font-semibold text-navy-900 dark:text-white">${o.label}</span>`);
          const joined = labels.length === 1
            ? labels[0]
            : labels.length === 2
              ? `${labels[0]} and ${labels[1]}`
              : labels.slice(0, -1).join(', ') + ', and ' + labels[labels.length - 1];
          const noun = opportunities.length === 1 ? 'a clean opportunity' : `${opportunities.length} clean opportunities`;
          oppEl.innerHTML = `Plus ${noun} that don’t show up in the dollar number above: ${joined}. These typically deliver another <span class="font-semibold text-navy-900 dark:text-white">$15–30K/year</span> in retained customers and reclaimed time, but the exact figure depends on your business.`;
        }
      }

      // Radar chart
      renderRadarChart();

      // Diagnosis
      const diagEl = document.getElementById('diagnosis-text');
      if (diagEl) diagEl.innerHTML = composeDiagnosis(overall, tier, weak, strong, second, opportunities);

      // Where to start
      const weakMeta = CAT_META[weak.id];
      const startHeadline = document.getElementById('start-headline');
      const startStepsList = document.getElementById('start-steps');
      const startLink = document.getElementById('start-link');
      const startLinkLabel = document.getElementById('start-link-label');
      if (startHeadline) startHeadline.textContent = `Start with ${weakMeta.name}.`;
      if (startStepsList) {
        startStepsList.innerHTML = (weakMeta.fixSteps || []).map((step, i) => `
          <li class="flex items-start gap-3">
            <span class="flex-shrink-0 inline-flex items-center justify-center w-7 h-7 rounded-full bg-accent-600 text-white text-sm font-bold tabular-nums">${i + 1}</span>
            <span class="pt-0.5">${step}</span>
          </li>
        `).join('');
      }
      if (startLink) startLink.href = weakMeta.serviceLink;
      if (startLinkLabel) startLinkLabel.textContent = weakMeta.serviceLabel;

      // Print-only date stamp (visible only when saving as PDF)
      const printDate = document.getElementById('print-date');
      if (printDate) {
        const now = new Date();
        printDate.textContent = 'Generated ' + now.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
      }

      // Strong-tier celebration
      if (tier.name === 'Strong') {
        setTimeout(() => triggerConfetti(), 700);
      }
    }

    function triggerConfetti() {
      if (typeof confetti === 'undefined') return;
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const colors = ['#ec6249', '#f48672', '#fcd0c8', '#102a43', '#486581'];
      // Two angled bursts from the bottom corners
      confetti({ particleCount: 60, angle: 60, spread: 70, origin: { x: 0, y: 0.9 }, colors: colors, scalar: 0.9 });
      confetti({ particleCount: 60, angle: 120, spread: 70, origin: { x: 1, y: 0.9 }, colors: colors, scalar: 0.9 });
      // A small follow-up burst from center after the first ones land
      setTimeout(() => {
        confetti({ particleCount: 40, angle: 90, spread: 100, origin: { x: 0.5, y: 0.85 }, colors: colors, scalar: 0.8 });
      }, 350);
    }

    // ====== Radar chart ======
    let chartInstance = null;
    function renderRadarChart() {
      const canvas = document.getElementById('radar-chart');
      if (!canvas || typeof Chart === 'undefined') return;

      // Destroy any previous instance (handles retake-the-audit cleanly)
      if (chartInstance) { chartInstance.destroy(); chartInstance = null; }

      const isDark = document.documentElement.classList.contains('dark');
      const labels = categoryNames;
      const data = categoryIds.map(id => scoreCategory(id));
      const gridColor = isDark ? 'rgba(255,255,255,0.10)' : 'rgba(15,23,42,0.08)';
      const textColor = isDark ? '#f5f5f4' : '#102a43';

      chartInstance = new Chart(canvas, {
        type: 'radar',
        data: {
          labels: labels,
          datasets: [{
            label: 'Score',
            data: data,
            backgroundColor: 'rgba(236, 98, 73, 0.22)',
            borderColor: 'rgba(217, 74, 51, 1)',
            borderWidth: 2,
            pointBackgroundColor: 'rgba(217, 74, 51, 1)',
            pointBorderColor: '#fff',
            pointBorderWidth: 2,
            pointRadius: 4,
            pointHoverRadius: 6,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            r: {
              beginAtZero: true,
              suggestedMin: 0,
              suggestedMax: 100,
              ticks: { stepSize: 25, display: false, backdropColor: 'transparent' },
              grid: { color: gridColor },
              angleLines: { color: gridColor },
              pointLabels: {
                color: textColor,
                font: { size: 12, weight: '600', family: '"DM Sans", system-ui, sans-serif' },
              },
            }
          },
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: { label: (ctx) => ctx.parsed.r + ' / 100' },
              backgroundColor: isDark ? 'rgba(10,31,51,0.95)' : 'rgba(16,42,67,0.95)',
              titleColor: '#fff',
              bodyColor: '#fff',
              padding: 10,
              displayColors: false,
            }
          },
          animation: {
            duration: 1400,
            easing: 'easeOutCubic',
          },
        }
      });
    }

    function animateNumber(el, from, to, duration, isCurrency = false) {
      if (!el) return;
      const start = performance.now();
      function tick(now) {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 3);
        const v = from + (to - from) * eased;
        el.textContent = isCurrency
          ? '$' + Math.round(v).toLocaleString()
          : Math.round(v).toString();
        if (t < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    // ====== Email capture (Formspree) ======
    function setupEmailForm() {
      const form = document.getElementById('email-capture-form');
      if (!form) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const errEl = document.getElementById('email-error');
        const formWrap = document.getElementById('email-form-wrap');
        const successEl = document.getElementById('email-success');
        const submitBtn = form.querySelector('button[type="submit"]');

        // Populate hidden fields with the current audit results.
        // Every signal Will would want for a sales conversation goes here.
        const overall = scoreOverall();
        const tier = pickTier(overall);
        const weak = weakestCategory();
        const strong = strongestCategory();
        const cost = hiddenCost();
        const opportunities = naOpportunities();
        const setHidden = (id, value) => {
          const el = document.getElementById(id);
          if (el) el.value = value;
        };

        // Headline metrics
        setHidden('hidden-score', String(overall) + '/100');
        setHidden('hidden-tier', tier.name);
        setHidden('hidden-cost-input', '$' + cost.total.toLocaleString() + '/year (team $' + cost.team.toLocaleString() + ' + owner $' + cost.owner.toLocaleString() + ')');

        // Category info
        setHidden('hidden-weak', CAT_META[weak.id].name + ' (' + weak.score + ')');
        setHidden('hidden-strong', CAT_META[strong.id].name + ' (' + strong.score + ')');
        const catScoresStr = categoryIds
          .map(id => CAT_META[id].name + ': ' + scoreCategory(id))
          .join(' | ');
        setHidden('hidden-cat-scores', catScoresStr);

        // N/A opportunities — the most actionable sales intel
        const oppStr = opportunities.length > 0
          ? opportunities.map(o => o.label).join(' | ')
          : '(none — they have something in every category)';
        setHidden('hidden-opportunities', oppStr);

        // Screening (lead qualification)
        const empLabel = (state.employees !== null && employeeOptionsData[state.employees])
          ? employeeOptionsData[state.employees].label + ' employees'
          : '(not provided)';
        setHidden('hidden-employees', empLabel);

        const revLabel = (state.revenue !== null && revenueOptionsData[state.revenue])
          ? revenueOptionsData[state.revenue].label
          : '(not provided)';
        setHidden('hidden-revenue', revLabel);

        setHidden('hidden-business-type', state.businessType || '(not provided)');

        // Hours
        const manualLabel = (hoursOptionsData[state.manualHours] || hoursOptionsData[0]).label;
        const ownerLabel = (hoursOptionsData[state.ownerHours] || hoursOptionsData[0]).label;
        setHidden('hidden-manual', manualLabel + ' hrs/wk');
        setHidden('hidden-owner', ownerLabel + ' hrs/wk');

        // Every individual answer (for sales follow-up reference)
        const answerLabels = { '-1': 'N/A', '1': '1 Not at all', '2': '2 A little', '3': '3 Somewhat', '4': '4 Mostly', '5': '5 Definitely' };
        const allAnswersStr = questionList.map(q => {
          const v = state.answers[q.id];
          const label = answerLabels[String(v)] || '(no answer)';
          return q.id + ' [' + q.cat + ']: ' + label;
        }).join('\n');
        setHidden('hidden-all-answers', allAnswersStr);

        // Bail with friendly error if the form ID hasn't been swapped in
        if (form.action.includes('YOUR_FORM_ID')) {
          if (errEl) {
            errEl.textContent = 'Email signup is not wired up yet. Please email william.mau@gmail.com directly.';
            errEl.classList.remove('hidden');
          }
          return;
        }

        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }
        if (errEl) errEl.classList.add('hidden');

        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { 'Accept': 'application/json' },
          });
          if (res.ok) {
            if (formWrap) formWrap.classList.add('hidden');
            if (successEl) successEl.classList.remove('hidden');
            // Trigger the print dialog so the visitor can save the page as PDF.
            // Small delay so they see the success message first.
            setTimeout(() => {
              try { window.print(); } catch (e) { /* some browsers may block; user can still Ctrl+P */ }
            }, 600);
          } else {
            throw new Error('Submission failed: ' + res.status);
          }
        } catch (err) {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg> Save my PDF';
          }
          if (errEl) {
            errEl.textContent = 'Something went wrong. Please email william.mau@gmail.com directly.';
            errEl.classList.remove('hidden');
          }
        }
      });
    }

    // ====== Lottie loader (graceful, only if JSON present) ======
    function tryLoadLottie() {
      if (typeof lottie === 'undefined') return;
      const container = document.getElementById('lottie-container');
      const fallback = document.getElementById('analyzing-fallback');
      if (!container) return;
      fetch('/audit/lottie-analyzing.json', { method: 'HEAD' })
        .then(res => {
          if (!res.ok) throw new Error('Lottie animation not found');
          lottie.loadAnimation({
            container: container,
            renderer: 'svg',
            loop: true,
            autoplay: true,
            path: '/audit/lottie-analyzing.json',
          });
          container.classList.remove('hidden');
          if (fallback) fallback.style.display = 'none';
        })
        .catch(() => { /* silently fall back to the CSS pulse */ });
    }

    // ====== Init ======
    function init() {
      loadState();
      setupAnswerButtons();
      setupHoursButtons();
      setupScreeningButtons();
      setupNav();
      updateNextEnabled();
      updateFinishEnabled();
      updateScreeningContinue();
      setupEmailForm();
      tryLoadLottie();
      // If they had a session going, resume at their step (but never resume at analyzing)
      if (state.step >= SCREENS.length) state.step = 0;
      if (SCREENS[state.step] === 'analyzing') state.step = SCREENS.indexOf('quant');
      if (SCREENS[state.step] === 'results') {
        // resume results if they had finished
        renderResults();
      }
      showScreen(SCREENS[state.step]);
      updateProgress();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</BaseLayout>
