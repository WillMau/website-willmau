---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const categories = [
  {
    id: 'marketing',
    name: 'Marketing & Digital Presence',
    blurb: 'How you get found, and how visitors become leads.',
    iconPath: 'M21 12a9 9 0 11-18 0 9 9 0 0118 0zM3.6 9h16.8M3.6 15h16.8M11.5 3a17 17 0 000 18M12.5 3a17 17 0 010 18',
  },
  {
    id: 'sales',
    name: 'Sales & Pipeline',
    blurb: 'How leads become customers, and what happens in between.',
    iconPath: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6',
  },
  {
    id: 'service',
    name: 'Customers & Service',
    blurb: 'How you keep the customers you have.',
    iconPath: 'M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6 1.87a4 4 0 100-8 4 4 0 000 8z',
  },
  {
    id: 'ops',
    name: 'Operations & Tools',
    blurb: 'How the work actually gets done, and what gets in the way.',
    iconPath: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z',
  },
  {
    id: 'money',
    name: 'Money & Time',
    blurb: 'Where the money flows, and where your time goes.',
    iconPath: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
];

const questions = [
  // Marketing & Digital Presence (3)
  { id: 'q1', cat: 'marketing', text: 'Our website turns visitors into actual leads, not just an online brochure.', na: 'We don’t have a website' },
  { id: 'q2', cat: 'marketing', text: 'Our Google Business Profile is claimed, up to date, and getting reviews.', na: 'We haven’t claimed our Google Business Profile' },
  { id: 'q3', cat: 'marketing', text: 'We can tell which marketing channels actually bring paying customers, not just clicks and likes.', na: 'We don’t do marketing yet' },

  // Sales & Pipeline (CRM) (2)
  { id: 'q4', cat: 'sales', text: 'We have a CRM and use it consistently. Every lead, every contact, every conversation lives there.', na: 'We don’t use a CRM' },
  { id: 'q5', cat: 'sales', text: 'We have a documented follow-up sequence that runs even when we’re busy.', na: 'We don’t have a follow-up sequence' },

  // Customers & Service (2)
  { id: 'q6', cat: 'service', text: 'Customer issues land in one place, not scattered across texts, voicemail, and three inboxes.' },
  { id: 'q7', cat: 'service', text: 'We can tell within a day if a customer is unhappy or at risk of leaving.' },

  // Operations & Tools (3)
  { id: 'q8', cat: 'ops', text: 'Our tools talk to each other. We’re not retyping the same info between systems.' },
  { id: 'q9', cat: 'ops', text: 'We use AI or automation to handle repetitive work where it makes sense.', na: 'We don’t use AI or automation' },
  { id: 'q10', cat: 'ops', text: 'Key processes are documented well enough that the business survives vacations and turnover.' },

  // Money & Time (2)
  { id: 'q11', cat: 'money', text: 'Invoices go out within 1–2 days of work being done.' },
  { id: 'q12', cat: 'money', text: 'I (the owner) am spending my time on the right things, not stuck in admin and email triage.' },
];

const screeningEmployeeOptions = [
  { value: 0, label: '1', mid: 1 },
  { value: 1, label: '2–5', mid: 3.5 },
  { value: 2, label: '6–15', mid: 10 },
  { value: 3, label: '16–30', mid: 23 },
  { value: 4, label: '30+', mid: 40 },
];

const screeningRevenueOptions = [
  { value: 0, label: 'Under $250K' },
  { value: 1, label: '$250K–$1M' },
  { value: 2, label: '$1M–$5M' },
  { value: 3, label: '$5M–$30M' },
  { value: 4, label: 'Prefer not to say' },
];

const answerOptions = [
  { value: 1, label: 'Not at all' },
  { value: 2, label: 'A little' },
  { value: 3, label: 'Somewhat' },
  { value: 4, label: 'Mostly' },
  { value: 5, label: 'Definitely' },
];

const hoursOptions = [
  { value: 0, label: '0–5', mid: 2.5 },
  { value: 1, label: '5–15', mid: 10 },
  { value: 2, label: '15–30', mid: 22.5 },
  { value: 3, label: '30+', mid: 35 },
];
---

<BaseLayout
  title="The Small Business Operations Self-Audit"
  description="A free 5-minute self-audit for small business owners. Twelve questions across marketing, sales, customer service, operations, and money. Instant personalized diagnosis with a real dollar estimate of what better operations could be worth to your business."
>
  <Header />

  <!-- JSON-LD: WebApplication schema for the audit -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "The Small Business Operations Self-Audit",
    "url": "https://mauops.com/audit/",
    "description": "A free 5-minute self-audit for small business owners. Twelve questions across marketing, sales, customer service, operations, and money. Instant personalized diagnosis with a dollar estimate of what better operations could be worth.",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web Browser",
    "browserRequirements": "Requires JavaScript",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "creator": {
      "@type": "Organization",
      "name": "Mau Consulting",
      "url": "https://mauops.com",
      "founder": {
        "@type": "Person",
        "name": "William Mau",
        "sameAs": "https://www.linkedin.com/in/will-mau/"
      }
    },
    "audience": {
      "@type": "Audience",
      "audienceType": "Small Business Owners"
    }
  })} />

  <main>
    <!-- ============================= -->
    <!-- HERO / INTRO SCREEN            -->
    <!-- ============================= -->
    <section class="relative overflow-hidden bg-gradient-to-br from-accent-50/40 via-white to-navy-50/30 dark:from-accent-900/10 dark:via-gray-950 dark:to-navy-950/30">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">

        <!-- Sticky progress bar (hidden until audit starts) -->
        <div
          id="progress-wrap"
          class="hidden sticky top-16 z-30 mb-8 -mt-2 transition-opacity duration-300"
        >
          <div class="max-w-3xl mx-auto bg-white/80 dark:bg-gray-900/80 backdrop-blur-md rounded-full p-1 border border-stone-200/60 dark:border-stone-800/60 shadow-sm">
            <div class="relative h-2 rounded-full bg-stone-100 dark:bg-stone-800 overflow-hidden">
              <div
                id="progress-fill"
                class="absolute inset-y-0 left-0 bg-gradient-to-r from-accent-400 to-accent-600 rounded-full transition-all duration-500 ease-out"
                style="width: 0%"
              ></div>
            </div>
            <p class="text-xs text-stone-500 dark:text-stone-400 text-center mt-2 mb-1 font-medium tabular-nums">
              <span id="progress-label">Question 0 of 16</span>
            </p>
          </div>
        </div>

        <!-- ============================= -->
        <!-- SCREEN: INTRO                  -->
        <!-- ============================= -->
        <div id="screen-intro" class="audit-screen max-w-4xl mx-auto text-center">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-semibold bg-accent-100 dark:bg-accent-900/30 text-accent-700 dark:text-accent-300 border border-accent-200/60 dark:border-accent-800/40 mb-6">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            5 minutes · 12 questions · No email required
          </span>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-navy-900 dark:text-white mb-6 leading-[1.1]">
            The Small Business<br/>
            <span class="text-accent-600 dark:text-accent-400">Operations Self-Audit.</span>
          </h1>

          <p class="text-lg sm:text-xl text-stone-600 dark:text-stone-300 max-w-2xl mx-auto mb-8 leading-relaxed">
            Twelve plain-spoken questions about how your business actually runs, plus a bit of context about your business. The moment you finish, you’ll see a real dollar estimate of what better operations could be worth, along with your weakest area and the cleanest opportunities to fix it.
          </p>

          <!-- Trust row -->
          <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-stone-500 dark:text-stone-400 mb-10">
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-4 h-4 text-accent-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              See your score first
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-4 h-4 text-accent-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              Email optional, never gates the result
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-4 h-4 text-accent-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              Built by a VP of Operations, not a marketer
            </span>
          </div>

          <button
            id="start-btn"
            class="inline-flex items-center gap-2 px-8 py-4 rounded-lg bg-accent-600 hover:bg-accent-700 text-white font-semibold text-lg shadow-lg shadow-accent-500/20 hover:shadow-xl hover:shadow-accent-500/30 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
          >
            Start the Audit
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </button>

          <p class="text-xs text-stone-400 dark:text-stone-500 mt-4">
            Your answers are saved in your browser only. Refresh-safe.
          </p>

          {/*
            UNDRAW ILLUSTRATION SLOT
            Pick one from https://undraw.co (suggestions: "growth analytics", "growing", "data trends", "report", "performance overview")
            1. Set the accent color to #ec6249 (your coral) on the undraw site before downloading
            2. Save the SVG to public/audit/illustration.svg
            3. Uncomment the <img> below
          */}
          {/*
          <div class="mt-12 max-w-md mx-auto">
            <img src="/audit/illustration.svg" alt="Operations audit" class="w-full h-auto" />
          </div>
          */}

          <!-- Category preview -->
          <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mt-16 max-w-4xl mx-auto">
            {categories.map((cat, idx) => (
              <div class="text-center">
                <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-white dark:bg-stone-900/60 border border-stone-200 dark:border-stone-800 text-accent-600 dark:text-accent-400 shadow-sm mb-3">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={cat.iconPath}/></svg>
                </div>
                <p class="text-xs sm:text-sm font-semibold text-navy-900 dark:text-white">{cat.name}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- ============================= -->
        <!-- SCREEN: SCREENING (3 Qs)      -->
        <!-- ============================= -->
        <div id="screen-screening" class="audit-screen hidden max-w-3xl mx-auto">
          <div class="text-center mb-10">
            <p class="text-sm font-semibold uppercase tracking-wide text-accent-600 dark:text-accent-400 mb-2">Quick context first</p>
            <h2 class="text-3xl sm:text-4xl font-bold text-navy-900 dark:text-white mb-2">
              Tell us about your business
            </h2>
            <p class="text-stone-500 dark:text-stone-400">So we can make the diagnosis specific to you, not generic.</p>
          </div>

          <div class="space-y-6">
            <!-- Employees -->
            <div class="rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900/40 p-6 sm:p-7 shadow-sm">
              <p class="text-base sm:text-lg text-navy-900 dark:text-white font-medium mb-5 leading-snug">
                How many employees?
              </p>
              <div class="grid grid-cols-5 gap-2" role="radiogroup" aria-label="Number of employees">
                {screeningEmployeeOptions.map((opt) => (
                  <button
                    type="button"
                    class="screening-btn rounded-xl border border-stone-200 dark:border-stone-700 bg-stone-50/50 dark:bg-stone-800/40 hover:border-accent-400 dark:hover:border-accent-500 hover:bg-accent-50/50 dark:hover:bg-accent-900/20 px-2 py-4 text-center transition-all duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-950"
                    data-key="employees"
                    data-value={opt.value}
                    role="radio"
                    aria-checked="false"
                  >
                    <span class="block text-base sm:text-lg font-bold text-navy-900 dark:text-white tabular-nums leading-none">{opt.label}</span>
                  </button>
                ))}
              </div>
            </div>

            <!-- Revenue (optional) -->
            <div class="rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900/40 p-6 sm:p-7 shadow-sm">
              <p class="text-base sm:text-lg text-navy-900 dark:text-white font-medium mb-2 leading-snug">
                Roughly your annual revenue?
              </p>
              <p class="text-xs text-stone-500 dark:text-stone-400 mb-5">Optional, helps tailor the diagnosis.</p>
              <div class="grid grid-cols-2 sm:grid-cols-5 gap-2" role="radiogroup" aria-label="Annual revenue range">
                {screeningRevenueOptions.map((opt) => (
                  <button
                    type="button"
                    class="screening-btn rounded-xl border border-stone-200 dark:border-stone-700 bg-stone-50/50 dark:bg-stone-800/40 hover:border-accent-400 dark:hover:border-accent-500 hover:bg-accent-50/50 dark:hover:bg-accent-900/20 px-2 py-3 text-center transition-all duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-950"
                    data-key="revenue"
                    data-value={opt.value}
                    role="radio"
                    aria-checked="false"
                  >
                    <span class="block text-xs sm:text-sm font-semibold text-navy-900 dark:text-white leading-tight">{opt.label}</span>
                  </button>
                ))}
              </div>
            </div>

            <!-- Business type (optional) -->
            <div class="rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900/40 p-6 sm:p-7 shadow-sm">
              <p class="text-base sm:text-lg text-navy-900 dark:text-white font-medium mb-2 leading-snug">
                What kind of business?
              </p>
              <p class="text-xs text-stone-500 dark:text-stone-400 mb-5">Optional. Example: "B2B services," "ecommerce," "professional services."</p>
              <input
                type="text"
                id="businessType-input"
                placeholder="What kind of business?"
                class="w-full px-4 py-3 rounded-lg border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-800/40 text-navy-900 dark:text-white placeholder-stone-400 dark:placeholder-stone-500 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-accent-500 transition-all"
                maxlength="80"
              />
            </div>
          </div>

          <div class="flex items-center justify-between mt-10">
            <button
              type="button"
              class="back-btn inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-stone-600 dark:text-stone-400 hover:text-navy-900 dark:hover:text-white transition-colors"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
              Back
            </button>
            <button
              type="button"
              id="screening-continue"
              class="next-btn inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-accent-600 hover:bg-accent-700 disabled:bg-stone-300 dark:disabled:bg-stone-700 disabled:cursor-not-allowed disabled:shadow-none text-white font-semibold shadow-lg shadow-accent-500/20 hover:shadow-xl hover:shadow-accent-500/30 hover:-translate-y-0.5 active:translate-y-0 disabled:translate-y-0 transition-all duration-200"
              disabled
            >
              Continue to the audit
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </button>
          </div>
        </div>

        <!-- ============================= -->
        <!-- SCREEN: CATEGORY QUESTIONS    -->
        <!-- (one screen rendered per cat) -->
        <!-- ============================= -->
        {categories.map((cat, catIdx) => (
          <div id={`screen-${cat.id}`} class="audit-screen hidden max-w-3xl mx-auto" data-cat={cat.id} data-catidx={catIdx}>
            <div class="text-center mb-10">
              <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-accent-500 to-accent-600 text-white shadow-lg shadow-accent-500/20 mb-4">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={cat.iconPath}/></svg>
              </div>
              <p class="text-sm font-semibold uppercase tracking-wide text-accent-600 dark:text-accent-400 mb-2">
                Category {catIdx + 1} of {categories.length}
              </p>
              <h2 class="text-3xl sm:text-4xl font-bold text-navy-900 dark:text-white mb-2">
                {cat.name}
              </h2>
              <p class="text-stone-500 dark:text-stone-400">{cat.blurb}</p>
            </div>

            <div class="space-y-6">
              {questions.filter(q => q.cat === cat.id).map((q) => (
                <div class="rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900/40 p-6 sm:p-7 shadow-sm hover:shadow-md transition-shadow">
                  <p class="text-base sm:text-lg text-navy-900 dark:text-white font-medium mb-5 leading-snug">
                    {q.text}
                  </p>
                  <div role="radiogroup" aria-label={q.text}>
                    <div class="grid grid-cols-5 gap-2">
                      {answerOptions.map((opt) => (
                        <button
                          type="button"
                          class="answer-btn group relative rounded-xl border border-stone-200 dark:border-stone-700 bg-stone-50/50 dark:bg-stone-800/40 hover:border-accent-400 dark:hover:border-accent-500 hover:bg-accent-50/50 dark:hover:bg-accent-900/20 px-2 py-3 text-center transition-all duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-950"
                          data-qid={q.id}
                          data-value={opt.value}
                          role="radio"
                          aria-checked="false"
                        >
                          <span class="block text-lg sm:text-xl font-bold text-navy-900 dark:text-white tabular-nums leading-none mb-1">{opt.value}</span>
                          <span class="block text-[10px] sm:text-xs text-stone-500 dark:text-stone-400 font-medium leading-tight">{opt.label}</span>
                        </button>
                      ))}
                    </div>
                    {q.na && (
                      <button
                        type="button"
                        class="answer-btn na-btn mt-3 w-full rounded-xl border border-dashed border-stone-300 dark:border-stone-700 bg-transparent hover:border-accent-400 hover:bg-accent-50/40 dark:hover:bg-accent-900/10 px-4 py-2.5 text-sm text-stone-600 dark:text-stone-400 hover:text-accent-700 dark:hover:text-accent-300 transition-all duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-950"
                        data-qid={q.id}
                        data-value="-1"
                        data-na-label={q.na}
                        role="radio"
                        aria-checked="false"
                      >
                        {q.na}
                      </button>
                    )}
                  </div>
                </div>
              ))}
            </div>

            <div class="flex items-center justify-between mt-10">
              <button
                type="button"
                class="back-btn inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-stone-600 dark:text-stone-400 hover:text-navy-900 dark:hover:text-white transition-colors"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                Back
              </button>
              <button
                type="button"
                class="next-btn inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-accent-600 hover:bg-accent-700 disabled:bg-stone-300 dark:disabled:bg-stone-700 disabled:cursor-not-allowed disabled:shadow-none text-white font-semibold shadow-lg shadow-accent-500/20 hover:shadow-xl hover:shadow-accent-500/30 hover:-translate-y-0.5 active:translate-y-0 disabled:translate-y-0 transition-all duration-200"
                disabled
              >
                <span class="next-label">Continue</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
              </button>
            </div>
          </div>
        ))}

        <!-- ============================= -->
        <!-- SCREEN: QUANT (hours)         -->
        <!-- ============================= -->
        <div id="screen-quant" class="audit-screen hidden max-w-3xl mx-auto">
          <div class="text-center mb-10">
            <p class="text-sm font-semibold uppercase tracking-wide text-accent-600 dark:text-accent-400 mb-2">Almost done</p>
            <h2 class="text-3xl sm:text-4xl font-bold text-navy-900 dark:text-white mb-2">
              Two quick numbers
            </h2>
            <p class="text-stone-500 dark:text-stone-400">So we can estimate what this is costing you.</p>
          </div>

          <div class="space-y-6">
