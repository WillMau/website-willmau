      box-shadow: 0 4px 12px -2px rgb(236 98 73 / 0.4);
    }
    .answer-btn[aria-checked="true"] span,
    .hours-btn[aria-checked="true"] span,
    .screening-btn[aria-checked="true"] span {
      color: white;
    }
    @media (prefers-reduced-motion: reduce) {
      .audit-screen { animation: none; }
    }

    /* Editorial drop cap on the first paragraph of the diagnosis */
    .diagnosis-prose > p {
      line-height: 1.75;
      margin-bottom: 1.25rem;
    }
    .diagnosis-prose > p:first-of-type::first-letter {
      font-family: "DM Sans", system-ui, sans-serif;
      font-size: 3.75rem;
      line-height: 0.85;
      font-weight: 700;
      float: left;
      padding-right: 0.625rem;
      margin-top: 0.25rem;
      color: rgb(217 74 51); /* accent-600 */
    }
    .dark .diagnosis-prose > p:first-of-type::first-letter {
      color: rgb(244 134 114); /* accent-400 */
    }
    /* Avoid drop cap breaking on very short first paragraphs */
    @media (max-width: 480px) {
      .diagnosis-prose > p:first-of-type::first-letter {
        font-size: 3rem;
        padding-right: 0.5rem;
      }
    }

    /* Print-only elements default to hidden on screen */
    .print-only { display: none; }

    /* ============================ */
    /* PRINT STYLES (Save as PDF)   */
    /* Compact one-page layout      */
    /* ============================ */
    @media print {
      @page { size: letter; margin: 0.4in; }

      html, body {
        background: #ffffff !important;
        color: #102a43 !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
        font-family: "DM Sans", system-ui, sans-serif;
      }

      /* Hide site chrome and non-results screens */
      header, footer, #site-header, #progress-wrap { display: none !important; }
      .audit-screen:not(#screen-results) { display: none !important; }
