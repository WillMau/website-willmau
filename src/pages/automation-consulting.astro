          <h3 class="text-lg font-semibold text-navy-900 dark:text-white mb-2">{phase.title}</h3>
          <p class="text-sm text-stone-600 dark:text-stone-400">{phase.desc}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- FAQ -->
  <Section class="bg-white dark:bg-gray-950" title="Frequently Asked Questions">
    <div class="max-w-3xl mx-auto space-y-3">
      {faqs.map(faq => (
        <details class="group rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900/60 overflow-hidden">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-navy-900 dark:text-white font-medium hover:bg-stone-50/50 dark:hover:bg-stone-800/30 transition-colors list-none [&::-webkit-details-marker]:hidden">
            <span>{faq.question}</span>
            <svg class="w-5 h-5 text-stone-400 group-open:rotate-180 transition-transform duration-200 flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-6 pb-5 text-sm text-stone-500 dark:text-stone-400 leading-relaxed">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </Section>

  <!-- CTA -->
  <section class="py-16 sm:py-24 bg-navy-900 dark:bg-navy-950">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">Ready to untangle your processes?</h2>
        <p class="text-xl text-navy-200 mb-8">
          Free 30-minute call. I will listen to how things work today, identify the biggest bottlenecks, and tell you exactly what I would recommend.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <Button href="/contact?service=automation&source=automation-consulting" variant="primary" size="lg">Book a Free Process Review</Button>
          <Button href="/" variant="outline" size="lg" class="border-white text-white hover:bg-white/10">Back to Home</Button>
        </div>
      </div>
    </div>
  </section>
  </main>

  <Footer />
</BaseLayout>
