  <script>
    const tabs = document.querySelectorAll('.scenario-tab');
    const panels = document.querySelectorAll('.scenario-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = (tab as HTMLElement).dataset.tab;

        // Update tab styles
        tabs.forEach(t => {
          t.classList.remove('active-tab', 'bg-accent-600', 'text-white', 'border-accent-300');
          t.classList.add('bg-white', 'dark:bg-stone-800', 'text-stone-600', 'dark:text-stone-300', 'border-stone-300', 'dark:border-stone-700');
        });
        tab.classList.add('active-tab', 'bg-accent-600', 'text-white', 'border-accent-300');
        tab.classList.remove('bg-white', 'dark:bg-stone-800', 'text-stone-600', 'dark:text-stone-300', 'border-stone-300', 'dark:border-stone-700');

        // Show/hide panels
        panels.forEach(panel => {
          if ((panel as HTMLElement).id === `tab-${target}`) {
            panel.classList.remove('hidden');
          } else {
            panel.classList.add('hidden');
          }
        });
      });
    });
  </script>

