---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import NetworkBackground from '../components/NetworkBackground.astro';
import StatCard from '../components/StatCard.astro';
import Badge from '../components/Badge.astro';
---

<BaseLayout
  title="Process Automation Consulting | Zapier, Power Automate & Workflow Optimization"
  description="Business process automation consulting. Zapier, Power Automate, custom workflows. Eliminate manual tasks and increase efficiency."
>
  <Header />

  <main>
  <section class="relative overflow-hidden py-16 sm:py-24 bg-gradient-to-br from-green-50 via-emerald-50 to-teal-50 dark:from-gray-900 dark:via-green-950 dark:to-teal-950">
    <NetworkBackground density="normal" opacity={0.5} />

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <Badge variant="success" class="mb-4">
          <svg class="w-4 h-4 inline-block mr-1" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" />
          </svg>
          Efficiency & Automation Expert
        </Badge>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-gray-900 dark:text-white mb-6 animate-fade-in-up">
          Stop Doing Manual Work<br />That Software Can Do
        </h1>

        <p class="text-xl sm:text-2xl text-gray-600 dark:text-gray-300 mb-8 animate-delay-100">
          Custom automation workflows that save hours per week. Zapier, Power Automate, and API integrations that actually work.
        </p>

        <div class="flex flex-wrap gap-4 justify-center animate-delay-200">
          <Button href="/contact?service=automation" variant="primary" size="lg">
            Request Automation Audit
          </Button>
          <Button href="/portfolio" variant="outline" size="lg">
            See Examples
          </Button>
        </div>
      </div>
    </div>
  </section>

  <Section class="bg-white dark:bg-gray-900">
    <h2 class="text-3xl font-bold text-center mb-12">Proven Time Savings</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <StatCard value="15hrs" label="Average Weekly Time Saved" color="green" />
      <StatCard value="10x" label="Productivity Increase" trend="up" color="blue" />
      <StatCard value="87%" label="Manual Tasks Eliminated" trend="down" color="purple" />
    </div>
  </Section>

  <Section title="What I Automate" subtitle="Common workflows I build for clients">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {[
        { title: 'CRM Automation', desc: 'Lead routing, data entry, follow-up sequences, status updates', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z' },
        { title: 'Email Workflows', desc: 'Automated responses, email parsing, attachment handling, notifications', icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
        { title: 'Data Sync', desc: 'Keep data in sync between systems (Salesforce ↔ Google Sheets ↔ Slack)', icon: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15' },
        { title: 'Document Generation', desc: 'Auto-create PDFs, contracts, invoices from templates', icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
        { title: 'Form Processing', desc: 'Intake forms → CRM, notifications, task creation, approvals', icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
        { title: 'Notification Systems', desc: 'Slack alerts, SMS notifications, custom webhooks', icon: 'M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9' }
      ].map(item => (
        <Card shimmer={true}>
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-green-500 to-emerald-500 rounded-xl flex items-center justify-center text-white shadow-lg">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">{item.title}</h3>
              <p class="text-sm text-gray-600 dark:text-gray-400">{item.desc}</p>
            </div>
          </div>
        </Card>
      ))}
    </div>
  </Section>

  <Section class="bg-gray-50 dark:bg-gray-800" title="Pricing" subtitle="Fixed-scope automation projects">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {[
        { name: 'Simple Workflow', price: '$750', duration: '3-5 days', features: ['1-2 app integration', 'Basic logic', 'Testing & documentation', '30 days support'] },
        { name: 'Complex Automation', price: '$2,500', duration: '1-2 weeks', features: ['Multi-step workflows', '3-5 app integrations', 'Conditional logic', 'Error handling', 'Full documentation', '60 days support'] },
        { name: 'Enterprise Suite', price: 'Custom', duration: '2-4 weeks', features: ['Multiple workflows', 'API development', 'Custom integrations', 'Training', 'Ongoing support available'] }
      ].map(pkg => (
        <Card class="h-full flex flex-col">
          <div class="flex-1">
            <h3 class="text-2xl font-bold mb-2">{pkg.name}</h3>
            <div class="text-3xl font-bold text-green-600 dark:text-green-400 mb-2">{pkg.price}</div>
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">{pkg.duration}</p>
            <ul class="space-y-2">
              {pkg.features.map(f => (
                <li class="flex items-start gap-2 text-sm">
                  <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  <span class="text-gray-600 dark:text-gray-400">{f}</span>
                </li>
              ))}
            </ul>
          </div>
          <Button href="/contact?service=automation" variant="primary" class="w-full mt-6">Get Started</Button>
        </Card>
      ))}
    </div>
  </Section>

  <Section class="relative overflow-hidden bg-gradient-to-br from-green-50/50 via-emerald-50/50 to-teal-50/50 dark:from-gray-900/50 dark:via-green-950/50 dark:to-teal-950/50">
    <NetworkBackground density="sparse" opacity={0.4} />
    <div class="relative z-10 text-center max-w-3xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold mb-6">Ready to Automate Your Workflows?</h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 mb-8">
        Free consultation to identify automation opportunities in your business.
      </p>
      <Button href="/contact?service=automation" variant="primary" size="lg">Schedule Free Consultation</Button>
    </div>
  </Section>
  </main>

  <Footer />
</BaseLayout>
