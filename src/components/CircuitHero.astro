---
/**
 * CircuitHero: An animated circuit board SVG that draws itself on page load.
 *
 * A central hub connects to 5 service nodes via animated PCB traces.
 * Each trace draws in sequentially, nodes glow on arrival, and data-flow
 * dots pulse along the paths continuously.
 *
 * Pure SVG + CSS animations. Zero JavaScript. Zero dependencies.
 */
---

<div class="relative w-full max-w-4xl mx-auto select-none" aria-hidden="true">
  <svg
    viewBox="0 0 900 500"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-auto"
    style="filter: drop-shadow(0 0 40px rgba(16,185,129,0.08));"
  >
    <defs>
      <!-- Trace glow -->
      <filter id="ch-glow">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <!-- Node glow (stronger) -->
      <filter id="ch-node-glow">
        <feGaussianBlur stdDeviation="6" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <!-- Gradient for main traces -->
      <linearGradient id="ch-trace" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#1ab893" />
        <stop offset="100%" stop-color="#3dcfab" />
      </linearGradient>

      <!-- Accent blue gradient for secondary traces -->
      <linearGradient id="ch-trace-blue" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#2563EB" />
        <stop offset="100%" stop-color="#60A5FA" />
      </linearGradient>
    </defs>

    <!-- ======================================= -->
    <!-- Background grid (subtle, static)         -->
    <!-- ======================================= -->
    <g class="text-slate-200 dark:text-slate-800" opacity="0.4">
      {/* Horizontal lines */}
      <line x1="0" y1="100" x2="900" y2="100" stroke="currentColor" stroke-width="0.3" />
      <line x1="0" y1="200" x2="900" y2="200" stroke="currentColor" stroke-width="0.3" />
      <line x1="0" y1="300" x2="900" y2="300" stroke="currentColor" stroke-width="0.3" />
      <line x1="0" y1="400" x2="900" y2="400" stroke="currentColor" stroke-width="0.3" />
      {/* Vertical lines */}
      <line x1="180" y1="0" x2="180" y2="500" stroke="currentColor" stroke-width="0.3" />
      <line x1="360" y1="0" x2="360" y2="500" stroke="currentColor" stroke-width="0.3" />
      <line x1="540" y1="0" x2="540" y2="500" stroke="currentColor" stroke-width="0.3" />
      <line x1="720" y1="0" x2="720" y2="500" stroke="currentColor" stroke-width="0.3" />
    </g>

    <!-- ======================================= -->
    <!-- Decorative components (IC chips, vias)   -->
    <!-- ======================================= -->
    <g opacity="0.15">
      {/* Small IC chip shapes */}
      <rect x="120" y="92" width="24" height="16" rx="2" stroke="#1ab893" stroke-width="0.8" />
      <line x1="120" y1="97" x2="115" y2="97" stroke="#1ab893" stroke-width="0.6" />
      <line x1="120" y1="103" x2="115" y2="103" stroke="#1ab893" stroke-width="0.6" />
      <line x1="144" y1="97" x2="149" y2="97" stroke="#1ab893" stroke-width="0.6" />
      <line x1="144" y1="103" x2="149" y2="103" stroke="#1ab893" stroke-width="0.6" />

      <rect x="680" y="392" width="20" height="14" rx="2" stroke="#1ab893" stroke-width="0.8" />
      <line x1="680" y1="396" x2="676" y2="396" stroke="#1ab893" stroke-width="0.6" />
      <line x1="680" y1="402" x2="676" y2="402" stroke="#1ab893" stroke-width="0.6" />
      <line x1="700" y1="396" x2="704" y2="396" stroke="#1ab893" stroke-width="0.6" />
      <line x1="700" y1="402" x2="704" y2="402" stroke="#1ab893" stroke-width="0.6" />

      <rect x="290" y="370" width="18" height="12" rx="1.5" stroke="#1ab893" stroke-width="0.7" />

      {/* Via holes */}
      <circle cx="240" cy="160" r="3" stroke="#1ab893" stroke-width="0.6" />
      <circle cx="240" cy="160" r="1" fill="#1ab893" />
      <circle cx="660" cy="140" r="3" stroke="#1ab893" stroke-width="0.6" />
      <circle cx="660" cy="140" r="1" fill="#1ab893" />
      <circle cx="500" cy="380" r="3" stroke="#1ab893" stroke-width="0.6" />
      <circle cx="500" cy="380" r="1" fill="#1ab893" />
      <circle cx="180" cy="340" r="3" stroke="#1ab893" stroke-width="0.6" />
      <circle cx="180" cy="340" r="1" fill="#1ab893" />
      <circle cx="780" cy="260" r="3" stroke="#1ab893" stroke-width="0.6" />
      <circle cx="780" cy="260" r="1" fill="#1ab893" />
    </g>

    <!-- ======================================= -->
    <!-- ANIMATED TRACES (draw-in on load)        -->
    <!-- ======================================= -->

    {/* --- Hub to Salesforce (top-left) --- */}
    <path
      d="M450,250 L450,200 L350,200 L350,130 L200,130"
      stroke="url(#ch-trace)"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      filter="url(#ch-glow)"
      stroke-dasharray="400"
      stroke-dashoffset="400"
      class="circuit-trace"
      style="animation: trace-draw 1.5s ease-out 0.3s forwards;"
    />
    {/* Corner dots */}
    <circle cx="350" cy="200" r="2" fill="#1ab893" opacity="0" class="circuit-dot" style="animation: dot-appear 0.3s ease-out 1.0s forwards;" />
    <circle cx="350" cy="130" r="2" fill="#1ab893" opacity="0" class="circuit-dot" style="animation: dot-appear 0.3s ease-out 1.2s forwards;" />

    {/* --- Hub to Automation (top-right) --- */}
    <path
      d="M450,250 L450,200 L550,200 L550,130 L700,130"
      stroke="url(#ch-trace)"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      filter="url(#ch-glow)"
      stroke-dasharray="400"
      stroke-dashoffset="400"
      class="circuit-trace"
      style="animation: trace-draw 1.5s ease-out 0.6s forwards;"
    />
    <circle cx="550" cy="200" r="2" fill="#1ab893" opacity="0" class="circuit-dot" style="animation: dot-appear 0.3s ease-out 1.3s forwards;" />
    <circle cx="550" cy="130" r="2" fill="#1ab893" opacity="0" class="circuit-dot" style="animation: dot-appear 0.3s ease-out 1.5s forwards;" />

    {/* --- Hub to Websites (bottom-left) --- */}
    <path
      d="M450,250 L450,310 L320,310 L320,380 L170,380"
      stroke="url(#ch-trace)"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      filter="url(#ch-glow)"
      stroke-dasharray="420"
      stroke-dashoffset="420"
      class="circuit-trace"
      style="animation: trace-draw 1.5s ease-out 0.9s forwards;"
    />
    <circle cx="320" cy="310" r="2" fill="#1ab893" opacity="0" class="circuit-dot" style="animation: dot-appear 0.3s ease-out 1.6s forwards;" />
    <circle cx="320" cy="380" r="2" fill="#1ab893" opacity="0" class="circuit-dot" style="animation: dot-appear 0.3s ease-out 1.8s forwards;" />

    {/* --- Hub to AI (bottom-right) --- */}
    <path
      d="M450,250 L450,310 L580,310 L580,380 L730,380"
      stroke="url(#ch-trace-blue)"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      filter="url(#ch-glow)"
      stroke-dasharray="420"
      stroke-dashoffset="420"
      class="circuit-trace"
      style="animation: trace-draw 1.5s ease-out 1.2s forwards;"
    />
    <circle cx="580" cy="310" r="2" fill="#2563EB" opacity="0" class="circuit-dot" style="animation: dot-appear 0.3s ease-out 1.9s forwards;" />
    <circle cx="580" cy="380" r="2" fill="#2563EB" opacity="0" class="circuit-dot" style="animation: dot-appear 0.3s ease-out 2.1s forwards;" />

    {/* --- Hub to Tech Strategy (right) --- */}
    <path
      d="M450,250 L560,250 L560,250 L750,250"
      stroke="url(#ch-trace)"
      stroke-width="1.5"
      stroke-linecap="round"
      filter="url(#ch-glow)"
      stroke-dasharray="300"
      stroke-dashoffset="300"
      class="circuit-trace"
      style="animation: trace-draw 1.2s ease-out 1.5s forwards;"
    />

    <!-- ======================================= -->
    <!-- DATA FLOW PULSES (continuous)            -->
    <!-- ======================================= -->
    <circle r="3" fill="#3dcfab" filter="url(#ch-glow)" opacity="0" style="animation: dot-appear 0.3s ease-out 2.5s forwards;">
      <animateMotion dur="3s" begin="2.5s" repeatCount="indefinite" path="M450,250 L450,200 L350,200 L350,130 L200,130" />
    </circle>
    <circle r="3" fill="#3dcfab" filter="url(#ch-glow)" opacity="0" style="animation: dot-appear 0.3s ease-out 3.0s forwards;">
      <animateMotion dur="3.5s" begin="3.0s" repeatCount="indefinite" path="M450,250 L450,200 L550,200 L550,130 L700,130" />
    </circle>
    <circle r="2.5" fill="#3dcfab" filter="url(#ch-glow)" opacity="0" style="animation: dot-appear 0.3s ease-out 3.5s forwards;">
      <animateMotion dur="3.2s" begin="3.5s" repeatCount="indefinite" path="M450,250 L450,310 L320,310 L320,380 L170,380" />
    </circle>
    <circle r="2.5" fill="#60A5FA" filter="url(#ch-glow)" opacity="0" style="animation: dot-appear 0.3s ease-out 4.0s forwards;">
      <animateMotion dur="3.8s" begin="4.0s" repeatCount="indefinite" path="M450,250 L450,310 L580,310 L580,380 L730,380" />
    </circle>
    <circle r="2" fill="#3dcfab" filter="url(#ch-glow)" opacity="0" style="animation: dot-appear 0.3s ease-out 3.2s forwards;">
      <animateMotion dur="2.5s" begin="3.2s" repeatCount="indefinite" path="M450,250 L560,250 L750,250" />
    </circle>

    <!-- ======================================= -->
    <!-- SERVICE NODES (appear after traces)      -->
    <!-- ======================================= -->

    {/* --- Salesforce node (top-left) --- */}
    <g opacity="0" style="animation: node-appear 0.5s ease-out 1.8s forwards;">
      <circle cx="170" cy="130" r="28" fill="#1ab893" fill-opacity="0.1" filter="url(#ch-node-glow)" class="dark:fill-opacity-[0.15]" />
      <circle cx="170" cy="130" r="20" class="fill-white dark:fill-slate-900" stroke="#1ab893" stroke-width="2" />
      {/* SF cloud icon */}
      <path d="M162,133 a5,5 0 0 1 5,-5 a4,4 0 0 1 7,1 a4,4 0 0 1 3,-1 a4,4 0 0 1 2,7 h-16 a3,3 0 0 1 -1,-2z" fill="#1ab893" />
      <text x="170" y="165" text-anchor="middle" class="fill-slate-700 dark:fill-slate-300" font-size="11" font-weight="600" font-family="system-ui">Salesforce</text>
      <text x="170" y="178" text-anchor="middle" class="fill-slate-400 dark:fill-slate-500" font-size="9" font-family="ui-monospace, monospace">CRM + RevOps</text>
    </g>

    {/* --- Automation node (top-right) --- */}
    <g opacity="0" style="animation: node-appear 0.5s ease-out 2.1s forwards;">
      <circle cx="730" cy="130" r="28" fill="#1ab893" fill-opacity="0.1" filter="url(#ch-node-glow)" class="dark:fill-opacity-[0.15]" />
      <circle cx="730" cy="130" r="20" class="fill-white dark:fill-slate-900" stroke="#1ab893" stroke-width="2" />
      {/* Lightning bolt icon */}
      <path d="M727,122 l5,0 l-2,6 l5,0 l-7,10 l2,-7 l-5,0 z" fill="#1ab893" />
      <text x="730" y="165" text-anchor="middle" class="fill-slate-700 dark:fill-slate-300" font-size="11" font-weight="600" font-family="system-ui">Automation</text>
      <text x="730" y="178" text-anchor="middle" class="fill-slate-400 dark:fill-slate-500" font-size="9" font-family="ui-monospace, monospace">Workflows + APIs</text>
    </g>

    {/* --- Websites node (bottom-left) --- */}
    <g opacity="0" style="animation: node-appear 0.5s ease-out 2.4s forwards;">
      <circle cx="140" cy="380" r="28" fill="#1ab893" fill-opacity="0.1" filter="url(#ch-node-glow)" class="dark:fill-opacity-[0.15]" />
      <circle cx="140" cy="380" r="20" class="fill-white dark:fill-slate-900" stroke="#1ab893" stroke-width="2" />
      {/* Globe icon */}
      <circle cx="140" cy="380" r="7" fill="none" stroke="#1ab893" stroke-width="1.5" />
      <ellipse cx="140" cy="380" rx="3.5" ry="7" fill="none" stroke="#1ab893" stroke-width="1" />
      <line x1="133" y1="380" x2="147" y2="380" stroke="#1ab893" stroke-width="1" />
      <text x="140" y="415" text-anchor="middle" class="fill-slate-700 dark:fill-slate-300" font-size="11" font-weight="600" font-family="system-ui">Websites</text>
      <text x="140" y="428" text-anchor="middle" class="fill-slate-400 dark:fill-slate-500" font-size="9" font-family="ui-monospace, monospace">Design + Dev</text>
    </g>

    {/* --- AI node (bottom-right) --- */}
    <g opacity="0" style="animation: node-appear 0.5s ease-out 2.7s forwards;">
      <circle cx="760" cy="380" r="28" fill="#2563EB" fill-opacity="0.1" filter="url(#ch-node-glow)" class="dark:fill-opacity-[0.15]" />
      <circle cx="760" cy="380" r="20" class="fill-white dark:fill-slate-900" stroke="#2563EB" stroke-width="2" />
      {/* Chip/brain icon */}
      <rect x="753" y="373" width="14" height="14" rx="2" fill="none" stroke="#2563EB" stroke-width="1.5" />
      <line x1="756" y1="373" x2="756" y2="370" stroke="#2563EB" stroke-width="1" />
      <line x1="760" y1="373" x2="760" y2="370" stroke="#2563EB" stroke-width="1" />
      <line x1="764" y1="373" x2="764" y2="370" stroke="#2563EB" stroke-width="1" />
      <line x1="756" y1="387" x2="756" y2="390" stroke="#2563EB" stroke-width="1" />
      <line x1="760" y1="387" x2="760" y2="390" stroke="#2563EB" stroke-width="1" />
      <line x1="764" y1="387" x2="764" y2="390" stroke="#2563EB" stroke-width="1" />
      <text x="760" y="415" text-anchor="middle" class="fill-slate-700 dark:fill-slate-300" font-size="11" font-weight="600" font-family="system-ui">AI</text>
      <text x="760" y="428" text-anchor="middle" class="fill-slate-400 dark:fill-slate-500" font-size="9" font-family="ui-monospace, monospace">GPT + Agents</text>
    </g>

    {/* --- Tech Strategy node (right) --- */}
    <g opacity="0" style="animation: node-appear 0.5s ease-out 3.0s forwards;">
      <circle cx="780" cy="250" r="28" fill="#1ab893" fill-opacity="0.1" filter="url(#ch-node-glow)" class="dark:fill-opacity-[0.15]" />
      <circle cx="780" cy="250" r="20" class="fill-white dark:fill-slate-900" stroke="#1ab893" stroke-width="2" />
      {/* Gear/settings icon */}
      <circle cx="780" cy="250" r="4" fill="none" stroke="#1ab893" stroke-width="1.5" />
      <circle cx="780" cy="250" r="8" fill="none" stroke="#1ab893" stroke-width="1" stroke-dasharray="3 3" />
      <text x="780" y="285" text-anchor="middle" class="fill-slate-700 dark:fill-slate-300" font-size="11" font-weight="600" font-family="system-ui">Tech Stack</text>
      <text x="780" y="298" text-anchor="middle" class="fill-slate-400 dark:fill-slate-500" font-size="9" font-family="ui-monospace, monospace">Strategy + Ops</text>
    </g>

    <!-- ======================================= -->
    <!-- CENTRAL HUB (appears first)              -->
    <!-- ======================================= -->
    <g opacity="0" style="animation: node-appear 0.6s ease-out 0.1s forwards;">
      {/* Outer ring glow */}
      <circle cx="450" cy="250" r="44" fill="#1ab893" fill-opacity="0.06" filter="url(#ch-node-glow)" />
      <circle cx="450" cy="250" r="36" fill="#1ab893" fill-opacity="0.08" />
      {/* Main circle */}
      <circle cx="450" cy="250" r="28" class="fill-white dark:fill-slate-900" stroke="#1ab893" stroke-width="2.5" />
      {/* Pulse ring */}
      <circle cx="450" cy="250" r="28" fill="none" stroke="#1ab893" stroke-width="1" opacity="0.6">
        <animate attributeName="r" values="28;44;28" dur="3s" begin="2s" repeatCount="indefinite" />
        <animate attributeName="opacity" values="0.6;0;0.6" dur="3s" begin="2s" repeatCount="indefinite" />
      </circle>
      {/* Hub label */}
      <text x="450" y="246" text-anchor="middle" class="fill-slate-900 dark:fill-white" font-size="10" font-weight="700" font-family="system-ui">MAU</text>
      <text x="450" y="259" text-anchor="middle" class="fill-accent-600 dark:fill-accent-400" font-size="8" font-weight="600" font-family="system-ui">CONSULTING</text>
    </g>
  </svg>
</div>

<style>
  @keyframes trace-draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes dot-appear {
    to { opacity: 1; }
  }
  @keyframes node-appear {
    from { opacity: 0; transform: scale(0.8); }
    to { opacity: 1; transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .circuit-trace,
    .circuit-dot {
      animation: none !important;
      stroke-dashoffset: 0 !important;
      opacity: 1 !important;
    }
    svg g[style*="animation"] {
      animation: none !important;
      opacity: 1 !important;
    }
    svg circle[style*="animation"] {
      animation: none !important;
      opacity: 0.6 !important;
    }
  }
</style>
