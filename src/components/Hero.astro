---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const { title, subtitle, align = 'center' } = Astro.props;
const alignClasses = align === 'center' ? 'text-center' : 'text-left';
---

<section class="relative overflow-hidden py-16 sm:py-24 bg-white dark:bg-gray-950">
  <!-- Warm gradient background -->
  <div class="absolute inset-0 bg-gradient-to-br from-accent-50/40 via-transparent to-navy-50/30 dark:from-accent-900/10 dark:via-transparent dark:to-navy-950/20" aria-hidden="true"></div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class:list={['max-w-4xl', align === 'center' ? 'mx-auto' : '']}>
      <h1 class:list={[
        'text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-navy-900 dark:text-white mb-6',
        alignClasses,
        'animate-fade-in-up'
      ]}>
        {title}
      </h1>
      {subtitle && (
        <p class:list={[
          'text-xl sm:text-2xl text-stone-600 dark:text-stone-300 mb-8',
          alignClasses,
          'animate-delay-100'
        ]}>
          {subtitle}
        </p>
      )}
      <div class:list={[
        'flex flex-wrap gap-4',
        align === 'center' ? 'justify-center' : 'justify-start',
        'animate-delay-200'
      ]}>
        <slot />
      </div>
    </div>
  </div>
</section>
