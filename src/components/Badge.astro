---
interface Props {
  variant?: 'default' | 'accent' | 'success';
  pulse?: boolean;
  class?: string;
}

const { variant = 'default', pulse = false, class: className } = Astro.props;

const variantClasses = {
  default: 'bg-gray-500/20 dark:bg-gray-400/10 text-gray-700 dark:text-gray-300 border border-gray-500/30',
  accent: 'bg-accent-500/20 dark:bg-accent-400/10 text-accent-700 dark:text-accent-300 border border-accent-500/30 shadow-sm shadow-accent-500/30',
  success: 'bg-green-500/20 dark:bg-green-400/10 text-green-700 dark:text-green-300 border border-green-500/30 shadow-sm shadow-green-500/30'
};
---

<span class:list={[
  'inline-flex items-center px-3 py-1 rounded-full text-sm font-medium',
  'backdrop-blur-sm',
  variantClasses[variant],
  pulse && 'animate-pulse',
  className
]}>
  <slot />
</span>
