---
interface Props {
  title?: string;
  compact?: boolean;
}

const { title = "Tech Stack & Tools", compact = false } = Astro.props;

const technologies = [
  { name: 'Salesforce', category: 'CRM', certified: true },
  { name: 'Pardot', category: 'Marketing Automation', certified: false },
  { name: 'Microsoft 365', category: 'Cloud Platform', certified: false },
  { name: 'Azure', category: 'Infrastructure', certified: false },
  { name: 'SharePoint', category: 'Collaboration', certified: false },
  { name: 'Excel', category: 'Data Analysis', certified: false },
  { name: 'Power Automate', category: 'Automation', certified: false },
  { name: 'Zapier', category: 'Integration', certified: false },
  { name: 'SQL', category: 'Database', certified: false },
  { name: 'APIs', category: 'Integration', certified: false },
  { name: 'Git', category: 'Version Control', certified: false },
  { name: 'Python', category: 'Scripting', certified: false },
];
---

<div class:list={[compact ? '' : 'mb-8']}>
  {title && (
    <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-2">
      <svg class="w-6 h-6 text-accent-600 dark:text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
      </svg>
      {title}
    </h3>
  )}

  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
    {technologies.map((tech, index) => (
      <div
        class="relative group animate-scale-in"
        style={`animation-delay: ${index * 0.05}s;`}
      >
        <div class="bg-gradient-to-br from-white/80 to-white/40 dark:from-gray-800/80 dark:to-gray-900/40 backdrop-blur-md rounded-lg p-4 border border-gray-200/50 dark:border-gray-700/50 hover:border-accent-500 dark:hover:border-accent-400 transition-all hover:shadow-lg hover:shadow-accent-500/50 hover:scale-110 hover:-rotate-2 text-center transform">
          {tech.certified && (
            <div class="absolute -top-2 -right-2 bg-green-500 text-white text-xs px-2 py-1 rounded-full font-bold shadow-lg animate-pulse-glow">
              ✓
            </div>
          )}
          <div class="font-semibold text-gray-900 dark:text-white text-sm mb-1">
            {tech.name}
          </div>
          <div class="text-xs text-gray-500 dark:text-gray-400">
            {tech.category}
          </div>
        </div>
      </div>
    ))}
  </div>

  {!compact && (
    <div class="mt-4 flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
      <div class="flex items-center gap-1">
        <div class="w-3 h-3 bg-green-500 rounded-full"></div>
        <span>Certified</span>
      </div>
      <span class="text-gray-400">•</span>
      <span>Hands-on experience across revenue systems, automation, and infrastructure</span>
    </div>
  )}
</div>
