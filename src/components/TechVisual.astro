---
/**
 * Animated technical dashboard visualization.
 * Displays a stylized CRM/data dashboard with live-looking
 * charts, connection lines, and data flow animations.
 */
---

<div class="relative w-full max-w-lg mx-auto select-none" aria-hidden="true">
  <svg viewBox="0 0 480 360" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
    <defs>
      <linearGradient id="tv-grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" style="stop-color:#0ea5e9" />
        <stop offset="100%" style="stop-color:#6366f1" />
      </linearGradient>
      <linearGradient id="tv-green" x1="0%" y1="100%" x2="0%" y2="0%">
        <stop offset="0%" style="stop-color:#10b981" />
        <stop offset="100%" style="stop-color:#34d399" />
      </linearGradient>
      <linearGradient id="tv-blue" x1="0%" y1="100%" x2="0%" y2="0%">
        <stop offset="0%" style="stop-color:#0ea5e9" />
        <stop offset="100%" style="stop-color:#38bdf8" />
      </linearGradient>
      <linearGradient id="tv-purple" x1="0%" y1="100%" x2="0%" y2="0%">
        <stop offset="0%" style="stop-color:#8b5cf6" />
        <stop offset="100%" style="stop-color:#a78bfa" />
      </linearGradient>
      <linearGradient id="tv-orange" x1="0%" y1="100%" x2="0%" y2="0%">
        <stop offset="0%" style="stop-color:#f97316" />
        <stop offset="100%" style="stop-color:#fb923c" />
      </linearGradient>
      <filter id="tv-glow">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
      <filter id="tv-shadow">
        <feDropShadow dx="0" dy="4" stdDeviation="8" flood-color="#0ea5e9" flood-opacity="0.15" />
      </filter>
    </defs>

    <!-- Main dashboard card -->
    <rect x="20" y="20" width="440" height="320" rx="16" class="fill-white/80 dark:fill-gray-800/80" filter="url(#tv-shadow)" />
    <rect x="20" y="20" width="440" height="320" rx="16" fill="none" class="stroke-gray-200/60 dark:stroke-gray-700/60" stroke-width="1" />

    <!-- Top bar -->
    <rect x="20" y="20" width="440" height="44" rx="16" class="fill-gray-50/90 dark:fill-gray-900/90" />
    <rect x="20" y="48" width="440" height="16" class="fill-gray-50/90 dark:fill-gray-900/90" />
    <!-- Window dots -->
    <circle cx="44" cy="42" r="5" class="fill-red-400" />
    <circle cx="62" cy="42" r="5" class="fill-yellow-400" />
    <circle cx="80" cy="42" r="5" class="fill-green-400" />
    <!-- Title text -->
    <rect x="140" y="36" width="120" height="12" rx="3" class="fill-gray-300 dark:fill-gray-600" />

    <!-- ============================================ -->
    <!-- LEFT PANEL: Bar Chart                        -->
    <!-- ============================================ -->
    <rect x="40" y="80" width="180" height="120" rx="10" class="fill-gray-50/80 dark:fill-gray-900/50" />
    <!-- Chart label -->
    <rect x="52" y="90" width="60" height="8" rx="2" class="fill-gray-300 dark:fill-gray-600" />

    <!-- Animated bars -->
    <rect x="58" y="170" width="18" height="0" rx="3" fill="url(#tv-green)">
      <animate attributeName="height" from="0" to="60" dur="1.2s" begin="0.2s" fill="freeze" />
      <animate attributeName="y" from="170" to="110" dur="1.2s" begin="0.2s" fill="freeze" />
    </rect>
    <rect x="82" y="170" width="18" height="0" rx="3" fill="url(#tv-blue)">
      <animate attributeName="height" from="0" to="45" dur="1.2s" begin="0.4s" fill="freeze" />
      <animate attributeName="y" from="170" to="125" dur="1.2s" begin="0.4s" fill="freeze" />
    </rect>
    <rect x="106" y="170" width="18" height="0" rx="3" fill="url(#tv-purple)">
      <animate attributeName="height" from="0" to="70" dur="1.2s" begin="0.6s" fill="freeze" />
      <animate attributeName="y" from="170" to="100" dur="1.2s" begin="0.6s" fill="freeze" />
    </rect>
    <rect x="130" y="170" width="18" height="0" rx="3" fill="url(#tv-orange)">
      <animate attributeName="height" from="0" to="35" dur="1.2s" begin="0.8s" fill="freeze" />
      <animate attributeName="y" from="170" to="135" dur="1.2s" begin="0.8s" fill="freeze" />
    </rect>
    <rect x="154" y="170" width="18" height="0" rx="3" fill="url(#tv-green)">
      <animate attributeName="height" from="0" to="55" dur="1.2s" begin="1.0s" fill="freeze" />
      <animate attributeName="y" from="170" to="115" dur="1.2s" begin="1.0s" fill="freeze" />
    </rect>
    <rect x="178" y="170" width="18" height="0" rx="3" fill="url(#tv-blue)">
      <animate attributeName="height" from="0" to="78" dur="1.2s" begin="1.2s" fill="freeze" />
      <animate attributeName="y" from="170" to="92" dur="1.2s" begin="1.2s" fill="freeze" />
    </rect>
    <!-- Chart baseline -->
    <line x1="50" y1="175" x2="205" y2="175" class="stroke-gray-300 dark:stroke-gray-600" stroke-width="1" />

    <!-- ============================================ -->
    <!-- RIGHT PANEL: Line Chart (Revenue)            -->
    <!-- ============================================ -->
    <rect x="240" y="80" width="200" height="120" rx="10" class="fill-gray-50/80 dark:fill-gray-900/50" />
    <rect x="252" y="90" width="70" height="8" rx="2" class="fill-gray-300 dark:fill-gray-600" />

    <!-- Animated line chart path -->
    <polyline
      points="260,170 285,155 310,160 335,140 360,130 385,145 410,110"
      fill="none"
      stroke="url(#tv-grad)"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-dasharray="200"
      stroke-dashoffset="200"
    >
      <animate attributeName="stroke-dashoffset" from="200" to="0" dur="2s" begin="0.5s" fill="freeze" />
    </polyline>
    <!-- Area fill under line -->
    <polygon
      points="260,170 285,155 310,160 335,140 360,130 385,145 410,110 410,175 260,175"
      fill="url(#tv-grad)"
      opacity="0"
    >
      <animate attributeName="opacity" from="0" to="0.1" dur="1s" begin="2s" fill="freeze" />
    </polygon>
    <!-- Data point dots -->
    <circle cx="410" cy="110" r="4" fill="url(#tv-grad)" opacity="0" filter="url(#tv-glow)">
      <animate attributeName="opacity" from="0" to="1" dur="0.3s" begin="2.3s" fill="freeze" />
      <animate attributeName="r" values="4;5;4" dur="2s" begin="2.5s" repeatCount="indefinite" />
    </circle>
    <!-- Chart baseline -->
    <line x1="255" y1="175" x2="430" y2="175" class="stroke-gray-300 dark:stroke-gray-600" stroke-width="1" />

    <!-- ============================================ -->
    <!-- BOTTOM LEFT: KPI Cards                       -->
    <!-- ============================================ -->
    <rect x="40" y="216" width="85" height="52" rx="8" class="fill-gray-50/80 dark:fill-gray-900/50" />
    <rect x="52" y="228" width="30" height="6" rx="2" class="fill-gray-300 dark:fill-gray-600" />
    <text x="52" y="254" class="fill-green-500" font-size="16" font-weight="700" font-family="system-ui">
      +87%
      <animate attributeName="opacity" from="0" to="1" dur="0.5s" begin="1.5s" fill="freeze" />
    </text>

    <rect x="135" y="216" width="85" height="52" rx="8" class="fill-gray-50/80 dark:fill-gray-900/50" />
    <rect x="147" y="228" width="35" height="6" rx="2" class="fill-gray-300 dark:fill-gray-600" />
    <text x="147" y="254" class="fill-accent-500" font-size="16" font-weight="700" font-family="system-ui">
      10x
      <animate attributeName="opacity" from="0" to="1" dur="0.5s" begin="1.8s" fill="freeze" />
    </text>

    <!-- ============================================ -->
    <!-- BOTTOM RIGHT: Network/Integration Nodes      -->
    <!-- ============================================ -->
    <rect x="240" y="216" width="200" height="108" rx="10" class="fill-gray-50/80 dark:fill-gray-900/50" />
    <rect x="252" y="226" width="55" height="6" rx="2" class="fill-gray-300 dark:fill-gray-600" />

    <!-- Connection lines -->
    <line x1="290" y1="272" x2="340" y2="262" class="stroke-accent-400 dark:stroke-accent-500" stroke-width="1.5" opacity="0">
      <animate attributeName="opacity" from="0" to="0.5" dur="0.5s" begin="2s" fill="freeze" />
    </line>
    <line x1="340" y1="262" x2="390" y2="278" class="stroke-purple-400 dark:stroke-purple-500" stroke-width="1.5" opacity="0">
      <animate attributeName="opacity" from="0" to="0.5" dur="0.5s" begin="2.2s" fill="freeze" />
    </line>
    <line x1="340" y1="262" x2="340" y2="300" class="stroke-green-400 dark:stroke-green-500" stroke-width="1.5" opacity="0">
      <animate attributeName="opacity" from="0" to="0.5" dur="0.5s" begin="2.4s" fill="freeze" />
    </line>
    <line x1="290" y1="272" x2="290" y2="305" class="stroke-orange-400 dark:stroke-orange-500" stroke-width="1.5" opacity="0">
      <animate attributeName="opacity" from="0" to="0.5" dur="0.5s" begin="2.1s" fill="freeze" />
    </line>
    <line x1="390" y1="278" x2="390" y2="305" class="stroke-blue-400 dark:stroke-blue-500" stroke-width="1.5" opacity="0">
      <animate attributeName="opacity" from="0" to="0.5" dur="0.5s" begin="2.3s" fill="freeze" />
    </line>

    <!-- Nodes - CRM hub -->
    <circle cx="340" cy="262" r="10" fill="url(#tv-grad)" filter="url(#tv-glow)" opacity="0">
      <animate attributeName="opacity" from="0" to="1" dur="0.5s" begin="1.8s" fill="freeze" />
      <animate attributeName="r" values="10;11;10" dur="3s" begin="2.5s" repeatCount="indefinite" />
    </circle>
    <text x="335" y="266" fill="white" font-size="8" font-weight="700" font-family="system-ui">SF</text>

    <!-- Satellite nodes -->
    <circle cx="290" cy="272" r="7" class="fill-green-500" opacity="0">
      <animate attributeName="opacity" from="0" to="1" dur="0.4s" begin="2s" fill="freeze" />
    </circle>
    <circle cx="390" cy="278" r="7" class="fill-purple-500" opacity="0">
      <animate attributeName="opacity" from="0" to="1" dur="0.4s" begin="2.2s" fill="freeze" />
    </circle>
    <circle cx="290" cy="305" r="6" class="fill-orange-500" opacity="0">
      <animate attributeName="opacity" from="0" to="1" dur="0.4s" begin="2.3s" fill="freeze" />
    </circle>
    <circle cx="340" cy="300" r="6" class="fill-blue-500" opacity="0">
      <animate attributeName="opacity" from="0" to="1" dur="0.4s" begin="2.4s" fill="freeze" />
    </circle>
    <circle cx="390" cy="305" r="6" class="fill-cyan-500" opacity="0">
      <animate attributeName="opacity" from="0" to="1" dur="0.4s" begin="2.5s" fill="freeze" />
    </circle>

    <!-- Data flow pulse along a connection -->
    <circle r="3" fill="#0ea5e9" filter="url(#tv-glow)" opacity="0.8">
      <animateMotion dur="2s" begin="3s" repeatCount="indefinite" path="M290,272 L340,262 L390,278" />
    </circle>
    <circle r="2.5" fill="#8b5cf6" filter="url(#tv-glow)" opacity="0.8">
      <animateMotion dur="2.5s" begin="3.5s" repeatCount="indefinite" path="M340,262 L340,300 L290,305" />
    </circle>

    <!-- ============================================ -->
    <!-- BOTTOM CENTER: Mini progress ring             -->
    <!-- ============================================ -->
    <circle cx="57" cy="300" r="18" class="stroke-gray-200 dark:stroke-gray-700" stroke-width="4" fill="none" />
    <circle cx="57" cy="300" r="18" stroke="url(#tv-grad)" stroke-width="4" fill="none"
      stroke-dasharray="113" stroke-dashoffset="113" stroke-linecap="round"
      transform="rotate(-90 57 300)">
      <animate attributeName="stroke-dashoffset" from="113" to="28" dur="1.5s" begin="2s" fill="freeze" />
    </circle>
    <text x="47" y="305" fill="url(#tv-grad)" font-size="11" font-weight="700" font-family="system-ui">
      87
      <animate attributeName="opacity" from="0" to="1" dur="0.5s" begin="3s" fill="freeze" />
    </text>

    <!-- Label rows -->
    <rect x="82" y="288" width="40" height="6" rx="2" class="fill-gray-300 dark:fill-gray-600" />
    <rect x="82" y="300" width="55" height="6" rx="2" class="fill-gray-200 dark:fill-gray-700" />
    <rect x="82" y="312" width="30" height="6" rx="2" class="fill-gray-200 dark:fill-gray-700" />

    <!-- Status indicator dot -->
    <circle cx="155" y="295" r="4" class="fill-green-500">
      <animate attributeName="opacity" values="1;0.4;1" dur="2s" repeatCount="indefinite" />
    </circle>
  </svg>

  <!-- Ambient glow behind the dashboard -->
  <div class="absolute -inset-8 -z-10 bg-gradient-to-br from-accent-500/10 via-purple-500/10 to-cyan-500/10 rounded-3xl blur-2xl animate-float"></div>
</div>
