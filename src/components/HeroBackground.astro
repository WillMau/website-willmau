---
/**
 * HeroBackground: layered hybrid background for the homepage hero.
 *
 * Layers (bottom to top):
 *  1. White / dark base (inherited from parent section)
 *  2. Blueprint grid SVG at ~5% opacity
 *  3. Mint + blue radial glow blobs (~12-15% opacity)
 *  4. Circuit-trace SVG masked to bottom-right corner (~5% opacity)
 *
 * All layers are absolutely positioned and pointer-events-none so they
 * never interfere with content above them.
 */
---

<!-- 1 · Blueprint grid -->
<div
  class="absolute inset-0 opacity-[0.05] dark:opacity-[0.07]"
  aria-hidden="true"
  style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M60 0H0v60' fill='none' stroke='%231ab893' stroke-width='.5'/%3E%3C/svg%3E&quot;); background-size: 60px 60px;"
></div>

<!-- 2 · Mint glow blob (center-left) -->
<div
  class="absolute top-1/4 left-1/3 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full blur-[140px] pointer-events-none bg-accent-400/[0.12] dark:bg-accent-500/[0.08]"
  aria-hidden="true"
></div>

<!-- 3 · Blue glow blob (upper-right, smaller, subtle) -->
<div
  class="absolute top-1/6 right-[10%] w-[350px] h-[350px] rounded-full blur-[120px] pointer-events-none bg-blue-500/[0.06] dark:bg-blue-400/[0.04]"
  aria-hidden="true"
></div>

<!-- 4 · Circuit-trace SVG (bottom-right corner, masked fade) -->
<div
  class="absolute bottom-0 right-0 w-[420px] h-[360px] pointer-events-none opacity-[0.04] dark:opacity-[0.06]"
  aria-hidden="true"
  style="mask-image: linear-gradient(to top left, rgba(0,0,0,0.7) 0%, transparent 70%); -webkit-mask-image: linear-gradient(to top left, rgba(0,0,0,0.7) 0%, transparent 70%);"
>
  <svg viewBox="0 0 420 360" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
    <!-- Horizontal traces -->
    <path d="M20 40 h80 l12 12 h60" stroke="#1ab893" stroke-width="1.2" stroke-linecap="round" />
    <path d="M60 90 h40 l8 -8 h100 l8 8 h50" stroke="#1ab893" stroke-width="1" stroke-linecap="round" />
    <path d="M30 150 h120 l10 10 h70" stroke="#1ab893" stroke-width="1.2" stroke-linecap="round" />
    <path d="M100 200 h60 l12 -12 h80 l8 8 h40" stroke="#2563EB" stroke-width="0.8" stroke-linecap="round" opacity="0.7" />
    <path d="M80 260 h50 l8 8 h110" stroke="#1ab893" stroke-width="1" stroke-linecap="round" />
    <path d="M140 310 h90 l10 -10 h60" stroke="#1ab893" stroke-width="1.2" stroke-linecap="round" />

    <!-- Vertical traces -->
    <path d="M160 20 v50 l8 8 v40" stroke="#1ab893" stroke-width="1" stroke-linecap="round" />
    <path d="M260 60 v30 l-10 10 v60" stroke="#2563EB" stroke-width="0.8" stroke-linecap="round" opacity="0.7" />
    <path d="M340 30 v70 l8 8 v50" stroke="#1ab893" stroke-width="1.2" stroke-linecap="round" />
    <path d="M200 180 v40 l10 10 v50" stroke="#1ab893" stroke-width="1" stroke-linecap="round" />

    <!-- Junction dots -->
    <circle cx="112" cy="40" r="2.5" fill="#1ab893" />
    <circle cx="108" cy="90" r="2" fill="#1ab893" />
    <circle cx="266" cy="82" r="2" fill="#1ab893" />
    <circle cx="160" cy="150" r="2.5" fill="#1ab893" />
    <circle cx="172" cy="200" r="2" fill="#2563EB" opacity="0.7" />
    <circle cx="340" cy="108" r="2.5" fill="#1ab893" />
    <circle cx="138" cy="260" r="2" fill="#1ab893" />
    <circle cx="240" cy="310" r="2.5" fill="#1ab893" />
    <circle cx="200" cy="230" r="2" fill="#1ab893" />

    <!-- Small chip rectangles (IC components) -->
    <rect x="252" y="76" width="16" height="10" rx="2" stroke="#1ab893" stroke-width="0.8" fill="none" />
    <rect x="155" y="145" width="12" height="8" rx="1.5" stroke="#1ab893" stroke-width="0.8" fill="none" />
    <rect x="335" y="100" width="14" height="10" rx="2" stroke="#1ab893" stroke-width="0.8" fill="none" />
  </svg>
</div>
