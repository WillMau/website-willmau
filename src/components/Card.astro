---
interface Props {
  title?: string;
  shimmer?: boolean;
  class?: string;
}

const { title, shimmer = false, class: className } = Astro.props;
---

<div
  class:list={[
    'group relative',
    'bg-white/60 dark:bg-gray-800/60',
    'backdrop-blur-lg',
    'rounded-lg',
    'border border-white/20 dark:border-gray-700/30',
    'p-6',
    'hover:shadow-2xl',
    'hover:shadow-accent-500/10',
    'hover:scale-[1.02]',
    'hover:-translate-y-1',
    'transition-all duration-300',
    'overflow-hidden',
    className
  ]}
>
  <!-- Network connection glow on hover -->
  <div class="absolute inset-0 rounded-lg opacity-0 group-hover:opacity-30 transition-opacity duration-500 bg-gradient-to-br from-accent-500/20 via-blue-500/20 to-cyan-500/20 blur-xl -z-10"></div>

  <!-- Content -->
  <div class="relative z-10">
    {title && (
      <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
        {title}
      </h3>
    )}
    <slot />
  </div>

  <!-- Subtle pulse effect on hover -->
  {shimmer && (
    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
      <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:animate-shimmer"></div>
    </div>
  )}

  <!-- Network node indicator (top-right corner) -->
  <div class="absolute -top-1 -right-1 w-2 h-2 rounded-full bg-accent-500 dark:bg-accent-400 opacity-0 group-hover:opacity-100 transition-opacity duration-300 shadow-lg shadow-accent-500/50">
    <div class="absolute inset-0 rounded-full bg-accent-500 dark:bg-accent-400 animate-ping"></div>
  </div>
</div>
