---
interface Props {
  title?: string;
  shimmer?: boolean;
  class?: string;
}

const { title, shimmer = false, class: className } = Astro.props;
---

<div
  class:list={[
    'group relative',
    'bg-white dark:bg-stone-900/60',
    'rounded-2xl',
    'border border-stone-200 dark:border-stone-800',
    'p-6',
    'hover:shadow-lg',
    'hover:shadow-accent-500/[0.06]',
    'hover:-translate-y-1',
    'transition-all duration-300',
    'overflow-hidden',
    className
  ]}
>
  <!-- Content -->
  <div class="relative z-10 flex flex-col flex-1">
    {title && (
      <h3 class="text-xl font-semibold text-navy-900 dark:text-white mb-4">
        {title}
      </h3>
    )}
    <slot />
  </div>

  <!-- Subtle shimmer on hover -->
  {shimmer && (
    <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
      <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:animate-shimmer"></div>
    </div>
  )}
</div>
